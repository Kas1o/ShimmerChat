@page "/agent/{AgentGuid}/{ChatGuid}"
@using ShimmerChatLib
@using ShimmerChatLib.ChatView
@using ShimmerChatLib.Generation
@using Microsoft.JSInterop

@inject GenerationSessionService sessionService
@inject IPopupService popupService
@inject IJSRuntime JS
@inject IKVDataService KVData
@inject IMessageStoreService messageStore
@inject ILocService Loc
@inject IPanelDraftStore PanelDrafts
@inject IChatViewRegistry ChatViews
@inject NavigationManager navigation
@inject ILogger<AgentChatPage> logger
@implements IAsyncDisposable

@*
	对话页宿主。
	本页只负责与「界面无关」的部分：会话生命周期、消息持久化、插件面板、通知，
	以及为当前对话界面提供 ChatViewContext；消息区与输入区由 Agent 选定的
	对话界面（IChatView）渲染，因此同一 Agent 可以拥有完全不同的对话外观。
*@

@if (chat != null)
{
	<PageTitle>@($"{agent!.Name} | {chat.Name}")</PageTitle>

	@if (UnresolvedChatViewId != null)
	{
		<div class="chat-view-warning">
			<i class="bi bi-exclamation-triangle"></i>
			<span>@Loc.Format("chat.chat_view_missing", UnresolvedChatViewId)</span>
		</div>
	}

	@if (CurrentView != null)
	{
		<DynamicComponent Type="CurrentView.ComponentType" Parameters="ViewParameters" />
	}
	else
	{
		<div class="chat-view-missing">@Loc["chat.chat_view_none"]</div>
	}

	<ShimmerChat.Components.SubComponents.ChatPluginPanelContainer AgentGuid="agent.Guid" ChatGuid="chat.Guid" PanelContext="PanelContext" @ref="ChatPluginPanelContainer"/>
}

@if(chat == null)
{
	<p>@Loc.Format("chat.not_found", AgentGuid, ChatGuid)</p>
}

@code {

	#region 参数
	[Parameter]
	public string AgentGuid { get; set; } = string.Empty;
	[Parameter]
	public string ChatGuid { get; set; } = string.Empty;
	#endregion

	#region 成员

	/// <summary>
	/// 当前生成会话。为 null 表示没有活跃会话。离开页面后会话继续在后台运行。
	/// </summary>
	private GenerationSession? session;

	private Agent? agent;
	private Chat? chat;

	bool throwExceptionInsteadOfPopupErrorMessage = false;

	ShimmerChat.Components.SubComponents.ChatPluginPanelContainer? ChatPluginPanelContainer;

	private ShimmerChatLib.Panel.ChatPanelContext? _panelContext;
	private ChatViewContext? _viewContext;
	#endregion

	#region 对话界面

	/// <summary>
	/// 当前 Agent 选定的对话界面。未指定时使用默认界面；
	/// 指定了未注册的 Id 时同样回退到默认界面，但界面上的警告条会明示这一点。
	/// </summary>
	private ChatViewInfo? CurrentView => agent == null
		? null
		: ChatViews.GetById(agent.ChatViewId) ?? ChatViews.GetDefault();

	/// <summary>Agent 指定了但未注册的界面 Id（null 表示无需提示）。</summary>
	private string? UnresolvedChatViewId => agent != null
		&& !string.IsNullOrEmpty(agent.ChatViewId)
		&& ChatViews.GetById(agent.ChatViewId) == null
			? agent.ChatViewId
			: null;

	/// <summary>
	/// 交给对话界面的宿主契约。Chat / Agent 是页面正在使用的同一实例，
	/// 因此界面看到的数据始终与页面同步；实例被替换（切换对话、重新加载 Agent）时重建。
	/// </summary>
	private ChatViewContext? ViewContext
	{
		get
		{
			if (chat == null || agent == null) return null;

			if (_viewContext != null
				&& ReferenceEquals(_viewContext.Chat, chat)
				&& ReferenceEquals(_viewContext.Agent, agent))
				return _viewContext;

			_viewContext = BuildChatViewContext(chat, agent);
			return _viewContext;
		}
	}

	#pragma warning disable CS8974
	private Dictionary<string, object> ViewParameters => new()
	{
		["Context"] = ViewContext!
	};
	#pragma warning restore CS8974

	private ChatViewContext BuildChatViewContext(Chat currentChat, Agent currentAgent) => new()
	{
		Chat = currentChat,
		Agent = currentAgent,
		IsGenerating = () => session is { IsActive: true },
		GenerationPhase = () => session?.Phase,
		SendAsync = SendUserMessageAsync,
		StopGenerationAsync = StopGenerationAsync,
		DeleteMessageAsync = DeleteMessage,
		DeleteMessagesFromAsync = DeleteMessagesFrom,
		RegenerateFromAsync = RegenerateFromMessage,
		ContinueFromAsync = ContinueFromMessage,
		MarkDirty = GetDirty,
		RequestRefreshAsync = () => InvokeAsync(StateHasChanged),
		NavigateBackAsync = () =>
		{
			navigation.NavigateTo($"/agent/{AgentGuid}");
			return Task.CompletedTask;
		}
	};
	#endregion

	#region 插件面板宿主契约

	/// <summary>
	/// 交给聊天插件面板的宿主上下文。页面只暴露这份契约，不传页面实例；
	/// Chat / Agent 为页面正在使用的同一实例，因此面板读写即时可见。
	/// </summary>
	private ShimmerChatLib.Panel.ChatPanelContext? PanelContext => BuildPanelContext();

	private ShimmerChatLib.Panel.ChatPanelContext? BuildPanelContext()
	{
		if (chat == null || agent == null) return null;

		// Chat/Agent 变化（切换对话）时重建，保证面板拿到的是当前对话对象。
		var key = $"{chat.Guid:N}|{agent.Guid:N}";
		if (_panelContext != null && string.Equals(_panelContext.DraftKey, key, StringComparison.Ordinal))
			return _panelContext;

		_panelContext = new ShimmerChatLib.Panel.ChatPanelContext
		{
			Chat = chat,
			Agent = agent,
			MessageStore = messageStore,
			DraftStore = PanelDrafts,
			IsGenerating = () => session is { IsActive: true },
			RequestRefreshAsync = () => InvokeAsync(StateHasChanged),
			SendUserMessageAsync = SendUserMessageFromPanelAsync,
			InsertIntoInputAsync = InsertIntoInputFromPanelAsync,
			RegisterEventHandler = handler => ChatPluginPanelContainer?.RegisterEventHandler(handler)
		};

		return _panelContext;
	}

	/// <summary>
	/// 面板在自己的界面内发送消息：与输入框回车走同一条路径
	/// （写入 Chat → 持久化 → 通知会话与面板 → 启动生成）。
	/// </summary>
	private async Task<bool> SendUserMessageFromPanelAsync(string text)
	{
		if (chat == null || agent == null) return false;

		if (session is { IsActive: true })
		{
			logger.LogInformation("[AgentChatPage] Panel send ignored: generation is already active.");
			return false;
		}

		await SendUserMessageAsync(text);
		return true;
	}

	/// <summary>
	/// 面板请求把文本写入主输入框（不发送）。输入框属于当前对话界面，
	/// 因此这里把请求转交给界面；界面未挂载输入框时返回 false。
	/// </summary>
	private async Task<bool> InsertIntoInputFromPanelAsync(string text, bool append)
	{
		var context = ViewContext;
		if (context == null) return false;
		return await context.RequestInputInsertAsync(text, append);
	}
	#endregion

	#region 交互
	private async Task StopGenerationAsync()
	{
		await sessionService.StopGeneration(ChatGuid);
	}
	#endregion

	#region 逻辑
	/// <summary>
	/// 发送用户消息并启动生成。空文本表示不新增用户消息，仅重新生成。
	/// </summary>
	async Task SendUserMessageAsync(string text)
	{
		if (chat == null || agent == null)
			return;

		// 重新读取 Agent，确保在其它连接中编辑的节点树 / 渲染树立即生效
		ReloadAgent();

		// 取消之前的生成
		sessionService.CancelPreviousGeneration(ChatGuid);

		// 添加用户消息
		if (!string.IsNullOrWhiteSpace(text))
		{
			var message = new Message()
			{
				message = new SharperLLM.Util.ChatMessage { Content = text },
				timestamp = DateTime.Now,
				sender = ShimmerChatLib.Sender.User
			};

			chat.AddMessage(message);
			chat.SaveMessage(messageStore, message);

			session?.NotifyUserMessageAdded(message);
			ChatPluginPanelContainer?.OnUserMessage(message);

			GetDirty();
		}

		// 启动后台生成
		session = sessionService.GetOrCreateSession(ChatGuid, AgentGuid);
		SubscribeToSession(session);
		sessionService.StartGeneration(session, agent, chat, throwExceptionInsteadOfPopupErrorMessage);
	}

	async Task DeleteMessage(Message message)
	{
		if (message.IsGenerating)
		{
			await sessionService.StopGeneration(ChatGuid);
		}
		chat?.DeleteMessage(messageStore, message);
		GetDirty();
		await Refresh();
	}
	async Task DeleteMessagesFrom(Message message)
	{
		if (chat == null) return;

		var count = chat.Messages.Count - chat.Messages.IndexOf(message) - 1;
		var confirmed = await popupService.ShowAsync(
			string.Format(Loc["POPUP_DELETE_FROM"], count),
			Loc["POPUP_DELETE_FROM_TITLE"], showCancel: true);
		if (!confirmed) return;

		if (message.IsGenerating)
			await sessionService.StopGeneration(ChatGuid);

		var idx = chat.Messages.IndexOf(message);
		if (idx < 0) return;
		for (int i = chat.Messages.Count - 1; i >= idx; i--)
			chat.DeleteMessage(messageStore, chat.Messages[i]);
		GetDirty();
		await Refresh();
	}
	async Task RegenerateFromMessage(Message message)
	{
		if (chat == null) return;

		await sessionService.StopGeneration(ChatGuid);

		// 重新读取 Agent，确保在其它连接中编辑的节点树 / 渲染树立即生效
		ReloadAgent();

		int messageIndex = chat.Messages.IndexOf(message);
		if (messageIndex == -1) return;

		var currentContent = message.CurrentVersion?.Content ?? "";
		var currentThinking = message.CurrentVersion?.thinking ?? "";
		var currentToolCalls = message.CurrentVersion?.toolCalls;

		if (!string.IsNullOrEmpty(currentContent))
		{
			var versionMessage = new SharperLLM.Util.ChatMessage
			{
				Content = currentContent,
				thinking = currentThinking,
				toolCalls = currentToolCalls != null ? new List<SharperLLM.API.ToolCall>(currentToolCalls) : null
			};
			message.AddVersion(versionMessage);
		}

		message.GenerationState = MessageGenerationState.Regenerating;

		for (int i = chat.Messages.Count - 1; i > messageIndex; i--)
		{
			chat.Messages.RemoveAt(i);
		}

		chat.SaveAllMessages(messageStore);
		GetDirty();
		await Refresh();

		// 启动后台生成
		session = sessionService.GetOrCreateSession(ChatGuid, AgentGuid);
		SubscribeToSession(session);
		sessionService.StartGeneration(session, agent!, chat, throwExceptionInsteadOfPopupErrorMessage);
	}

	async Task ContinueFromMessage(Message message)
	{
		if (chat == null) return;

		await sessionService.StopGeneration(ChatGuid);

		// 重新读取 Agent，确保在其它连接中编辑的节点树 / 渲染树立即生效
		ReloadAgent();

		int messageIndex = chat.Messages.IndexOf(message);
		if (messageIndex == -1) return;
		if (message.sender != ShimmerChatLib.Sender.AI) return;

		message.IsContinuation = true;
		GetDirty();
		await Refresh();

		// 启动后台续写
		session = sessionService.GetOrCreateSession(ChatGuid, AgentGuid);
		SubscribeToSession(session);
		sessionService.StartContinuation(session, agent!, chat, message, throwExceptionInsteadOfPopupErrorMessage);
	}
	#endregion

	#region 会话事件订阅

	/// <summary>
	/// 订阅会话事件，将后台生成状态桥接到 Blazor UI。
	/// </summary>
	private void SubscribeToSession(GenerationSession s)
	{
		// 先取消旧订阅
		UnsubscribeFromSession();

		session = s;
		if (s == null) return;

		s.StateChanged += OnSessionStateChanged;
		s.ScrollRequested += OnSessionScrollRequested;
		s.ErrorOccurred += OnSessionError;
		s.AgentMessageCompleted += OnSessionAgentMessageCompleted;
		s.ToolResultAdded += OnSessionToolResultAdded;
		s.GenerationCompleted += OnSessionGenerationCompleted;
	}

	private void UnsubscribeFromSession()
	{
		if (session == null) return;

		session.StateChanged -= OnSessionStateChanged;
		session.ScrollRequested -= OnSessionScrollRequested;
		session.ErrorOccurred -= OnSessionError;
		session.AgentMessageCompleted -= OnSessionAgentMessageCompleted;
		session.ToolResultAdded -= OnSessionToolResultAdded;
		session.GenerationCompleted -= OnSessionGenerationCompleted;
	}

	private async void OnSessionStateChanged()
	{
		await InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// 滚动到底部的请求转发给当前对话界面：是否真的滚动（用户是否在底部、
	/// 是否启用自动滚动）由界面自行决定。
	/// </summary>
	private void OnSessionScrollRequested()
	{
		_viewContext?.NotifyScrollToBottom();
	}

	private async void OnSessionError(string message, string title)
	{
		logger.LogError(title + message);
		await popupService.ShowAsync(message, title);
	}

	private async void OnSessionAgentMessageCompleted(Message msg)
	{
		// 会话事件在后台生成线程触发，须切回渲染线程再通知面板，
		// 否则面板处理器与渲染线程的登记操作并发，可能破坏集合。
		await InvokeAsync(() => ChatPluginPanelContainer?.OnAgentMessage(msg));
	}

	private async void OnSessionToolResultAdded(Message msg)
	{
		await InvokeAsync(() => ChatPluginPanelContainer?.OnToolCallResult(msg));
	}

	private async void OnSessionGenerationCompleted()
	{
		try
		{
			await ShowNotificationWhenCompleted();
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "显示通知时出错");
		}
	}
	#endregion

	#region 初始化 & 生命周期
	protected override void OnInitialized()
	{
		if (bool.TryParse(KVData.Read("App", "throw_exception"), out var result))
		{
			throwExceptionInsteadOfPopupErrorMessage = result;
		}
	}

	/// <summary>
	/// 生成提供器创建的 Chat 不在 Agent.ChatGuids 中（记录在事件的
	/// GeneratedChatGuids），通过 Chat 自身盖印的 ProviderSource 识别，
	/// 允许从事件管理界面/提供者筛选列表直接打开。
	/// </summary>
	/// <remarks>
	/// Chat 的来源身份（是否提供器生成）不会变化，缓存于页面实例避免
	/// 每次参数变化都重新读取并反序列化 Chat。
	/// </remarks>
	private readonly Dictionary<Guid, bool> _providerChatCache = new();

	private bool IsProviderGeneratedChat(Guid chatGuid)
	{
		if (_providerChatCache.TryGetValue(chatGuid, out var cached))
			return cached;

		bool isProvider;
		try
		{
			isProvider = Chat.Load(chatGuid, KVData)?.ProviderSource != null;
		}
		catch (InvalidOperationException)
		{
			isProvider = false;
		}
		_providerChatCache[chatGuid] = isProvider;
		return isProvider;
	}

	protected override async Task OnParametersSetAsync()
	{
		// 先取消旧会话订阅
		UnsubscribeFromSession();

		agent = null;
		chat = null;
		_viewContext = null;

		if (Guid.TryParse(AgentGuid, out var guid))
		{
			try
			{
				agent = Agent.Load(guid, KVData);
				if (agent != null)
				{
					if (Guid.TryParse(ChatGuid, out var chatGuid)
						&& (agent.ChatGuids.Contains(chatGuid) || IsProviderGeneratedChat(chatGuid)))
					{
						// 检查是否有活跃的生成会话（从其他页面返回）
						var existingSession = sessionService.GetSession(ChatGuid);
						if (existingSession is { IsActive: true, Chat: not null })
						{
							// 复用会话的 Chat 引用，确保看到最新消息
							chat = existingSession.Chat;
							SubscribeToSession(existingSession);
						}
						else
						{
							chat = Chat.LoadAndMigrate(chatGuid, KVData, messageStore);
							chat.LoadAllMessages(messageStore);

							// 清理旧的非活跃会话
							sessionService.CleanupSession(ChatGuid);
							session = null;
						}
					}
				}
			}
			catch (Exception)
			{
				agent = null;
				chat = null;
			}
		}

		WarnIfChatViewMissing();

		await base.OnParametersSetAsync();
	}

	/// <summary>
	/// Agent 指定的对话界面未注册时（插件被移除等）明确记录，避免只表现为「界面变了」。
	/// </summary>
	private void WarnIfChatViewMissing()
	{
		if (agent == null || string.IsNullOrEmpty(agent.ChatViewId)) return;
		if (ChatViews.GetById(agent.ChatViewId) != null) return;

		logger.LogError(
			"[AgentChatPage] Agent {AgentGuid} 指定的对话界面 '{ChatViewId}' 未注册，已回退到默认界面。",
			agent.Guid, agent.ChatViewId);
	}

	public async ValueTask DisposeAsync()
	{
		// 取消订阅但不停止生成 —— 离开页面后生成继续在后台运行
		UnsubscribeFromSession();
		session = null;
		await Task.CompletedTask;
	}
	#endregion

	#region IO
	private async Task ShowNotificationWhenCompleted()
	{
		try
		{
			var notificationsEnabled = false;
			var notificationsEnabledStr = KVData.Read("App", "enable_notifications");
			if (bool.TryParse(notificationsEnabledStr, out var result))
			{
				notificationsEnabled = result;
			}

			if (!notificationsEnabled)
				return;

			var aiMessage = chat?.Messages.LastOrDefault(m => m.sender == ShimmerChatLib.Sender.AI);
			if (aiMessage != null && !string.IsNullOrEmpty(aiMessage.CurrentVersion?.Content))
			{
				var notificationOptions = new
				{
					body = aiMessage.CurrentVersion.Content.Length > 100
						? aiMessage.CurrentVersion.Content.Substring(0, 100) + "..."
						: aiMessage.CurrentVersion.Content,
					icon = Assets["favicon.png"],
				};

				await JS.InvokeVoidAsync("showNotification",
					Loc.Format("chat.new_message_notification", agent?.Name ?? "No Name"),
					notificationOptions);
			}
		}
		catch (Exception ex)
		{
			logger.LogError($"显示通知时出错: {ex.Message}");
		}
	}
	void GetDirty()
	{
		if (chat == null) return;
		chat.LastModifyTime = DateTime.Now;
		chat.Save(KVData);
		if (agent != null)
		{
			// 只更新 ChatGuids 顺序，避免整对象 Save 覆盖其它连接（如 Agent 编辑器）的并发编辑。
			try
			{
				Agent.Update(agent.Guid, KVData, a => a.MoveChatToTop(chat.Guid));
			}
			catch (Exception ex)
			{
				logger.LogWarning(ex, "[AgentChatPage] Failed to persist chat order for agent {AgentGuid}: {Message}",
					agent.Guid, ex.Message);
			}
		}
	}

	void ReloadAgent()
	{
		if (agent == null) return;
		try
		{
			agent = Agent.Load(agent.Guid, KVData);
			WarnIfChatViewMissing();
		}
		catch (Exception ex)
		{
			logger.LogWarning(ex, "[AgentChatPage] Failed to reload agent {AgentGuid}: {Message}",
				agent.Guid, ex.Message);
		}
	}
	async Task Refresh()
	{
		await InvokeAsync(StateHasChanged);
	}
	#endregion
}
