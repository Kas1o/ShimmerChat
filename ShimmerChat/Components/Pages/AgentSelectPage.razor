        </button>
        <button type="button" class="agent-action-btn" title="@Loc["agent_select.action_export"]"
                aria-label="@Loc["agent_select.action_export"]" @onclick="() => ExportAgent(agent)">
            <i class="bi bi-download"></i>
        </button>
        <button type="button" class="agent-action-btn agent-action-danger" title="@Loc["Delete"]"
                aria-label="@Loc["Delete"]" @onclick="() => ShowDeleteConfirmation(agent)">
            <i class="bi bi-trash3"></i>
        </button>
    </div>;

    async Task InputFileChanged(InputFileChangeEventArgs e)
    {
        File = e.File;
        await Import();
    }

    async Task Import()
    {
        if (File == null)
        {
            await PopupService.ShowAsync(Loc["agent_select.no_file_selected"]);
            return;
        }

        Agent imported;
        try
        {
            using var originStream = File.OpenReadStream(maxAllowedSize: 1024 * 1024 * 80);
            using var memoryStream = new MemoryStream();
            await originStream.CopyToAsync(memoryStream);
            var content = Encoding.UTF8.GetString(memoryStream.ToArray());
            imported = Agent.Import(content);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import agent from file '{FileName}'.", File.Name);
            await PopupService.ShowAsync(Loc.Format("agent_select.import_failed", ex.Message), Loc["agent_select.import_failed_title"]);
            return;
        }

        var duplicate = AllAgents.Any(agent => agent.Guid == imported.Guid);
        if (duplicate)
            imported.Guid = Guid.NewGuid();

        try
        {
            imported.Save(kvDataService);
            Agent.AddAgentToAll(imported, kvDataService);
            LoadAgents();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save imported agent '{AgentName}'.", imported.Name);
            await PopupService.ShowAsync(Loc.Format("agent_select.import_save_failed", ex.Message), Loc["agent_select.import_failed_title"]);
            return;
        }

        if (duplicate)
            await PopupService.ShowAsync(Loc["agent_select.duplicate_imported"]);
    }

    static int GetChatCount(Agent? agent) => agent?.ChatGuids?.Count ?? 0;

    static IEnumerable<string> GetVisibleTags(Agent agent)
    {
        return (agent.Tags ?? new List<string>()).Where(tag => !string.IsNullOrWhiteSpace(tag));
    }

    static int GetVisibleTagCount(Agent agent) => GetVisibleTags(agent).Count();

    static string GetTagColor(string? tag)
    {
        var hash = 0;
        foreach (var c in tag ?? "")
            hash = ((hash << 5) + hash) ^ c; // DJB2 variant
        return TagPalette[(hash & 0x7FFFFFFF) % TagPalette.Length];
    }

    static string GetTagStyle(string tag)
    {
        var color = GetTagColor(tag);
        return $"background-color: {color}22; color: {color}; border: 1px solid {color}66;";
    }

    static string GetAvatarColor(string? name)
    {
        var hash = 0;
        foreach (var c in string.IsNullOrEmpty(name) ? "?" : name)
            hash = ((hash << 5) + hash) ^ c;
        return _avatarColors[(hash & 0x7FFFFFFF) % _avatarColors.Length];
    }

    static string GetAvatarInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        return char.ToUpper(name.TrimStart()[0]).ToString();
    }

    static string GetCoverStyle(Agent agent)
    {
        if (agent.BackgroundGuid != null)
            return $"background-image: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.45) 100%), url('/userimages/{agent.BackgroundGuid}.png');";

        if (agent.AvatarGuid != null)
            return $"background-image: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.45) 100%), url('/userimages/{agent.AvatarGuid}.png');";

        var color = GetAvatarColor(agent.Name);
        return $"background-image: radial-gradient(circle at 18% 18%, {color} 0%, {color}b3 48%, {color}66 100%);";
    }
