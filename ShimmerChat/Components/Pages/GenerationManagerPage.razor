@page "/generationmanager"
@using ShimmerChatBuiltin.NodeBasic.PreGeneration
@using ShimmerChatLib.Components
@using ShimmerChatLib.Generation
@using System.Text.Json
@inject NavigationManager Navigation
@inject IKVDataService KVData
@inject IPreGenerationNodeSerializer Serializer
@inject INodeTypeCatalog NodeTypeCatalog
@inject IGenerationEventStore EventStore
@inject IGenerationProviderRegistry ProviderRegistry
@inject GenerationProviderHostService ProviderHost
@inject IJSRuntime JS
@inject ILocService Loc
@inject ILogger<GenerationManagerPage> Logger

@if (_isAgentMode)
{
    <div class="cfg-page cfg-page-main">
        <header class="cfg-topbar">
            <div class="cfg-topbar-main">
                <div class="cfg-identity">
                    <span class="cfg-identity-icon"><i class="bi bi-diagram-3"></i></span>
                    <div class="cfg-identity-text">
                        <div class="cfg-identity-title">
                            <span>@Loc["gen_manager.title"]</span>
                            <span class="cfg-dirty @(IsAgentDirty ? "is-dirty" : "is-clean")">
                                @(IsAgentDirty ? Loc["config_ui.unsaved"] : Loc["config_ui.saved"])
                            </span>
                        </div>
                        <div class="cfg-identity-sub">
                            @(_targetEvent != null
                                ? Loc.Format("gen_manager.editing_event_tree", _agentName, _targetEvent.Name)
                                : Loc.Format("gen_manager.editing_private_tree", _agentName))
                        </div>
                    </div>
                </div>
                <div class="cfg-topbar-actions">
                    <button type="button" class="su-btn su-btn-secondary su-btn-sm" @onclick="BackToAgent">
                        <i class="bi bi-arrow-left"></i> @Loc["gen_manager.back_to_agent"]
                    </button>
                    <button type="button" class="su-btn su-btn-primary su-btn-sm cfg-btn"
                            disabled="@(_eventConfigError != null)" @onclick="SaveAll">
                        <i class="bi bi-check-lg"></i>
                        <span class="cfg-btn-label">@Loc["config_ui.save"]</span>
                        <kbd>@Loc["config_ui.shortcut_save"]</kbd>
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_statusText))
            {
                <div class="cfg-topbar-sub">
                    <span class="cfg-status is-@_statusKind" role="status">
                        <i class="bi @(_statusKind == "error" ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill")"></i>
                        @_statusText
                    </span>
                </div>
            }
        </header>

        @if (_eventConfigError != null)
        {
            <div class="cfg-note is-danger">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <span>@_eventConfigError</span>
            </div>
        }
        else if (_targetEvent != null)
        {
            <div class="cfg-note">
                <i class="bi bi-info-circle-fill"></i>
                <span>@Loc["editor.event_tree_template_hint"]</span>
            </div>
        }

        <div class="cfg-body">
            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-diagram-3"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["gen_manager.modifier_tree"]</h3>
                        <p>@Loc["generation_config.node_tree_desc"]</p>
                    </div>
                </div>
                <div class="cfg-tree-editor">
                    @if (_treeLoadError != null)
                    {
                        <div class="cfg-note is-danger">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                            <span>@_treeLoadError</span>
                        </div>
                    }
                    else if (_treeMigrated)
                    {
                        <div class="cfg-note is-warning">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>@Loc["generation_config.tree_migrated"]</span>
                        </div>
                    }
                    <CascadingValue Value="_dragContext">
                        <CascadingValue Value="_editorContext">
                            <TreeEditor Node="@_editingRoot" />
                        </CascadingValue>
                    </CascadingValue>
                </div>
            </section>
        </div>
    </div>
}
else
{
    <ConfigShell T="PreGenerationPreset"
                Items="_presets"
                SelectedId="@_selectedId"
                IdSelector="@(p => p.Id)"
                NameSelector="@(p => p.Name)"
                TypeSelector="@(p => p.Id == DefaultPresetId ? Loc["gen_manager.default_badge"] : null)"
                SearchSelector="@(p => p.RootNodeJson)"
                PinSelector="@(p => p.Pinned)"
                Title="@Loc["gen_manager.title"]"
                Description="@Loc["generation_config.desc"]"
                Icon="bi-diagram-3"
                Flush="true"
                IsDirty="IsDirty"
                LoadError="@_loadError"
                StatusMessage="@_statusText"
                StatusKind="@_statusKind"
                CanSave="@(Current is { } c && c.Id != DefaultPresetId)"
                CanClone="@(Current != null)"
                CanRename="@(Current is { } r && r.Id != DefaultPresetId)"
                CanDelete="@(Current is { } d && d.Id != DefaultPresetId && _presets.Count > 1)"
                OnCreate="CreateNewPreset"
                OnSave="SaveAll"
                OnSelect="SelectPreset"
                OnClone="CloneCurrentPreset"
                OnRename="RenamePreset"
                OnDelete="DeleteCurrentPreset"
                OnTogglePin="TogglePin"
                OnRetry="Reload">
        <Body>
            @if (Current is { } preset)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["generation_config.basic"]</h3>
                            <p>@Loc["generation_config.basic_desc"]</p>
                        </div>
                    </div>

                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["gen_manager.preset_name_placeholder"]</label>
                            <input class="su-input" @bind="preset.Name"
                                   disabled="@(preset.Id == DefaultPresetId)" />
                            <p class="cfg-field-hint">@Loc["generation_config.name_hint"]</p>
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["gen_manager.label_id"]</label>
                            <div class="cfg-readonly-row">
                                <code title="@preset.Id">@preset.Id</code>
                            </div>
                            <p class="cfg-field-hint">@Loc["generation_config.id_hint"]</p>
                        </div>
                    </div>

                    @if (preset.Id == DefaultPresetId)
                    {
                        <div class="cfg-note is-warning">
                            <i class="bi bi-lock-fill"></i>
                            <span><strong>@Loc["gen_manager.default_readonly"]</strong> @Loc["gen_manager.default_readonly_hint"]</span>
                        </div>
                    }
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-diagram-3"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["gen_manager.modifier_tree"]</h3>
                            <p>@Loc["generation_config.node_tree_desc"]</p>
                        </div>
                    </div>

                    <div class="cfg-tree-editor @(preset.Id == DefaultPresetId ? "is-readonly" : "")">
                        @if (_treeLoadError != null)
                        {
                            <div class="cfg-note is-danger">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                                <span>@_treeLoadError</span>
                            </div>
                        }
                        else if (_treeMigrated)
                        {
                            <div class="cfg-note is-warning">
                                <i class="bi bi-arrow-repeat"></i>
                                <span>@Loc["generation_config.tree_migrated"]</span>
                            </div>
                        }
                        <CascadingValue Value="_dragContext">
                            <CascadingValue Value="_editorContext">
                                <TreeEditor Node="@_editingRoot" />
                            </CascadingValue>
                        </CascadingValue>
                    </div>
                </section>
            }
        </Body>

        <EmptyState>
            <div class="cfg-empty">
                <span class="cfg-empty-icon"><i class="bi bi-diagram-3"></i></span>
                <h2>@Loc["generation_config.empty_title"]</h2>
                <p>@Loc["generation_config.empty_desc"]</p>
                <button type="button" class="su-btn su-btn-primary" @onclick="CreateNewPreset">
                    <i class="bi bi-plus-lg"></i> @Loc["gen_manager.new_preset"]
                </button>
            </div>
        </EmptyState>
    </ConfigShell>
}

@code {
    [Parameter] [SupplyParameterFromQuery] public string? agent { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? evt { get; set; }

    /// <summary>事件模式下提供器配置中的管线树属性名</summary>
    [Parameter] [SupplyParameterFromQuery] public string? prop { get; set; }

    private const string PresetStorageKey = "generation_presets";
    private const string DefaultPresetId = "__default__";

    private List<PreGenerationPreset> _presets = [];
    private string? _selectedId;
    private string? _loadError;
    private string? _savedSnapshot;
    private string _statusText = string.Empty;
    private string _statusKind = "info";

    private PreGenerationNodeWrapper _editingRoot = CreateRoot("Root");
    private TreeDragContext _dragContext = new();
    private TreeEditorContext _editorContext = default!;
    private string? _treeLoadError;
    private bool _treeMigrated;

    private bool _isAgentMode;
    private string _agentName = "";
    private Guid _agentGuid;
    private GenerationEvent? _targetEvent;
    private object? _eventProviderInstance;
    private string? _eventConfigError;
    private string? _savedTreeJson;

    private static readonly JsonSerializerOptions _snapshotOptions = new() { WriteIndented = false };

    private PreGenerationPreset? Current =>
        _presets.FirstOrDefault(p => string.Equals(p.Id, _selectedId, StringComparison.Ordinal));

    private bool IsDirty
    {
        get
        {
            if (_loadError != null) return false;
            CommitEditingTree();
            return Snapshot() != _savedSnapshot;
        }
    }

    private bool IsAgentDirty =>
        _eventConfigError == null && Serializer.Serialize(_editingRoot) != _savedTreeJson;

    protected override void OnInitialized()
    {
        _editorContext = new TreeEditorContext(Serializer, NodeTypeCatalog, typeof(IPreGenerationNode));

        if (!string.IsNullOrEmpty(agent) && Guid.TryParse(agent, out _agentGuid))
        {
            _isAgentMode = true;
            var ag = Agent.Load(_agentGuid, KVData);
            _agentName = ag.Name;

            if (!string.IsNullOrEmpty(evt))
            {
                _targetEvent = EventStore.GetEvent(_agentGuid, evt);
                InitEventProviderInstance(ag);
            }

            var treeJson = _eventProviderInstance != null
                ? ProviderConfigHelper.GetTreeJson(_eventProviderInstance, prop!) ?? ag.PreGenerationTreeJson
                : ag.PreGenerationTreeJson;
            LoadTree(treeJson, "Root");
            _savedTreeJson = Serializer.Serialize(_editingRoot);
            return;
        }

        Reload();
    }

    private void Reload()
    {
        try
        {
            var json = KVData.Read("GenerationManager", PresetStorageKey);
            _presets = string.IsNullOrEmpty(json)
                ? []
                : Newtonsoft.Json.JsonConvert.DeserializeObject<List<PreGenerationPreset>>(json) ?? [];

            if (_presets.Count == 0)
            {
                _presets.Add(new PreGenerationPreset
                {
                    Id = DefaultPresetId,
                    Name = "Default",
                    RootNodeJson = Serializer.Serialize(CreateRoot("Root"))
                });
            }

            _loadError = null;
            _selectedId = _presets.FirstOrDefault(p => p.Id == DefaultPresetId)?.Id ?? _presets[0].Id;
            LoadEditingTree();
            CommitEditingTree();
            _savedSnapshot = Snapshot();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载前生成预设失败");
            _presets = [];
            _selectedId = null;
            _savedSnapshot = null;
            _loadError = Loc.Format("generation_config.load_failed", ex.Message);
        }
    }

    private void InitEventProviderInstance(Agent ag)
    {
        if (_targetEvent == null) return;

        if (string.IsNullOrEmpty(prop))
        {
            _eventConfigError = Loc["editor.event_prop_missing"];
            return;
        }

        var typeInfo = ProviderRegistry.GetProviderType(_targetEvent.ProviderTypeName);
        if (typeInfo == null)
        {
            _eventConfigError = Loc["agent.gen_events_provider_missing"];
            return;
        }

        _eventProviderInstance = ProviderRegistry.CreateInstance(typeInfo);
        if (_eventProviderInstance == null)
        {
            _eventConfigError = $"Failed to create provider instance of '{_targetEvent.ProviderTypeName}'.";
            return;
        }

        try
        {
            ProviderConfigHelper.Populate(_eventProviderInstance, _targetEvent.ConfigJson);
            ProviderConfigHelper.GetTreeJson(_eventProviderInstance, prop);
        }
        catch (Exception ex)
        {
            _eventProviderInstance = null;
            _eventConfigError = ex.Message;
        }
    }

    private void LoadEditingTree()
    {
        LoadTree(Current?.RootNodeJson, "Root");
    }

    /// <summary>
    /// 读取节点树；反序列化失败时回退到空白根节点，并把错误显示给用户
    /// （不能静默当成空树，否则用户会以为配置丢了）。
    /// </summary>
    private void LoadTree(string? json, string fallbackName)
    {
        _treeLoadError = null;
        _treeMigrated = false;

        if (string.IsNullOrWhiteSpace(json))
        {
            _editingRoot = CreateRoot(fallbackName);
            return;
        }

        var result = Serializer.DeserializeTree(json);
        if (!result.Success)
        {
            _treeLoadError = Loc.Format("generation_config.tree_load_failed", result.Error ?? "");
            Logger.LogError("前生成节点树反序列化失败，已回退到空白根节点: {Error}", result.Error);
            _editingRoot = CreateRoot(fallbackName);
            return;
        }

        if (result.IsEmpty)
        {
            _editingRoot = CreateRoot(fallbackName);
            return;
        }

        if (result.Root is PreGenerationNodeWrapper root)
        {
            _editingRoot = root;
            _treeMigrated = result.Migrated;
            return;
        }

        _treeLoadError = Loc["generation_config.tree_empty_fallback"];
        Logger.LogError("前生成节点树反序列化结果不是预生成管线包装器，已回退到空白根节点。");
        _editingRoot = CreateRoot(fallbackName);
    }

    private static PreGenerationNodeWrapper CreateRoot(string name)
        => new(new SequenceNode(), name);

    private void CommitEditingTree()
    {
        if (Current is { } preset)
            preset.RootNodeJson = Serializer.Serialize(_editingRoot);
    }

    private string Snapshot() => JsonSerializer.Serialize(_presets, _snapshotOptions);

    private async Task SaveAll()
    {
        if (_isAgentMode)
        {
            await SaveAgentTree();
            return;
        }

        if (_loadError != null) return;
        if (Current is not { } preset || preset.Id == DefaultPresetId) return;

        if (string.IsNullOrWhiteSpace(preset.Name))
        {
            SetStatus(Loc["generation_config.name_required"], "error");
            return;
        }

        try
        {
            CommitEditingTree();
            KVData.Write("GenerationManager", PresetStorageKey,
                Newtonsoft.Json.JsonConvert.SerializeObject(_presets));
            _savedSnapshot = Snapshot();
            SetStatus(Loc["generation_config.saved"], "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "保存前生成预设失败");
            SetStatus(Loc.Format("config_ui.save_failed", ex.Message), "error");
        }

        await Task.CompletedTask;
    }

    private async Task SaveAgentTree()
    {
        if (_editingRoot == null) return;

        try
        {
            if (_targetEvent != null)
            {
                if (_eventProviderInstance == null || prop == null) return;
                ProviderConfigHelper.SetTreeJson(_eventProviderInstance, prop, Serializer.Serialize(_editingRoot));
                _targetEvent.ConfigJson = ProviderConfigHelper.Serialize(_eventProviderInstance);
                EventStore.UpdateEvent(_agentGuid, _targetEvent);
                await ProviderHost.ReloadEventAsync(_agentGuid, _targetEvent.Id);
            }
            else
            {
                Agent.Update(_agentGuid, KVData, ag => ag.PreGenerationTreeJson = Serializer.Serialize(_editingRoot));
            }

            _savedTreeJson = Serializer.Serialize(_editingRoot);
            SetStatus(Loc["generation_config.saved"], "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "保存智能体前生成树失败");
            SetStatus(Loc.Format("config_ui.save_failed", ex.Message), "error");
        }
    }

    private async Task CreateNewPreset()
    {
        CommitEditingTree();

        var preset = new PreGenerationPreset
        {
            Name = NextName(Loc["gen_manager.new_preset"]),
            RootNodeJson = Serializer.Serialize(CreateRoot("Root"))
        };

        _presets.Add(preset);
        _selectedId = preset.Id;
        LoadEditingTree();
        SetStatus(Loc.Format("config_ui.created", preset.Name), "info");
        await Task.CompletedTask;
    }

    private async Task CloneCurrentPreset()
    {
        if (Current is not { } source) return;

        CommitEditingTree();

        var clone = new PreGenerationPreset
        {
            Name = NextName($"{DisplayName(source)} {Loc["config_ui.copy_suffix"]}"),
            RootNodeJson = source.RootNodeJson,
            Pinned = source.Pinned
        };

        var index = _presets.IndexOf(source);
        _presets.Insert(index + 1, clone);
        _selectedId = clone.Id;
        LoadEditingTree();
        SetStatus(Loc.Format("config_ui.cloned", clone.Name), "info");
        await Task.CompletedTask;
    }

    private async Task RenamePreset(string name)
    {
        if (Current is not { } preset) return;
        preset.Name = name;
        SetStatus(Loc.Format("config_ui.renamed", preset.Name), "info");
        await Task.CompletedTask;
    }

    private async Task DeleteCurrentPreset()
    {
        if (Current is not { } preset || preset.Id == DefaultPresetId) return;

        var index = _presets.IndexOf(preset);
        _presets.Remove(preset);
        _selectedId = _presets[Math.Min(index, _presets.Count - 1)].Id;
        LoadEditingTree();
        SetStatus(Loc.Format("config_ui.deleted_pending", DisplayName(preset)), "info");
        await Task.CompletedTask;
    }

    private async Task TogglePin(PreGenerationPreset preset)
    {
        preset.Pinned = !preset.Pinned;
        SetStatus(Loc.Format(preset.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(preset)), "info");
        await Task.CompletedTask;
    }

    private async Task SelectPreset(string id)
    {
        CommitEditingTree();
        _selectedId = id;
        LoadEditingTree();
        await Task.CompletedTask;
    }

    private void BackToAgent() => Navigation.NavigateTo($"/agent/{_agentGuid}");

    private void SetStatus(string message, string kind)
    {
        _statusText = message;
        _statusKind = kind;
    }

    private string DisplayName(PreGenerationPreset preset) =>
        string.IsNullOrWhiteSpace(preset.Name) ? Loc["config_ui.untitled"] : preset.Name;

    private string NextName(string baseName)
    {
        var name = string.IsNullOrWhiteSpace(baseName) ? Loc["gen_manager.new_preset"] : baseName.Trim();
        var candidate = name;
        var suffix = 2;

        while (_presets.Any(p => string.Equals(p.Name, candidate, StringComparison.OrdinalIgnoreCase)))
            candidate = $"{name} ({suffix++})";

        return candidate;
    }
}
