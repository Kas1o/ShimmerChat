@page "/generationmanager"
@using ShimmerChatBuiltin.NodeBasic.PreGeneration
@using ShimmerChatLib.Components
@using ShimmerChatLib.Generation
@inject NavigationManager Navigation
@inject IKVDataService KVData
@inject IGenerationManagerV2 GenManager
@inject IPreGenerationNodeSerializer Serializer
@inject INodeTypeCatalog NodeTypeCatalog
@inject IGenerationEventStore EventStore
@inject IGenerationProviderRegistry ProviderRegistry
@inject IJSRuntime JS
@inject ILocService Loc

<h3>@Loc["gen_manager.title"]</h3>

@if (_isAgentMode)
{
    <div class="su-alert su-alert-warning" style="margin-top:16px;">
        <strong>@(_targetEvent != null
            ? Loc.Format("gen_manager.editing_event_tree", _agentName, _targetEvent.Name)
            : Loc.Format("gen_manager.editing_private_tree", _agentName))</strong>
        <button class="su-btn su-btn-sm su-btn-outline" style="margin-left:12px;" @onclick="BackToAgent">@Loc["gen_manager.back_to_agent"]</button>
    </div>
    @if (_eventConfigError != null)
    {
        <div class="su-alert su-alert-danger" style="margin-top:8px;">@_eventConfigError</div>
    }
}

@if (!_isAgentMode)
{
    <!-- Preset 管理 -->
    <div class="su-group" style="margin-top:16px;">
        <h5>@Loc["gen_manager.preset_management"]</h5>
        <select @bind="_selectedPresetId" class="su-select" style="max-width: 400px;">
            @foreach (var preset in _presets)
            {
                <option value="@preset.Id">@preset.Name @(preset.Id == DefaultPresetId ? Loc["gen_manager.default_badge"] : "")</option>
            }
        </select>
        @if (_activePreset != null)
        {
            <div class="preset-id-row" style="margin-top: 6px; display: flex; align-items: center; gap: 6px; max-width: 400px;">
                <span style="font-size: 0.72em; color: #777; white-space: nowrap;">@Loc["gen_manager.label_id"]</span>
                <code class="preset-id-text"
                      @oncontextmenu="CopyPresetId"
                      @oncontextmenu:preventDefault
                      title="@Loc["gen_manager.right_click_copy"]"
                      style="font-size: 0.72em; color: #999; font-family: monospace; overflow: hidden; text-overflow: ellipsis; flex: 1; cursor: pointer; user-select: all; padding: 2px 4px; background: rgba(255,255,255,0.03); border-radius: 3px;">
                    @_activePreset.Id
                </code>
                <button class="su-btn su-btn-sm su-btn-outline" style="font-size: 0.65em; padding: 1px 6px;" @onclick="CopyPresetId" title="@Loc["gen_manager.copy_id"]">@Loc["gen_manager.copy_id"]</button>
            </div>
        }
        <div style="margin-top: 8px;">
            <button class="su-btn su-btn-primary su-btn-sm" @onclick="CreateNewPreset">@Loc["gen_manager.new_preset"]</button>
            <button class="su-btn su-btn-secondary su-btn-sm" style="margin-left: 5px;" @onclick="StartRename"
                    disabled="@(_activePreset?.Id == DefaultPresetId)">@Loc["gen_manager.rename"]</button>
            <button class="su-btn su-btn-secondary su-btn-sm" style="margin-left: 5px;" @onclick="CloneCurrentPreset">@Loc["gen_manager.clone"]</button>
            <button class="su-btn su-btn-danger su-btn-sm" style="margin-left: 5px;" @onclick="DeleteCurrentPreset"
                    disabled="@(_presets.Count <= 1 || _activePreset?.Id == DefaultPresetId)">@Loc["Delete"]</button>
        </div>
    </div>
}

@if (_showNameDialog)
{
    <div class="su-modal-mask" @onclick="() => _showNameDialog = false">
        <div class="su-modal su-modal-sm" @onclick:stopPropagation="true">
            <div class="su-modal-header">
                @_nameDialogTitle
                <button class="su-btn-close" @onclick="() => _showNameDialog = false">&times;</button>
            </div>
            <div class="su-modal-body">
                <input type="text" class="su-input" @bind="_nameInput" @bind:event="oninput"
                       placeholder="@Loc["gen_manager.preset_name_placeholder"]" />
            </div>
            <div class="su-modal-footer">
                <button class="su-btn su-btn-secondary" @onclick="() => _showNameDialog = false">@Loc["Cancel"]</button>
                <button class="su-btn su-btn-primary" @onclick="ConfirmName"
                        disabled="@string.IsNullOrWhiteSpace(_nameInput)">@Loc["gen_manager.confirm"]</button>
            </div>
        </div>
    </div>
}

<!-- 树编辑器 -->
<div style="margin-top:16px;">
    <h4>@Loc["gen_manager.modifier_tree"]</h4>
    @if (_isAgentMode)
    {
        <div class="su-card">
            <div class="su-card-body">
                <CascadingValue Value="_dragContext">
                <CascadingValue Value="_editorContext">
                    <TreeEditor Node="@_editingRoot" />
                </CascadingValue>
                </CascadingValue>
            </div>
        </div>
    }
    else if (_activePreset != null)
    {
        <div class="su-card">
            <div class="su-card-body">
                @if (_activePreset.Id == DefaultPresetId)
                {
                    <div class="su-alert su-alert-warning" style="margin-bottom: 12px;">
                        <strong>@Loc["gen_manager.default_readonly"]</strong> @Loc["gen_manager.default_readonly_hint"]
                    </div>
                    <div style="pointer-events: none; opacity: 0.7;">
                        <TreeEditor Node="@_editingRoot" />
                    </div>
                }
                else
                {
                    <CascadingValue Value="_dragContext">
                    <CascadingValue Value="_editorContext">
                        <TreeEditor Node="@_editingRoot" />
                    </CascadingValue>
                    </CascadingValue>
                }
            </div>
        </div>
    }
    else
    {
        <p>@Loc["gen_manager.select_preset_first"]</p>
    }
</div>

<button class="su-btn su-btn-primary" style="margin:16px 5px;" @onclick="SaveAll"
        disabled="@((_isAgentMode && _eventConfigError != null) || (!_isAgentMode && _activePreset?.Id == DefaultPresetId))">@Loc["Save"]</button>

@code {
    [Parameter] [SupplyParameterFromQuery] public string? agent { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? evt { get; set; }

    /// <summary>事件模式下提供器配置中的管线树属性名</summary>
    [Parameter] [SupplyParameterFromQuery] public string? prop { get; set; }

    private const string PresetStorageKey = "generation_presets";
    private const string DefaultPresetId = "__default__";

    private List<PreGenerationPreset> _presets = new();
    private PreGenerationPreset? _activePreset;
    private ITreeNode _editingRoot = new SequenceNode { Name = "Root" };
    private TreeDragContext _dragContext = new();
    private TreeEditorContext _editorContext = default!;

    private bool _isAgentMode;
    private string _agentName = "";
    private Guid _agentGuid;
    private GenerationEvent? _targetEvent;
    private object? _eventProviderInstance;
    private string? _eventConfigError;

    private bool _showNameDialog;
    private string _nameDialogTitle = "";
    private string _nameInput = "";
    private string? _renameTargetId;

    private string _selectedPresetId
    {
        get => _activePreset?.Id ?? "";
        set
        {
            var preset = _presets.FirstOrDefault(p => p.Id == value);
            if (preset != null)
            {
                _activePreset = preset;
                _editingRoot = Serializer.Deserialize(preset.RootNodeJson)
                    ?? new SequenceNode { Name = "Root" };
            }
        }
    }

    protected override void OnInitialized()
    {
        _editorContext = new TreeEditorContext(Serializer, NodeTypeCatalog, typeof(IPreGenerationNode));

        if (!string.IsNullOrEmpty(agent) && Guid.TryParse(agent, out _agentGuid))
        {
            _isAgentMode = true;
            var ag = Agent.Load(_agentGuid, KVData);
            _agentName = ag.Name;

            // 事件模式：编辑提供器配置的指定管线树参数；无覆盖时以 Agent 树为模板
            if (!string.IsNullOrEmpty(evt))
            {
                _targetEvent = EventStore.GetEvent(_agentGuid, evt);
                InitEventProviderInstance(ag);
            }

            var treeJson = _eventProviderInstance != null
                // 未设置覆盖时回退 Agent 树作为模板（否则首次编辑会得到空树，
                // 导致触发时 Fragments 为空、LLM 报 messages cannot be empty）
                ? ProviderConfigHelper.GetTreeJson(_eventProviderInstance, prop!) ?? ag.PreGenerationTreeJson
                : ag.PreGenerationTreeJson;
            _editingRoot = string.IsNullOrEmpty(treeJson)
                ? new SequenceNode { Name = "Root" }
                : Serializer.Deserialize(treeJson)
                    ?? new SequenceNode { Name = "Root" };
            return;
        }

        LoadPresets();
        if (_presets.Count == 0)
        {
            _presets.Add(new PreGenerationPreset { Id = DefaultPresetId, Name = "Default",
                RootNodeJson = Serializer.Serialize(new SequenceNode { Name = "Root" }) });
        }
        _activePreset = _presets[0];
        _editingRoot = Serializer.Deserialize(_activePreset.RootNodeJson)
            ?? new SequenceNode { Name = "Root" };
    }

    /// <summary>
    /// 事件模式：实例化并填充事件对应的提供器配置，校验 prop 参数。
    /// 失败时记录 _eventConfigError（页面显示错误并禁用保存）。
    /// </summary>
    private void InitEventProviderInstance(Agent ag)
    {
        if (_targetEvent == null) return;

        if (string.IsNullOrEmpty(prop))
        {
            _eventConfigError = Loc["editor.event_prop_missing"];
            return;
        }

        var typeInfo = ProviderRegistry.GetProviderType(_targetEvent.ProviderTypeName);
        if (typeInfo == null)
        {
            _eventConfigError = Loc["agent.gen_events_provider_missing"];
            return;
        }

        _eventProviderInstance = ProviderRegistry.CreateInstance(typeInfo);
        if (_eventProviderInstance == null)
        {
            _eventConfigError = $"Failed to create provider instance of '{_targetEvent.ProviderTypeName}'.";
            return;
        }

        try
        {
            ProviderConfigHelper.Populate(_eventProviderInstance, _targetEvent.ConfigJson);
            // 校验 prop 指向合法的管线树属性（非法时抛出 ArgumentException）
            ProviderConfigHelper.GetTreeJson(_eventProviderInstance, prop);
        }
        catch (Exception ex)
        {
            _eventProviderInstance = null;
            _eventConfigError = ex.Message;
        }
    }

    private void LoadPresets()
    {
        var json = KVData.Read("GenerationManager", PresetStorageKey);
        _presets = string.IsNullOrEmpty(json)
            ? new()
            : Newtonsoft.Json.JsonConvert.DeserializeObject<List<PreGenerationPreset>>(json) ?? new();
    }

    private void SavePresets()
    {
        KVData.Write("GenerationManager", PresetStorageKey,
            Newtonsoft.Json.JsonConvert.SerializeObject(_presets));
    }

    private void CreateNewPreset()
    {
        _renameTargetId = null;
        _nameInput = "";
        _nameDialogTitle = Loc["gen_manager.dialog_new_preset"];
        _showNameDialog = true;
    }

    private void StartRename()
    {
        if (_activePreset == null || _activePreset.Id == DefaultPresetId) return;
        _renameTargetId = _activePreset.Id;
        _nameInput = _activePreset.Name;
        _nameDialogTitle = Loc["gen_manager.dialog_rename_preset"];
        _showNameDialog = true;
    }

    private void CloneCurrentPreset()
    {
        if (_activePreset == null) return;
        var newName = Loc.Format("gen_manager.copy_suffix", _activePreset.Name);
        var counter = 2;
        while (_presets.Any(p => p.Name == newName))
        {
            newName = Loc.Format("gen_manager.copy_suffix_counter", _activePreset.Name, counter);
            counter++;
        }
        var clone = new PreGenerationPreset { Name = newName, RootNodeJson = _activePreset.RootNodeJson };
        _presets.Add(clone);
        _activePreset = clone;
        _editingRoot = Serializer.Deserialize(clone.RootNodeJson)
            ?? new SequenceNode { Name = "Root" };
    }

    private void DeleteCurrentPreset()
    {
        if (_presets.Count <= 1 || _activePreset == null || _activePreset.Id == DefaultPresetId)
            return;
        _presets.Remove(_activePreset);
        _activePreset = _presets[0];
        _editingRoot = Serializer.Deserialize(_activePreset.RootNodeJson)
            ?? new SequenceNode { Name = "Root" };
        SavePresets();
    }

    private void ConfirmName()
    {
        if (string.IsNullOrWhiteSpace(_nameInput)) return;

        if (_renameTargetId != null)
        {
            var target = _presets.FirstOrDefault(p => p.Id == _renameTargetId);
            if (target != null) target.Name = _nameInput.Trim();
        }
        else
        {
            var newPreset = new PreGenerationPreset { Name = _nameInput.Trim() };
            _presets.Add(newPreset);
            _activePreset = newPreset;
            _editingRoot = new SequenceNode { Name = "Root" };
        }

        _showNameDialog = false;
        _renameTargetId = null;
        SavePresets();
    }

    private void SaveAll()
    {
        if (_editingRoot == null) return;

        if (_isAgentMode)
        {
            if (_targetEvent != null)
            {
                if (_eventProviderInstance == null || prop == null) return;
                ProviderConfigHelper.SetTreeJson(_eventProviderInstance, prop, Serializer.Serialize(_editingRoot));
                _targetEvent.ConfigJson = ProviderConfigHelper.Serialize(_eventProviderInstance);
                EventStore.UpdateEvent(_agentGuid, _targetEvent);
                return;
            }

            var ag = Agent.Load(_agentGuid, KVData);
            ag.PreGenerationTreeJson = Serializer.Serialize(_editingRoot);
            ag.Save(KVData);
            return;
        }

        if (_activePreset != null && _activePreset.Id != DefaultPresetId)
        {
            _activePreset.RootNodeJson = Serializer.Serialize(_editingRoot);
            SavePresets();
        }
    }

    private void BackToAgent()
    {
        Navigation.NavigateTo($"/agent/{_agentGuid}");
    }

    private async Task CopyPresetId()
    {
        if (_activePreset != null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _activePreset.Id);
        }
    }
}
