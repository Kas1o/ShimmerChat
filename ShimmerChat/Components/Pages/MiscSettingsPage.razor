@page "/misc"

@using Microsoft.JSInterop
@inject IKVDataService KVData
@inject IJSRuntime JS
@inject ILocService Loc

<h3>@Loc["misc.title"]</h3>

<div class="su-group">
	<h4>@Loc["misc.app_settings"]</h4>

	<input type="checkbox" id="throw-exception" @bind="_throwExceptionInsteadOfPopupErrorMessage" />
	<label for="throw-exception">@Loc["misc.throw_exception"]</label>
	
	<input type="checkbox" id="enable-notifications" @bind="_enableNotifications" />
	<label for="enable-notifications">@Loc["misc.enable_notifications"]</label>
	
	<button class="su-btn su-btn-outline-primary" @onclick="RequestNotificationPermission" style="margin-left: 10px;">@Loc["misc.request_notification_permission"]</button>
	<span style="margin-left: 10px;">@Loc["misc.current_status"] <strong>@notificationPermissionStatus</strong></span>

	<input type="checkbox" id="auto-scroll-down" @bind="_autoScrollDown" />
	<label for="auto-scroll-down">@Loc["misc.auto_scroll"]</label>

	<input type="checkbox" id="auto-scroll-down" @bind="_virtualize" />
	<label for="auto-scroll-down">@Loc["misc.virtualize"]</label>
</div>

<div class="su-group">
	<h4>@Loc["misc.display_settings"]</h4>

	<input type="checkbox" id="thinking-collapsed" @bind="_thinkingCollapsed" />
	<label for="thinking-collapsed">@Loc["misc.thinking_collapsed"]</label>

	<input type="checkbox" id="toolcall-collapsed" @bind="_toolCallCollapsed" />
	<label for="toolcall-collapsed">@Loc["misc.tool_call_collapsed"]</label>

	<input type="checkbox" id="toolresult-collapsed" @bind="_toolResultCollapsed" />
	<label for="toolresult-collapsed">@Loc["misc.tool_result_collapsed"]</label>
</div>

<div class="su-group">
	<h4>@Loc["misc.user_settings"]</h4>

	<label for="username">@Loc["misc.user_name"]</label>
	<input type="text" class="su-input" id="username" @bind="_UserName" />
</div>

<div class="su-group">
	<h4>@Loc["misc.image_settings"]</h4>

	<label for="image-storage-mode">@Loc["misc.image_storage_mode"]</label>
	<select class="su-input" id="image-storage-mode" @bind="_ImageStorageMode">
		<option value="@nameof(ImageStorageMode.UserUploadImage)">@Loc["misc.image_storage_userupload"]</option>
		<option value="@nameof(ImageStorageMode.MessageBase64)">@Loc["misc.image_storage_base64"]</option>
	</select>
	<p>@Loc["misc.image_storage_hint"]</p>

	<label for="image-processing-mode">@Loc["misc.image_processing_mode"]</label>
	<select class="su-input" id="image-processing-mode" @bind="_ImageProcessingMode">
		<option value="@nameof(ImageUploadProcessingMode.Original)">@Loc["misc.image_processing_original"]</option>
		<option value="@nameof(ImageUploadProcessingMode.Processed)">@Loc["misc.image_processing_processed"]</option>
	</select>
	<p>@Loc["misc.image_processing_hint"]</p>

	<label for="image-always-reencode">@Loc["misc.image_always_reencode"]</label>
	<input type="checkbox" id="image-always-reencode" @bind="_ImageAlwaysReencode" />
	<p>@Loc["misc.image_always_reencode_hint"]</p>

	<label for="image-pixel-budget">@Loc["misc.image_pixel_budget"]</label>
	<input type="number" class="su-input" id="image-pixel-budget"
	       min="@ImageAttachmentRules.MinPixelBudget" max="@ImageAttachmentRules.MaxPixelBudget"
	       @bind="_ImagePixelBudget" />
	<p>@Loc["misc.image_pixel_budget_hint"]</p>

	<label for="image-compression">@Loc["misc.image_compression"]</label>
	<select class="su-input" id="image-compression" @bind="_ImageCompression">
		<option value="@nameof(ImageCompressionAlgorithm.None)">@Loc["misc.image_compression_none"]</option>
		<option value="@nameof(ImageCompressionAlgorithm.WebP)">@Loc["misc.image_compression_webp"]</option>
		<option value="@nameof(ImageCompressionAlgorithm.Jpeg)">@Loc["misc.image_compression_jpeg"]</option>
	</select>
	<p>@Loc["misc.image_compression_hint"]</p>

	<label for="image-quality">@Loc["misc.image_quality"]</label>
	<input type="number" class="su-input" id="image-quality"
	       min="@ImageAttachmentRules.MinCompressionQuality" max="@ImageAttachmentRules.MaxCompressionQuality"
	       @bind="_ImageQuality" />
	<p>@Loc["misc.image_quality_hint"]</p>
</div>

@code {
	private bool _throwExceptionInsteadOfPopupErrorMessage
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = false;

	private bool _enableNotifications
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = false;

	private string _UserName
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = "";

	private bool _autoScrollDown
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = true;

	private bool _virtualize
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = true;

	/// <summary>图像存储方式；取枚举名字符串，与 <see cref="IImageAttachmentService"/> 读取的值一致。</summary>
	private string _ImageStorageMode
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = nameof(ImageStorageMode.UserUploadImage);

	/// <summary>上传图像处理模式；取枚举名字符串，与 <see cref="IImageAttachmentService"/> 读取的值一致。</summary>
	private string _ImageProcessingMode
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = nameof(ImageUploadProcessingMode.Original);

	/// <summary>处理模式的像素预算（宽×高的最大乘积）。</summary>
	private long _ImagePixelBudget
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = ImageAttachmentRules.DefaultPixelBudget;

	/// <summary>处理模式的压缩算法；取枚举名字符串。</summary>
	private string _ImageCompression
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = nameof(ImageCompressionAlgorithm.WebP);

	/// <summary>处理模式的有损编码质量。</summary>
	private int _ImageQuality
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = ImageAttachmentRules.DefaultCompressionQuality;

	/// <summary>处理模式下预算内的图像也强制重编码。</summary>
	private bool _ImageAlwaysReencode
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = false;

	private bool _thinkingCollapsed
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = true;

	private bool _toolCallCollapsed
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = true;

	private bool _toolResultCollapsed
	{
		get => field;
		set
		{
			if (field == value) return;
			field = value;
			Save();
		}
	} = true;


	private string notificationPermissionStatus = "";

	/// <summary>读取以枚举名存储的 KV 设置；缺失或非法时回退默认值（服务读取侧同样收敛并记日志）。</summary>
	private string ReadEnumSetting<TEnum>(string key, TEnum fallback) where TEnum : struct, Enum
	{
		var raw = KVData.Read("App", key);
		return Enum.TryParse<TEnum>(raw, ignoreCase: true, out var value) && Enum.IsDefined(value)
			? value.ToString()
			: fallback.ToString();
	}

	bool Initialized = false;
	private void Save()
	{
		if (!Initialized) return;
		KVData.Write("App", "throw_exception", _throwExceptionInsteadOfPopupErrorMessage ? "true": "false");
		KVData.Write("App", "enable_notifications", _enableNotifications ? "true": "false");
		KVData.Write("App", "auto_scroll_down", _autoScrollDown ? "true": "false");
		KVData.Write("App", "virtualize", _virtualize ? "true" : "false");
		KVData.Write("App", "thinking_collapsed", _thinkingCollapsed ? "true" : "false");
		KVData.Write("App", "toolcall_collapsed", _toolCallCollapsed ? "true" : "false");
		KVData.Write("App", "toolresult_collapsed", _toolResultCollapsed ? "true" : "false");
		KVData.Write("App", ImageAttachmentService.StorageModeKey, _ImageStorageMode);
		KVData.Write("App", ImageAttachmentService.UploadProcessingModeKey, _ImageProcessingMode);
		KVData.Write("App", ImageAttachmentService.UploadPixelBudgetKey, _ImagePixelBudget.ToString());
		KVData.Write("App", ImageAttachmentService.UploadCompressionKey, _ImageCompression);
		KVData.Write("App", ImageAttachmentService.UploadQualityKey, _ImageQuality.ToString());
		KVData.Write("App", ImageAttachmentService.UploadAlwaysReencodeKey, _ImageAlwaysReencode ? "true" : "false");
		KVData.Write("User", "username", _UserName);
	}

	protected override async Task OnInitializedAsync()
	{
		if(bool.TryParse(KVData.Read("App", "throw_exception"), out var result)){
			_throwExceptionInsteadOfPopupErrorMessage = result;
		}
		if(bool.TryParse(KVData.Read("App", "enable_notifications"), out var notificationResult)){
			_enableNotifications = notificationResult;
		}
		if (bool.TryParse(KVData.Read("App", "auto_scroll_down"), out var autoscroll))
		{
			_autoScrollDown = autoscroll;
		}
		if (bool.TryParse(KVData.Read("App", "virtualize"), out var virtualize))
		{
			_virtualize = virtualize;
		}
		if (bool.TryParse(KVData.Read("App", "thinking_collapsed"), out var thinkingCollapsed))
		{
			_thinkingCollapsed = thinkingCollapsed;
		}
		if (bool.TryParse(KVData.Read("App", "toolcall_collapsed"), out var toolCallCollapsed))
		{
			_toolCallCollapsed = toolCallCollapsed;
		}
		if (bool.TryParse(KVData.Read("App", "toolresult_collapsed"), out var toolResultCollapsed))
		{
			_toolResultCollapsed = toolResultCollapsed;
		}
		_UserName = KVData.Read("User", "username") ?? "";
		_ImageStorageMode = ReadEnumSetting(ImageAttachmentService.StorageModeKey, ImageStorageMode.UserUploadImage);
		_ImageProcessingMode = ReadEnumSetting(
			ImageAttachmentService.UploadProcessingModeKey, ImageUploadProcessingMode.Original);
		_ImagePixelBudget = long.TryParse(
			KVData.Read("App", ImageAttachmentService.UploadPixelBudgetKey),
			out var budget)
			? ImageAttachmentRules.ClampPixelBudget(budget)
			: ImageAttachmentRules.DefaultPixelBudget;
		_ImageCompression = ReadEnumSetting(
			ImageAttachmentService.UploadCompressionKey, ImageCompressionAlgorithm.WebP);
		_ImageQuality = int.TryParse(
			KVData.Read("App", ImageAttachmentService.UploadQualityKey),
			out var quality)
			? ImageAttachmentRules.ClampCompressionQuality(quality)
			: ImageAttachmentRules.DefaultCompressionQuality;
		_ImageAlwaysReencode = bool.TryParse(
			KVData.Read("App", ImageAttachmentService.UploadAlwaysReencodeKey),
			out var alwaysReencode) && alwaysReencode;
		Initialized = true;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// JS 互操作不能在静态渲染（预渲染）阶段调用，只能等交互式渲染完成后再获取通知权限状态
		if (!firstRender) return;

		var jsPermission = await JS.InvokeAsync<string>("eval", "Notification.permission");
		notificationPermissionStatus = jsPermission?.ToLowerInvariant() switch
		{
			"granted" => Loc["misc.notification_granted"],
			"denied" => Loc["misc.notification_denied"],
			_ => Loc["misc.notification_unknown"]
		};
		StateHasChanged();
	}
	
	private async Task RequestNotificationPermission()
	{
		var granted = await JS.InvokeAsync<bool>("requestNotificationPermission");
		if (granted)
		{
			notificationPermissionStatus = Loc["misc.notification_granted"];
			// 同时启用通知设置
			_enableNotifications = true;
		}
		else
		{
			notificationPermissionStatus = Loc["misc.notification_denied"];
		}
		StateHasChanged();
	}
}
