@inject IPluginPanelService PluginPanelService
@inject ILocService Loc

<div class="plugin-sidebar @(_isExpanded ? "sidebar-expanded" : "sidebar-collapsed")">
	<button class="sidebar-toggle" @onclick="ToggleSidebar" title="@(_isExpanded ? Loc["sub.collapse"] : Loc["sub.expand"])">
		<i class="@(_isExpanded ? "bi bi-chevron-right" : "bi bi-chevron-left")"></i>
	</button>
	
	<div class="sidebar-content">
		<h5 class="sidebar-title">@Loc["sub.plugin_panels"]</h5>
		
		@foreach (var item in PluginPanelInfos)
		{
			<details class="plugin-item">
				<summary class="plugin-summary">
					<span class="plugin-name">@Loc[item.NameKey]</span>
					<span class="plugin-arrow bi bi-chevron-down"></span>
				</summary>
				@if (!string.IsNullOrEmpty(item.DescriptionKey))
				{
					<p class="plugin-description">@Loc[item.DescriptionKey]</p>
				}
				<div class="plugin-content">
					<DynamicComponent Type="item.PanelType" Parameters="Parameters"/>
				</div>
			</details>
		}
	</div>
</div>

@code {
	[Parameter]
	public Guid ChatGuid { get; set; }

	[Parameter]
	public Guid AgentGuid { get; set; }

	/// <summary>
	/// 宿主上下文：向内暴露当前 Chat / Agent 活对象、消息存储与页面能力方法。
	/// 容器不接收页面实例，只接收这份契约，避免把页面引用泄漏给插件。
	/// </summary>
	[Parameter]
	public ShimmerChatLib.Panel.ChatPanelContext? PanelContext { get; set; }

	#pragma warning disable CS8974
	private Dictionary<string, object> Parameters => new Dictionary<string, object>
	{
		// 旧参数：保持既有面板零改动迁移。
		["ChatGuid"] = ChatGuid,
		["AgentGuid"] = AgentGuid,
		["EventHandlerReg"] = RegisterEventHandler,
		// 新参数：面板通过契约访问活对象与页面能力。
		["PanelContext"] = PanelContext!
	};
	#pragma warning restore CS8974

	private bool _isExpanded = false;

	List<PluginPanelInfo> PluginPanelInfos = default!; // 由 OnInitialized 初始化

	protected override void OnInitialized()
	{
		this.PluginPanelInfos = PluginPanelService.GetPluginPanels()
			.Where(x => x.PanelDisplayPlace == ShimmerChatLib.Panel.PanelDisplayPlace.Chat)
			.ToList();
	}

	private void ToggleSidebar()
	{
		_isExpanded = !_isExpanded;
	}

	/// <summary>供宿主页面或面板登记事件处理器。</summary>
	public void RegisterEventHandler(ShimmerChatLib.Panel.IChatPanelEventHandler eventHandler)
	{
		if (eventHandler == null)
			return;

		// 面板在每次 OnParametersSet 都会重新登记（DynamicComponent 每次渲染
		// 都重设参数），若不去重会随渲染无限累积、同一处理器被重复调用。
		// 登记发生在渲染线程，通知可能来自后台生成线程，故用锁保护。
		lock (_eventHandlersLock)
		{
			if (!EventHandlers.Contains(eventHandler))
				EventHandlers.Add(eventHandler);
		}
	}

	readonly object _eventHandlersLock = new();
	List<ShimmerChatLib.Panel.IChatPanelEventHandler> EventHandlers = [];

	/// <summary>
	/// 在锁内取快照后枚举，避免后台生成线程枚举时渲染线程登记新处理器
	/// 触发 "Collection was modified"。
	/// </summary>
	private void NotifyEventHandlers(Action<ShimmerChatLib.Panel.IChatPanelEventHandler> action)
	{
		ShimmerChatLib.Panel.IChatPanelEventHandler[] snapshot;
		lock (_eventHandlersLock)
		{
			snapshot = EventHandlers.ToArray();
		}

		foreach (var handler in snapshot)
		{
			action(handler);
		}
	}

	public void OnToolCallResult(ShimmerChatLib.Message message)
	{
		NotifyEventHandlers(h => h.OnToolCallResult(message));
	}
	public void OnUserMessage(ShimmerChatLib.Message message)
	{
		NotifyEventHandlers(h => h.OnUserMessage(message));
	}
	public void OnAgentMessage(ShimmerChatLib.Message message)
	{
		NotifyEventHandlers(h => h.OnAgentMessage(message));
	}
}
