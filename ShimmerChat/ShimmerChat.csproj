<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<IsPackable>true</IsPackable>
	  <LangVersion>Preview</LangVersion>
	  <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UserData\**" />
    <Content Remove="UserData\**" />
    <EmbeddedResource Remove="UserData\**" />
    <None Remove="UserData\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Markdig" Version="0.41.0" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShimmerChatBuiltin\ShimmerChatBuiltin.csproj" />
    <ProjectReference Include="..\ShimmerChatLib\ShimmerChatLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Plugins\PLACE_YOUR_PLUGINS_HERE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Locales\*.json" />
    <None Remove="Locales\*.json" />
    <EmbeddedResource Include="Locales\*.json">
      <!-- 文件名形如 {领域}.{culture}.json 会被 AssignCulture 当成附属资源分流到卫星程序集；
           显式标记非文化资源，确保全部键值直接嵌入主程序集供 LocService 后缀匹配。 -->
      <WithCulture>false</WithCulture>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
