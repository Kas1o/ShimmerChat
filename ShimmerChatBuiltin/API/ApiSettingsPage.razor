@code {
    private const string StoreSpace = "ApiSettings";
    private const string StoreKey = "apiSetting";
    private const string SelectedKey = "selectedAPIGuid";

    private List<ApiConfig> apiSettings = [];
    private string? _selectedGuid;
    private string? _savedGuid;
    private string? _savedSnapshot;
    private string? _loadError;

    private List<string> _availableModels = [];
    private bool _fetchingModels;
    private string? _modelFetchError;

    private string? _statusText;
    private StatusKind _statusKind;

    private bool _searchOpen;
    private string _searchQuery = "";

    private bool _renameOpen;
    private string _renameValue = "";
    private string? _renameError;

    private bool _deleteOpen;
    private ApiConfig? _deleteTarget;

    private string? _toastText;
    private bool _toastError;
    private CancellationTokenSource? _toastCts;

    private ElementReference _searchInput;
    private ElementReference _renameInput;
    private ElementReference _deleteCancelButton;
    private bool _focusSearch;
    private bool _focusRename;
    private bool _focusDeleteCancel;

    private DotNetObjectReference<ApiSettingsPage>? _shortcutRef;

    private ApiConfig? Current => apiSettings.FirstOrDefault(s => s.Id.ToString() == _selectedGuid);

    private IEnumerable<ApiConfig> OrderedConfigs =>
        apiSettings.OrderByDescending(config => config.Pinned);

    /// <summary>
    /// 收藏/克隆会改变下拉选项的顺序。原生 select 在选项重排后可能保留旧的
    /// DOM 选中项，因此用签名强制重建元素，保证显示值与 _selectedGuid 一致。
    /// </summary>
    private string SwitchSignature =>
        string.Join('|', OrderedConfigs.Select(config => $"{config.Id}:{config.Pinned}"));

    private bool IsDirty =>
        _savedSnapshot != null
        && (!string.Equals(_savedSnapshot, SerializeConfigs(), StringComparison.Ordinal)
            || !string.Equals(_savedGuid, _selectedGuid, StringComparison.Ordinal));

    private TextCompletionSetting? CurrentTemplate
    {
        get
        {
            var config = Current;
            var list = config?.TextCompletionSettings;
            if (config == null || list == null)
                return null;

            var index = config.SelectedTextCompletionSettingIndex;
            return index >= 0 && index < list.Count ? list[index] : null;
        }
    }

    private IEnumerable<ApiConfig> FilteredConfigs
    {
        get
        {
            var query = (_searchQuery ?? "").Trim();
            if (query.Length == 0)
                return OrderedConfigs;

            return OrderedConfigs.Where(config => Matches(config, query));
        }
    }

    protected override void OnInitialized()
    {
        LoadFromStore();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _shortcutRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("configPageShortcuts.register", _shortcutRef);
            }
            catch (JSDisconnectedException)
            {
                // 电路已断开时无法注册快捷键；页面其余功能不受影响。
            }
            catch (ObjectDisposedException)
            {
            }
        }

        if (_focusSearch)
        {
            _focusSearch = false;
            try
            {
                await _searchInput.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
                // 弹窗在渲染完成前已被关闭，输入框引用尚未生成。
            }
        }

        if (_focusRename)
        {
            _focusRename = false;
            try
            {
                await _renameInput.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
                // 弹窗在渲染完成前已被关闭，输入框引用尚未生成。
            }
        }

        if (_focusDeleteCancel)
        {
            _focusDeleteCancel = false;
            try
            {
                await _deleteCancelButton.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (InvalidOperationException)
            {
                // 弹窗在渲染完成前已被关闭，按钮引用尚未生成。
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("configPageShortcuts.unregister");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }

            _shortcutRef.Dispose();
            _shortcutRef = null;
        }

        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = null;
    }

    private void LoadFromStore()
    {
        _loadError = null;

        try
        {
            var raw = KVData.Read(StoreSpace, StoreKey) ?? "[]";
            apiSettings = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ApiConfig>>(raw) ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load API settings from KV storage.");
            apiSettings = [];
            _selectedGuid = null;
            _savedSnapshot = null;
            _loadError = Loc.Format("config_ui.load_failed", ex.Message);
            return;
        }

        foreach (var config in apiSettings)
            Normalize(config);

        var storedSelection = KVData.Read(StoreSpace, SelectedKey);
        if (!string.IsNullOrWhiteSpace(storedSelection)
            && apiSettings.Any(config => config.Id.ToString() == storedSelection))
        {
            _selectedGuid = storedSelection;
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(storedSelection))
            {
                Logger.LogWarning(
                    "Selected API config '{ConfigId}' no longer exists; falling back to the first config.",
                    storedSelection);
            }

            _selectedGuid = OrderedConfigs.FirstOrDefault()?.Id.ToString() ?? "";
        }

        _savedSnapshot = SerializeConfigs();
        _savedGuid = _selectedGuid;
        _statusText = null;
        _modelFetchError = null;
        _availableModels = [];
    }

    private void Reload()
    {
        LoadFromStore();
        StateHasChanged();
    }

    private void OnSelectionChanged()
    {
        _modelFetchError = null;
        _availableModels = [];
        _statusText = null;
    }

    private void CreateNewConfig()
    {
        var config = new ApiConfig
        {
            Name = NextName(Loc["config_ui.new"])
        };
        Normalize(config);

        apiSettings.Add(config);
        _selectedGuid = config.Id.ToString();
        OnSelectionChanged();
        ShowStatus(Loc.Format("config_ui.created", DisplayName(config)), StatusKind.Info);
    }

    private void CloneCurrentConfig()
    {
        if (Current is not { } source)
            return;

        var copy = source.Clone();
        copy.Name = NextName($"{DisplayName(source)} {Loc["config_ui.copy_suffix"]}");
        Normalize(copy);

        var index = apiSettings.IndexOf(source);
        apiSettings.Insert(index + 1, copy);
        _selectedGuid = copy.Id.ToString();
        OnSelectionChanged();
        ShowStatus(Loc.Format("config_ui.cloned", DisplayName(copy)), StatusKind.Info);
    }

    private void OpenRenameDialog()
    {
        if (Current is not { } config)
            return;

        _renameValue = config.Name ?? "";
        _renameError = null;
        _renameOpen = true;
        _focusRename = true;
    }

    private void CloseRenameDialog()
    {
        _renameOpen = false;
        _renameError = null;
    }

    private void ConfirmRename()
    {
        if (Current is not { } config)
        {
            CloseRenameDialog();
            return;
        }

        var name = (_renameValue ?? "").Trim();
        if (name.Length == 0)
        {
            _renameError = Loc["config_ui.rename_required"];
            return;
        }

        config.Name = name;
        CloseRenameDialog();
        ShowStatus(Loc.Format("config_ui.renamed", name), StatusKind.Info);
    }

    private void TogglePinned()
    {
        if (Current is not { } config)
            return;

        config.Pinned = !config.Pinned;
        ShowStatus(
            Loc.Format(config.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(config)),
            StatusKind.Info);
    }

    private void OpenDeleteDialog()
    {
        if (Current is not { } config)
            return;

        _deleteTarget = config;
        _deleteOpen = true;
        _focusDeleteCancel = true;
    }

    private void CloseDeleteDialog()
    {
        _deleteOpen = false;
        _deleteTarget = null;
    }

    private void ConfirmDelete()
    {
        if (_deleteTarget is not { } target)
            return;

        var index = apiSettings.IndexOf(target);
        var name = DisplayName(target);
        apiSettings.Remove(target);

        _selectedGuid = apiSettings.Count == 0
            ? ""
            : apiSettings[Math.Clamp(index, 0, apiSettings.Count - 1)].Id.ToString();

        CloseDeleteDialog();
        OnSelectionChanged();
        ShowStatus(Loc.Format("config_ui.deleted_pending", name), StatusKind.Info);
    }

    private async Task CopyCurrentIdAsync()
    {
        if (Current is not { } config)
            return;

        var id = config.Id.ToString();
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", id);
            ShowStatus(Loc["config_ui.toast_copied"], StatusKind.Success);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or JSException)
        {
            Logger.LogError(ex, "Failed to copy API config id '{ConfigId}' to the clipboard.", id);
            ShowStatus(Loc.Format("config_ui.toast_copy_failed", ex.Message), StatusKind.Error);
        }
    }

    private void OpenSearchDialog()
    {
        if (apiSettings.Count == 0)
            return;

        _searchQuery = "";
        _searchOpen = true;
        _focusSearch = true;
    }

    private void CloseSearchDialog()
    {
        _searchOpen = false;
        _searchQuery = "";
    }

    private void SelectFromSearch(ApiConfig config)
    {
        _selectedGuid = config.Id.ToString();
        CloseSearchDialog();
        OnSelectionChanged();
    }

    private void OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;

        if (_searchOpen)
            CloseSearchDialog();
        else if (_renameOpen)
            CloseRenameDialog();
        else if (_deleteOpen)
            CloseDeleteDialog();
    }

    private void OnSearchDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseSearchDialog();
    }

    private void OnSearchInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && FilteredConfigs.FirstOrDefault() is { } first)
            SelectFromSearch(first);
    }

    private void OnRenameDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseRenameDialog();
    }

    private void OnRenameInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            ConfirmRename();
    }

    private void OnDeleteDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseDeleteDialog();
    }

    private void SaveAll()
    {
        if (_loadError != null)
        {
            ShowStatus(_loadError, StatusKind.Error);
            return;
        }

        try
        {
            var json = SerializeConfigs();
            KVData.Write(StoreSpace, StoreKey, json);
            KVData.Write(StoreSpace, SelectedKey, _selectedGuid ?? "");
            _savedSnapshot = json;
            _savedGuid = _selectedGuid;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save API settings to KV storage.");
            var message = Loc.Format("config_ui.save_failed", ex.Message);
            ShowStatus(message, StatusKind.Error);
            ShowToast(message, error: true);
            return;
        }

        ShowStatus(Loc["config_ui.toast_saved"], StatusKind.Success);
        ShowToast(Loc["config_ui.toast_saved"], error: false);
        StateHasChanged();
    }

    [JSInvokable]
    public void SaveFromShortcut()
    {
        SaveAll();
    }

    private void CreateTextCompletionSetting()
    {
        if (Current is not { } config)
            return;

        config.TextCompletionSettings ??= [];
        config.TextCompletionSettings.Add(new TextCompletionSetting
        {
            name = Loc["api_settings.new_template_name"],
            SystemMessageTemplate = "<|>",
            UserMessageTemplate = "<|>",
            CharMessageTemplate = "<|>"
        });
        config.SelectedTextCompletionSettingIndex = config.TextCompletionSettings.Count - 1;
    }

    private async Task FetchModelsAsync()
    {
        if (Current is not { } config)
            return;

        if (!SupportsModelFetch(config.Type))
            return;

        _fetchingModels = true;
        _modelFetchError = null;
        _availableModels = [];

        try
        {
            var client = BuildModelListClient(config);
            var models = await client.GetModelNameList();

            // 请求期间可能已经切换到别的配置，旧结果不能覆盖当前配置的列表。
            if (!ReferenceEquals(Current, config))
                return;

            _availableModels = (models ?? [])
                .Where(model => !string.IsNullOrWhiteSpace(model))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(model => model, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (_availableModels.Count == 0)
                _modelFetchError = Loc["api_settings.fetch_empty"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to fetch model list for API config '{ConfigId}'.", config.Id);
            if (ReferenceEquals(Current, config))
                _modelFetchError = Loc.Format("api_settings.fetch_failed", ex.Message);
        }
        finally
        {
            _fetchingModels = false;
        }
    }

    private static OpenAIChatCompletionClient BuildModelListClient(ApiConfig config) => config.Type switch
    {
        ApiConfigType.OpenAI => new OpenAIChatCompletionClient(
            _url: config.OpenAIUrl ?? "https://api.openai.com/v1",
            _apiKey: config.OpenAIApiKey ?? "",
            _model: config.OpenAIModel ?? "gpt-4o"),
        ApiConfigType.DeepSeek => new OpenAIChatCompletionClient(
            _url: config.DeepSeekUrl ?? "https://api.deepseek.com/v1",
            _apiKey: config.DeepSeekApiKey ?? "",
            _model: config.DeepSeekModel ?? "deepseek-v4-flash"),
        ApiConfigType.OpenCodeGo => new OpenAIChatCompletionClient(
            _url: string.IsNullOrWhiteSpace(config.OpenCodeGoUrl)
                ? ApiConfig.OpenCodeGoDefaultUrl
                : config.OpenCodeGoUrl,
            _apiKey: config.OpenCodeGoApiKey ?? "",
            _model: string.IsNullOrWhiteSpace(config.OpenCodeGoModel)
                ? "glm-5.3-flash"
                : config.OpenCodeGoModel)
        {
            ModelsUrl = string.IsNullOrWhiteSpace(config.OpenCodeGoModelsUrl)
                ? null
                : config.OpenCodeGoModelsUrl
        },
        _ => throw new InvalidOperationException($"API type '{config.Type}' does not support model listing.")
    };

    private static bool SupportsModelFetch(ApiConfigType type) =>
        type is ApiConfigType.OpenAI or ApiConfigType.DeepSeek or ApiConfigType.OpenCodeGo;

    private static bool SupportsTextCompletion(ApiConfigType type) =>
        type is ApiConfigType.Kobold or ApiConfigType.Ollama or ApiConfigType.OpenAIText;

    private void ShowStatus(string message, StatusKind kind)
    {
        _statusText = message;
        _statusKind = kind;
    }

    private void ShowToast(string message, bool error)
    {
        _toastText = message;
        _toastError = error;

        _toastCts?.Cancel();
        _toastCts?.Dispose();

        var cts = new CancellationTokenSource();
        _toastCts = cts;
        _ = HideToastAsync(cts.Token);
    }

    private async Task HideToastAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2600, token);
            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested)
                    return;

                _toastText = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // 新的提示覆盖旧提示时取消旧计时器，属于正常路径。
        }
        catch (ObjectDisposedException)
        {
            // 页面在提示消失前销毁，无需再更新 UI。
        }
    }

    private static string StatusClass(StatusKind kind) => kind switch
    {
        StatusKind.Success => "success",
        StatusKind.Error => "error",
        _ => "info"
    };

    private static string StatusIcon(StatusKind kind) => kind switch
    {
        StatusKind.Success => "bi-check-circle-fill",
        StatusKind.Error => "bi-exclamation-circle-fill",
        _ => "bi-info-circle"
    };

    private static string DisplayName(ApiConfig config) =>
        string.IsNullOrWhiteSpace(config.Name) ? config.Id.ToString() : config.Name;

    private string TypeLabel(ApiConfigType type) => type switch
    {
        ApiConfigType.Kobold => Loc["api_settings.type_kobold"],
        ApiConfigType.Ollama => Loc["api_settings.type_ollama"],
        ApiConfigType.OpenAI => Loc["api_settings.type_openai"],
        ApiConfigType.DeepSeek => Loc["api_settings.type_deepseek"],
        ApiConfigType.OpenAIText => Loc["api_settings.type_openai_text"],
        ApiConfigType.Pseudo => Loc["api_settings.type_pseudo"],
        ApiConfigType.OpenCodeGo => Loc["api_settings.type_opencode_go"],
        _ => type.ToString()
    };

    private string ChoiceMeta(ApiConfig config)
    {
        var parts = new List<string>(3);
        var model = config.ModelName;
        if (!string.IsNullOrWhiteSpace(model))
            parts.Add(model);

        var url = UrlSummary(config);
        if (!string.IsNullOrWhiteSpace(url))
            parts.Add(url);

        parts.Add(TypeLabel(config.Type));
        return string.Join(" · ", parts);
    }

    private static string UrlSummary(ApiConfig config) => config.Type switch
    {
        ApiConfigType.Kobold => config.KoboldUrl ?? "",
        ApiConfigType.Ollama => config.OllamaUrl ?? "",
        ApiConfigType.OpenAI => config.OpenAIUrl ?? "",
        ApiConfigType.DeepSeek => config.DeepSeekUrl ?? "",
        ApiConfigType.OpenAIText => config.OpenAITextUrl ?? "",
        ApiConfigType.OpenCodeGo => config.OpenCodeGoUrl ?? "",
        _ => ""
    };

    private bool Matches(ApiConfig config, string query)
    {
        static bool Contains(string? value, string query) =>
            !string.IsNullOrEmpty(value)
            && value.Contains(query, StringComparison.OrdinalIgnoreCase);

        return Contains(config.Name, query)
            || Contains(config.Id.ToString(), query)
            || Contains(TypeLabel(config.Type), query)
            || Contains(config.ModelName, query)
            || Contains(UrlSummary(config), query);
    }

    private string NextName(string baseName)
    {
        var name = baseName;
        var suffix = 2;
        while (apiSettings.Any(config =>
            string.Equals(config.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            name = $"{baseName} {suffix++}";
        }

        return name;
    }

    private static void Normalize(ApiConfig config)
    {
        config.KoboldConf ??= new();
        config.TextCompletionSettings ??= [];

        if (config.TextCompletionSettings.Count == 0)
        {
            config.SelectedTextCompletionSettingIndex = 0;
        }
        else
        {
            config.SelectedTextCompletionSettingIndex = Math.Clamp(
                config.SelectedTextCompletionSettingIndex,
                0,
                config.TextCompletionSettings.Count - 1);
        }
    }

    private static string[] SplitCsv(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? Array.Empty<string>()
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string SerializeConfigs() =>
        Newtonsoft.Json.JsonConvert.SerializeObject(apiSettings);

    private enum StatusKind
    {
        Info,
        Success,
        Error
    }
}
