@using ShimmerChatLib
@using SharperLLM.API
@using ShimmerChatLib.Panel
@attribute [PluginPanelAttribute("panel.api_settings", "panel.api_settings.desc", PanelDisplayPlace.Settings, Order = 1)]
@inject IKVDataService KVData
@inject ILocService Loc
@inject IJSRuntime JS
@inject ILogger<ApiSettingsPage> Logger
@implements IAsyncDisposable

<div class="cfg-page" @onkeydown="OnPageKeyDown">
    <!-- 固定操作面板：页面滚动时保持可见 -->
    <header class="cfg-topbar">
        <div class="cfg-topbar-main">
            <div class="cfg-identity">
                <span class="cfg-identity-icon"><i class="bi bi-hdd-network"></i></span>
                <div class="cfg-identity-text">
                    <div class="cfg-identity-title">
                        <span>@Loc["panel.api_settings"]</span>
                        <span class="su-badge su-badge-secondary">@Loc.Format("config_ui.count", apiSettings.Count)</span>
                        <span class="cfg-dirty @(IsDirty ? "is-dirty" : "is-clean")">
                            @(IsDirty ? Loc["config_ui.unsaved"] : Loc["config_ui.saved"])
                        </span>
                    </div>
                    <div class="cfg-identity-sub">@Loc["panel.api_settings.desc"]</div>
                </div>
            </div>

            <div class="cfg-topbar-actions">
                <button type="button" class="su-btn su-btn-primary su-btn-sm"
                        disabled="@(_loadError != null)"
                        aria-label="@Loc["config_ui.new"]"
                        title="@Loc["config_ui.new"]"
                        @onclick="CreateNewConfig">
                    <i class="bi bi-plus-lg"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.new"]</span>
                </button>
                <button type="button" class="su-btn su-btn-primary su-btn-sm cfg-btn"
                        disabled="@(_loadError != null)"
                        aria-label="@Loc["config_ui.save"]"
                        title="@Loc["config_ui.save"]"
                        @onclick="SaveAll">
                    <i class="bi bi-check-lg"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.save"]</span>
                    <kbd>@Loc["config_ui.shortcut_save"]</kbd>
                </button>
            </div>
        </div>

        <div class="cfg-topbar-sub">
            <label class="cfg-switcher" title="@Loc["config_ui.switch"]">
                <i class="bi bi-collection"></i>
                <select @key="SwitchSignature" class="su-select su-select-sm"
                        @bind="_selectedGuid" @bind:after="OnSelectionChanged"
                        aria-label="@Loc["config_ui.switch"]"
                        disabled="@(apiSettings.Count == 0)">
                    @foreach (var item in OrderedConfigs)
                    {
                        <option value="@item.Id">@(item.Pinned ? "★ " : "")@DisplayName(item) · @TypeLabel(item.Type)</option>
                    }
                </select>
            </label>

            <div class="cfg-topbar-divider"></div>

            <div class="cfg-topbar-tools">
                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                        disabled="@(Current == null)" @onclick="CloneCurrentConfig"
                        aria-label="@Loc["config_ui.clone"]"
                        title="@Loc["config_ui.clone"]">
                    <i class="bi bi-files"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.clone"]</span>
                </button>
                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                        disabled="@(Current == null)" @onclick="OpenRenameDialog"
                        aria-label="@Loc["config_ui.rename"]"
                        title="@Loc["config_ui.rename"]">
                    <i class="bi bi-pencil"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.rename"]</span>
                </button>
                <button type="button"
                        class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn @(Current?.Pinned == true ? "is-active" : "")"
                        disabled="@(Current == null)" @onclick="TogglePinned"
                        aria-label="@(Current?.Pinned == true ? Loc["config_ui.unfavorite"] : Loc["config_ui.favorite"])"
                        title="@(Current?.Pinned == true ? Loc["config_ui.unfavorite"] : Loc["config_ui.favorite"])">
                    <i class="bi @(Current?.Pinned == true ? "bi-star-fill" : "bi-star")"></i>
                </button>
                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn is-danger"
                        disabled="@(Current == null)" @onclick="OpenDeleteDialog"
                        aria-label="@Loc["config_ui.delete"]"
                        title="@Loc["config_ui.delete"]">
                    <i class="bi bi-trash3"></i>
                </button>
                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                        disabled="@(Current == null)" @onclick="CopyCurrentIdAsync"
                        aria-label="@Loc["config_ui.copy_id"]"
                        title="@Loc["config_ui.copy_id"]">
                    <i class="bi bi-clipboard"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.copy_id"]</span>
                </button>
                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                        disabled="@(apiSettings.Count == 0)" @onclick="OpenSearchDialog"
                        aria-label="@Loc["config_ui.search"]"
                        title="@Loc["config_ui.search"]">
                    <i class="bi bi-search"></i>
                    <span class="cfg-btn-label">@Loc["config_ui.search"]</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_statusText))
            {
                <span class="cfg-status is-@StatusClass(_statusKind)" role="status">
                    <i class="bi @StatusIcon(_statusKind)"></i>
                    @_statusText
                </span>
            }
        </div>
    </header>

    @if (_loadError != null)
    {
        <div class="cfg-note is-danger">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <span>@_loadError</span>
            <button type="button" class="su-btn su-btn-sm su-btn-secondary" @onclick="Reload">
                <i class="bi bi-arrow-clockwise"></i> @Loc["config_ui.retry"]
            </button>
        </div>
    }
    else if (apiSettings.Count == 0)
    {
        <div class="cfg-empty">
            <span class="cfg-empty-icon"><i class="bi bi-hdd-network"></i></span>
            <h2>@Loc["config_ui.empty_title"]</h2>
            <p>@Loc["config_ui.empty_desc"]</p>
            <button type="button" class="su-btn su-btn-primary" @onclick="CreateNewConfig">
                <i class="bi bi-plus-lg"></i> @Loc["config_ui.empty_create"]
            </button>
        </div>
    }
    else if (Current is { } config)
    {
        <div class="cfg-body">
            <!-- 基本信息 -->
            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["api_settings.basic"]</h3>
                        <p>@Loc["api_settings.basic_desc"]</p>
                    </div>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["api_settings.name"]</label>
                        <input class="su-input" @bind="config.Name"
                               placeholder="@Loc["api_settings.name_placeholder"]" />
                        <p class="cfg-field-hint">@Loc["api_settings.name_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["api_settings.type"]</label>
                        <select class="su-select" @bind="config.Type">
                            @foreach (var type in Enum.GetValues<ApiConfigType>())
                            {
                                <option value="@type">@TypeLabel(type)</option>
                            }
                        </select>
                        <p class="cfg-field-hint">@Loc["api_settings.type_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["api_settings.id"]</label>
                        <div class="cfg-readonly-row">
                            <code title="@config.Id">@config.Id</code>
                            <button type="button" class="su-btn su-btn-ghost su-btn-sm"
                                    title="@Loc["config_ui.copy_id"]" @onclick="CopyCurrentIdAsync">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <p class="cfg-field-hint">@Loc["api_settings.id_hint"]</p>
                    </div>
                </div>
            </section>

            @if (config.Type == ApiConfigType.Pseudo)
            {
                <div class="cfg-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span><strong>@Loc["PseudoAPI Info Title"]</strong><br />@Loc["PseudoAPI Info Description"]</span>
                </div>
            }

            @if (config.Type == ApiConfigType.OpenAIText)
            {
                <div class="cfg-note is-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span><strong>@Loc["OpenAIText Warning Title"]</strong><br />@Loc["OpenAIText Warning Description"]</span>
                </div>
            }

            @if (config.Type == ApiConfigType.OpenCodeGo)
            {
                <div class="cfg-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span><strong>@Loc["OpenCodeGo Info Title"]</strong><br />@Loc["OpenCodeGo Info Description"]</span>
                </div>
            }

            <!-- 连接 -->
            @if (config.Type == ApiConfigType.Kobold)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-plug"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["api_settings.connection"]</h3>
                            <p>@Loc["api_settings.connection_desc"]</p>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-8">
                            <label class="su-label">@Loc["API URL"]</label>
                            <input class="su-input" @bind="config.KoboldUrl" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Temperature"]</label>
                            <input type="number" step="0.01" min="0" max="2" class="su-input"
                                   @bind="config.KoboldConf!.temperature" />
                        </div>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-arrows-expand"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["Context & Length"]</h3>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["Max Context Length"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.max_context_length" />
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["Max Length"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.max_length" />
                        </div>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-sliders2"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["Sampling Settings"]</h3>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Top K"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.top_k" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Top P"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.top_p" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Top A"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.top_a" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Min P"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.min_p" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Typical"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.typical" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["TFS (Tail Free Sampling)"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.tfs" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Sampler Seed"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.sampler_seed" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Repetition Penalty"]</label>
                            <input type="number" step="0.01" min="1" max="2" class="su-input"
                                   @bind="config.KoboldConf!.rep_pen" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["Repetition Penalty Range"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.rep_pen_range" />
                        </div>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-thermometer-half"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["Dynamic Temperature"]</h3>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Dynatemp Range"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.dynatemp_range" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Dynatemp Exponent"]</label>
                            <input type="number" step="0.01" min="0" max="2" class="su-input"
                                   @bind="config.KoboldConf!.dynatemp_exponent" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Smoothing Factor"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.smoothing_factor" />
                        </div>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-activity"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["Mirostat"]</h3>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Mirostat (0=disabled, 1=v1, 2=v2)"]</label>
                            <input type="number" min="0" max="2" class="su-input"
                                   @bind="config.KoboldConf!.mirostat" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Mirostat Tau"]</label>
                            <input type="number" class="su-input" @bind="config.KoboldConf!.mirostat_tau" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Mirostat Eta"]</label>
                            <input type="number" step="0.01" min="0" max="1" class="su-input"
                                   @bind="config.KoboldConf!.mirostat_eta" />
                        </div>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-gear"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["Advanced"]</h3>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["Stop Sequence (comma separated)"]</label>
                            <input class="su-input"
                                   @bind:get="string.Join(',', config.KoboldConf!.stop_sequence ?? Array.Empty<string>())"
                                   @bind:set="value => config.KoboldConf!.stop_sequence = SplitCsv(value)" />
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["Banned Tokens (comma separated)"]</label>
                            <input class="su-input"
                                   @bind:get="string.Join(',', config.KoboldConf!.banned_tokens ?? Array.Empty<string>())"
                                   @bind:set="value => config.KoboldConf!.banned_tokens = SplitCsv(value)" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["Genkey"]</label>
                            <input class="su-input" @bind="config.KoboldConf!.genkey" />
                        </div>
                        <div class="cfg-field cfg-span-8">
                            <label class="su-label">@Loc["Grammar"]</label>
                            <textarea class="su-textarea cfg-code" rows="3" @bind="config.KoboldConf!.grammar"></textarea>
                        </div>
                        <div class="cfg-field cfg-span-12">
                            <div class="cfg-toggle-row">
                                <label class="cfg-toggle">
                                    <input type="checkbox" @bind="config.KoboldConf!.trim_stop" />
                                    <span>@Loc["Trim Stop"]</span>
                                </label>
                                <label class="cfg-toggle">
                                    <input type="checkbox" @bind="config.KoboldConf!.bypass_eos" />
                                    <span>@Loc["Bypass EOS"]</span>
                                </label>
                            </div>
                            <p class="cfg-field-hint">@Loc["Note: Logit bias settings are available in the API but not configurable through this interface."]</p>
                        </div>
                    </div>
                </section>
            }
            else if (config.Type == ApiConfigType.OpenAI)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-plug"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["api_settings.connection"]</h3>
                            <p>@Loc["api_settings.connection_desc"]</p>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-8">
                            <label class="su-label">@Loc["API URL"]</label>
                            <input class="su-input" @bind="config.OpenAIUrl" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["API KEY"]</label>
                            <input type="password" autocomplete="off" class="su-input" @bind="config.OpenAIApiKey" />
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["API MODEL"]</label>
                            <div class="cfg-input-row">
                                <input class="su-input" list="api-model-options" @bind="config.OpenAIModel"
                                       placeholder="@Loc["api_settings.model_placeholder"]" />
                                <button type="button" class="su-btn su-btn-outline su-btn-sm"
                                        disabled="@_fetchingModels" @onclick="FetchModelsAsync">
                                    <i class="bi @(_fetchingModels ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                                    @(_fetchingModels ? Loc["api_settings.fetching_models"] : Loc["api_settings.fetch_models"])
                                </button>
                            </div>
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["API GENERATION LENGTH"]</label>
                            <input type="number" class="su-input" @bind="config.OpenAICtx" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["API REASONING ECHO"]</label>
                            <select class="su-select" @bind="config.OpenAIReasoningEchoMode">
                                <option value="@ReasoningEchoMode.Full">@Loc["API REASONING ECHO FULL"]</option>
                                <option value="@ReasoningEchoMode.AfterLastUser">@Loc["API REASONING ECHO AFTER LAST USER"]</option>
                                <option value="@ReasoningEchoMode.None">@Loc["API REASONING ECHO NONE"]</option>
                            </select>
                        </div>
                        @if (_modelFetchError != null)
                        {
                            <p class="cfg-field-error cfg-span-12">@_modelFetchError</p>
                        }
                        else if (_availableModels.Count > 0)
                        {
                            <p class="cfg-field-hint cfg-span-12">@Loc.Format("api_settings.models_loaded", _availableModels.Count)</p>
                        }
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-toggles"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["api_settings.generation"]</h3>
                            <p>@Loc["api_settings.generation_desc"]</p>
                        </div>
                    </div>
                    <div class="cfg-toggle-row">
                        <label class="cfg-toggle">
                            <input type="checkbox" @bind="config.OpenAIStream" />
                            <span>@Loc["API ENABLE STREAM"]</span>
                        </label>
                        <label class="cfg-toggle">
                            <input type="checkbox" @bind="config.OpenAIAsIs" />
                            <span>@Loc["API ASIS"]</span>
                        </label>
                    </div>
                </section>

                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-braces"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["api_settings.advanced"]</h3>
                            <p>@Loc["api_settings.advanced_desc"]</p>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-12">
                            <label class="su-label">@Loc["API CUSTOM REQUEST BODY"]</label>
                            <textarea class="su-textarea cfg-code" rows="6"
                                      @bind="config.OpenAICustomRequestBody"
                                      placeholder="@Loc["API CUSTOM REQUEST BODY PLACEHOLDER"]"></textarea>
                        </div>
                    </div>
                </section>
            }
            else if (config.Type == ApiConfigType.DeepSeek)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-plug"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["api_settings.connection"]</h3>
                            <p>@Loc["api_settings.connection_desc"]</p>
                        </div>
                    </div>
                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-8">
                            <label class="su-label">@Loc["API URL"]</label>
                            <input class="su-input" @bind="config.DeepSeekUrl" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["API KEY"]</label>
                            <input type="password" autocomplete="off" class="su-input" @bind="config.DeepSeekApiKey" />
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["API MODEL"]</label>
                            <div class="cfg-input-row">
                                <input class="su-input" list="api-model-options" @bind="config.DeepSeekModel"
                                       placeholder="@Loc["api_settings.model_placeholder"]" />
                                <button type="button" class="su-btn su-btn-outline su-btn-sm"
                                        disabled="@_fetchingModels" @onclick="FetchModelsAsync">
                                    <i class="bi @(_fetchingModels ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                                    @(_fetchingModels ? Loc["api_settings.fetching_models"] : Loc["api_settings.fetch_models"])
                                </button>
                            </div>
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["API GENERATION LENGTH"]</label>
                            <input type="number" class="su-input" @bind="config.DeepSeekCtx" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["API REASONING EFFORT"]</label>
                            <select class="su-select" @bind="config.DeepSeekReasoningEffort">
                                <option value="">@Loc["API REASONING EFFORT OFF"]</option>
                                <option value="low">Low</option>
                                <option value="high">High</option>
