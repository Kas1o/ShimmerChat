@using ShimmerChatLib.ChatView
@inject ILocService Loc

@*
	工具调用活动块：把回合内的工具调用交互合并成一块可折叠内容。
	无论一次还是多次调用（包括周围没有其它调用的单独调用）都归入这里，
	使界面保持「正文 + 一行工具活动」的整洁形态；展开后仍是完整的思考、参数与返回内容。
*@

<details class="chat-activity" open="@Block.IsOpen">
	<summary class="chat-activity-summary">
		<span class="chat-activity-title">🔧 @Loc["chatview.agg.tool_activity"]</span>
		<span class="chat-activity-meta">@Loc.Format("chatview.agg.tool_activity_meta", Block.Interactions.Count, Block.ToolCount)</span>
	</summary>
	<div class="chat-activity-body">
		@foreach (var interaction in Block.Interactions)
		{
			<ChatToolInteractionView Context="Context" Interaction="interaction" />
		}
	</div>
</details>

@code {
	[Parameter, EditorRequired] public ChatViewContext Context { get; set; } = default!;

	[Parameter, EditorRequired] public ChatToolActivityBlock Block { get; set; } = default!;
}
