@using ShimmerChatLib.ChatView
@inject ILocService Loc

@*
	折叠的工具调用活动块：把回合内连续「无输出」的步骤（正文为空，只有思考与工具调用）
	合并成一块默认折叠的内容，使界面保持整洁；展开后仍是完整的思考、参数与返回内容。
*@

<details class="chat-activity">
	<summary class="chat-activity-summary">
		<span class="chat-activity-title">🔧 @Loc["chatview.agg.tool_activity"]</span>
		<span class="chat-activity-meta">@Loc.Format("chatview.agg.tool_activity_meta", Steps.Count, ToolCount)</span>
	</summary>
	<div class="chat-activity-body">
		@foreach (var step in Steps)
		{
			<ChatTurnStepView Context="Context" Step="step" />
		}
	</div>
</details>

@code {
	[Parameter, EditorRequired] public ChatViewContext Context { get; set; } = default!;

	[Parameter, EditorRequired] public IReadOnlyList<ChatTurnStep> Steps { get; set; } = [];

	private int ToolCount => Steps.Sum(s => s.ToolCount);
}
