@using ShimmerChatLib.ChatView
@using ShimmerChatBuiltin.ChatView.Common

@*
	聚合回合中的一个步骤：AI 消息本体 + 它触发的工具结果。
	分段不带发送者行（气泡头由回合统一渲染），因此操作条落在分段末尾。
*@

@if (Step.Assistant is not null)
{
	<ChatMessageBubble Context="Context" message="Step.Assistant" ShowSender="false" ShowActions="true" ShowRegenerate="ShowRegenerate" />
}

@foreach (var toolResult in Step.ToolResults)
{
	<ChatMessageBubble Context="Context"
		message="toolResult.Message"
		ShowSender="false"
		ShowActions="true"
		ToolResultTitleOverride="@ToolTitle(toolResult)" />
}

@code {
	[Parameter, EditorRequired] public ChatViewContext Context { get; set; } = default!;

	[Parameter, EditorRequired] public ChatTurnStep Step { get; set; } = default!;

	/// <summary>是否显示重新生成 / 续写（只在回合的收尾步骤上开启）。</summary>
	[Parameter] public bool ShowRegenerate { get; set; }

	/// <summary>工具结果折叠标题：有工具名时用工具名，否则回退到默认标题。</summary>
	private static string? ToolTitle(ChatToolResult toolResult)
		=> string.IsNullOrEmpty(toolResult.ToolName) ? null : $"🔧 {toolResult.ToolName}";
}
