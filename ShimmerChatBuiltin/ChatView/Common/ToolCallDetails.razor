@using Newtonsoft.Json.Linq
@inject IKVDataService KVData

@* 消息内联的工具调用列表（折叠展示参数）。 *@

<div class="toolcalls">
    @foreach (var tc in message?.message?.toolCalls ?? [])
    {
        <details class="tc-item" open="@(!_toolCallCollapsed)">
            <summary class="tc-summary">
                <span class="tc-badge">@tc.name</span>
            </summary>
            @if (!string.IsNullOrEmpty(tc.arguments))
            {
                <div class="tc-args">
                    <ShimmerChatLib.Components.JsonTreeView Token="ParseArgs(tc.arguments)" DefaultExpandLevel="1" />
                </div>
            }
        </details>
    }
</div>

@code {
    [Parameter] public ShimmerChatLib.Message message { get; set; } = null!;

    /// <summary>
    /// 折叠设置只在设置页修改；缓存在组件里，避免气泡每次重渲染都读一次 KV 存储。
    /// 设置页返回后组件会重建，因此不需要监听运行时变化。
    /// </summary>
    private bool? _toolCallCollapsedSetting;

    private bool _toolCallCollapsed
    {
        get
        {
            if (_toolCallCollapsedSetting == null)
            {
                var value = KVData.Read("App", "toolcall_collapsed");
                _toolCallCollapsedSetting = string.IsNullOrEmpty(value)
                    || !bool.TryParse(value, out var parsed) || parsed;
            }

            return _toolCallCollapsedSetting.Value;
        }
    }

    private static JToken ParseArgs(string args)
    {
        try { return JToken.Parse(args); }
        catch { return JValue.CreateString(args); }
    }
}
