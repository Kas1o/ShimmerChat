@attribute [PluginPanel("panel.dyn_prompt", "panel.dyn_prompt.desc")]

@using ShimmerChatBuiltin.DynPrompt
@using ShimmerChatLib.Components
@using ShimmerChatLib.Interface
@using Newtonsoft.Json
@inject IKVDataService pluginData
@inject ILocService Loc
@inject ILogger<DynPromptPanel> Logger

<ConfigShell T="DynPromptSet"
            Items="_sets"
            SelectedId="@_selectedSetId"
            IdSelector="@(s => s.Id)"
            NameSelector="@(s => s.Name)"
            TypeSelector="@(s => Loc.Format("dynprompt_config.term_count_short", s.Terms.Count))"
            MetaSelector="@(s => string.Join(" · ", s.Terms.Take(3).Select(t => t.Name)))"
            SearchSelector="@(s => string.Join(' ', s.Terms.Select(t => $"{t.Name} {t.Content} {t.TriggerRule}")))"
            PinSelector="@(s => s.Pinned)"
            Title="@Loc["panel_dynprompt.title"]"
            Description="@Loc["panel.dyn_prompt.desc"]"
            Icon="bi-magic"
            IsDirty="IsDirty"
            LoadError="@_loadError"
            StatusMessage="@_statusText"
            StatusKind="@_statusKind"
            OnCreate="CreateSet"
            OnSave="SaveAll"
            OnSelect="SelectSet"
            OnClone="CloneSet"
            OnRename="RenameSet"
            OnDelete="DeleteSet"
            OnTogglePin="TogglePin"
            OnRetry="Reload">
    <Body>
        @if (Current is { } set)
        {
            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["dynprompt_config.basic"]</h3>
                        <p>@Loc["dynprompt_config.basic_desc"]</p>
                    </div>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["panel_dynprompt.label_set_name"]</label>
                        <input class="su-input" @bind="set.Name"
                               placeholder="@Loc["panel_dynprompt.set_name_placeholder"]" />
                        <p class="cfg-field-hint">@Loc["dynprompt_config.name_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["embedding_config.id"]</label>
                        <div class="cfg-readonly-row">
                            <code title="@set.Id">@set.Id</code>
                        </div>
                        <p class="cfg-field-hint">@Loc["dynprompt_config.id_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["panel_dynprompt.term_list"]</label>
                        <div class="cfg-active-row">
                            <span class="su-badge su-badge-secondary">
                                @Loc.Format("panel_dynprompt.term_count", set.Terms.Count)
                            </span>
                        </div>
                        <p class="cfg-field-hint">@Loc["dynprompt_config.term_count_hint"]</p>
                    </div>
                </div>
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-braces"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_dynprompt.term_list"]</h3>
                        <p>@Loc["dynprompt_config.terms_desc"]</p>
                    </div>
                    <button type="button" class="su-btn su-btn-primary su-btn-sm" @onclick="OpenAddTerm">
                        <i class="bi bi-plus-lg"></i> @Loc["panel_dynprompt.add_term_btn"]
                    </button>
                </div>

                @if (set.Terms.Count == 0)
                {
                    <div class="cfg-empty cfg-empty-compact">
                        <span class="cfg-empty-icon"><i class="bi bi-braces"></i></span>
                        <p>@Loc["panel_dynprompt.no_terms"]</p>
                        <button type="button" class="su-btn su-btn-primary su-btn-sm" @onclick="OpenAddTerm">
                            <i class="bi bi-plus-lg"></i> @Loc["panel_dynprompt.add_term_btn"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="cfg-term-list">
                        @for (var i = 0; i < set.Terms.Count; i++)
                        {
                            var index = i;
                            var term = set.Terms[index];
                            <div class="cfg-term-card">
                                <div class="cfg-term-main">
                                    <div class="cfg-term-title">
                                        <strong>@term.Name</strong>
                                        <span class="su-badge su-badge-secondary">@ModeLabel(term.InjectionMode)</span>
                                        @if (term.InjectionMode == DynPromptTermInjectionMode.AtDepth)
                                        {
                                            <span class="su-badge su-badge-secondary">@Loc.Format("dynprompt_config.depth", term.InjectionDepth)</span>
                                        }
                                    </div>
                                    <p class="cfg-term-preview">@Preview(term.Content)</p>
                                    <p class="cfg-term-meta">
                                        <i class="bi bi-funnel"></i>
                                        @(string.IsNullOrWhiteSpace(term.TriggerRule) ? Loc["panel_dynprompt.none"] : term.TriggerRule)
                                    </p>
                                </div>
                                <div class="cfg-term-actions">
                                    <button type="button" class="su-btn su-btn-secondary su-btn-sm"
                                            title="@Loc["panel_dynprompt.edit"]" aria-label="@Loc["panel_dynprompt.edit"]"
                                            @onclick="() => OpenEditTerm(index)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn is-danger"
                                            title="@Loc["panel_dynprompt.delete"]" aria-label="@Loc["panel_dynprompt.delete"]"
                                            @onclick="() => OpenDeleteTerm(index)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <p class="cfg-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>@Loc["dynprompt_config.terms_hint"]</span>
                </p>
            </section>
        }
    </Body>

    <EmptyState>
        <div class="cfg-empty">
            <span class="cfg-empty-icon"><i class="bi bi-magic"></i></span>
            <h2>@Loc["dynprompt_config.empty_title"]</h2>
            <p>@Loc["dynprompt_config.empty_desc"]</p>
            <button type="button" class="su-btn su-btn-primary" @onclick="CreateSet">
                <i class="bi bi-plus-lg"></i> @Loc["panel_dynprompt.create"]
            </button>
        </div>
    </EmptyState>
</ConfigShell>

@if (_termOpen)
{
    <div class="su-modal-mask" @onclick="CloseTerm" @onkeydown="OnTermKeyDown">
        <div class="cfg-dialog cfg-dialog-lg" role="dialog" aria-modal="true"
             @onclick:stopPropagation="true" @onkeydown="OnTermKeyDown">
            <div class="cfg-dialog-head">
                <span class="cfg-dialog-icon"><i class="bi bi-braces"></i></span>
                <div class="cfg-dialog-heading">
                    <h2>@(_termIndex < 0 ? Loc["panel_dynprompt.add_term_title"] : Loc["panel_dynprompt.edit_term_title"])</h2>
                    <p>@Loc["dynprompt_config.term_dialog_desc"]</p>
                </div>
                <button type="button" class="cfg-dialog-close" aria-label="@Loc["config_ui.dismiss"]" @onclick="CloseTerm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cfg-dialog-body">
                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["panel_dynprompt.label_term_name"]</label>
                        <input @ref="_termNameInput" class="su-input" @bind="_termDraft.Name" @bind:event="oninput"
                               placeholder="@Loc["panel_dynprompt.term_name_placeholder"]" />
                        @if (_termErrors.TryGetValue("name", out var nameError))
                        {
                            <p class="cfg-field-error">@nameError</p>
                        }
                    </div>
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["panel_dynprompt.label_inject_mode"]</label>
                        <select class="su-select" @bind="_termDraft.InjectionMode">
                            @foreach (var mode in Enum.GetValues<DynPromptTermInjectionMode>())
                            {
                                <option value="@mode">@ModeLabel(mode)</option>
                            }
                        </select>
                    </div>
                    <div class="cfg-field cfg-span-12">
                        <label class="su-label">@Loc["panel_dynprompt.label_content"]</label>
                        <textarea class="su-input cfg-textarea" rows="6" @bind="_termDraft.Content"
                                  placeholder="@Loc["panel_dynprompt.term_content_placeholder"]"></textarea>
                        @if (_termErrors.TryGetValue("content", out var contentError))
                        {
                            <p class="cfg-field-error">@contentError</p>
                        }
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_dynprompt.label_inject_depth"]</label>
                        <input type="number" min="1" class="su-input" @bind="_termDraft.InjectionDepth" />
                    </div>
                    <div class="cfg-field cfg-span-8">
                        <label class="su-label">@Loc["panel_dynprompt.label_trigger_rule"]</label>
                        <input class="su-input" @bind="_termDraft.TriggerRule"
                               placeholder="@Loc["panel_dynprompt.trigger_rule_placeholder"]" />
                        @if (_termErrors.TryGetValue("trigger", out var triggerError))
                        {
                            <p class="cfg-field-error">@triggerError</p>
                        }
                        <p class="cfg-field-hint">
                            @Loc["panel_dynprompt.trigger_rule_help"]
                            <a href="https://github.com/Kas1o/ShimmerChat/blob/master/ShimmerChatBuiltin/DynPrompt/TriggerRule.md"
                               target="_blank" rel="noreferrer">@Loc["panel_dynprompt.doc_link"]</a>
                        </p>
                    </div>
                    <div class="cfg-field cfg-span-12">
                        <label class="cfg-toggle">
                            <input type="checkbox" @bind="_termDraft.AllowBeTriggeredByRecursive" />
                            <span>@Loc["panel_dynprompt.allow_recursive"]</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="cfg-dialog-footer">
                <button type="button" class="su-btn su-btn-secondary" @onclick="CloseTerm">
                    @Loc["panel_dynprompt.cancel"]
                </button>
                <button type="button" class="su-btn su-btn-primary" @onclick="SaveTerm">
                    @Loc["panel_dynprompt.save"]
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteTermIndex >= 0 && Current is { } deleteSet && _deleteTermIndex < deleteSet.Terms.Count)
{
    <div class="su-modal-mask" @onclick="CloseDeleteTerm" @onkeydown="OnDeleteTermKeyDown">
        <div class="cfg-dialog cfg-dialog-sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true"
             @onkeydown="OnDeleteTermKeyDown">
            <div class="cfg-dialog-head">
                <span class="cfg-dialog-icon is-danger"><i class="bi bi-trash3"></i></span>
                <div class="cfg-dialog-heading">
                    <h2>@Loc["panel_dynprompt.delete"]</h2>
                    <p>@Loc["dynprompt_config.delete_term_desc"]</p>
                </div>
                <button type="button" class="cfg-dialog-close" aria-label="@Loc["config_ui.dismiss"]" @onclick="CloseDeleteTerm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="cfg-dialog-body">
                <div class="cfg-note is-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@Loc.Format("panel_dynprompt.msg_confirm_delete_term", deleteSet.Terms[_deleteTermIndex].Name)</span>
                </div>
            </div>
            <div class="cfg-dialog-footer">
                <button type="button" class="su-btn su-btn-secondary" @onclick="CloseDeleteTerm">
                    @Loc["config_ui.dialog_cancel"]
                </button>
                <button type="button" class="su-btn su-btn-danger" @onclick="ConfirmDeleteTerm">
                    <i class="bi bi-trash3"></i> @Loc["config_ui.dialog_delete"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string Space = "DynPrompt";
    private const string Key = "DynPromptSets";

    private List<DynPromptSet> _sets = [];
    private string? _selectedSetId;
    private string? _loadError;
    private string? _savedSnapshot;
    private string _statusText = string.Empty;
    private string _statusKind = "info";

    private bool _termOpen;
    private int _termIndex = -1;
    private DynPromptTerm _termDraft = NewTerm();
    private Dictionary<string, string> _termErrors = new();
    private ElementReference _termNameInput;

    private int _deleteTermIndex = -1;

    private DynPromptSet? Current =>
        _sets.FirstOrDefault(s => string.Equals(s.Id, _selectedSetId, StringComparison.Ordinal));

    private bool IsDirty => _loadError == null && Snapshot() != _savedSnapshot;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        try
        {
            var data = pluginData.Read(Space, Key);
            _sets = string.IsNullOrEmpty(data)
                ? []
                : JsonConvert.DeserializeObject<List<DynPromptSet>>(data) ?? [];

            foreach (var set in _sets)
            {
                if (string.IsNullOrWhiteSpace(set.Id))
                {
                    set.Id = Guid.NewGuid().ToString("N");
                    Logger.LogWarning("DynPrompt 集合 {Name} 缺少 Id，已生成 {Id}", set.Name, set.Id);
                }
            }

            _loadError = null;
            _selectedSetId = _sets.FirstOrDefault()?.Id;
            _savedSnapshot = Snapshot();
            _statusText = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载 DynPrompt 集合失败");
            _loadError = Loc.Format("panel_dynprompt.msg_load_failed", ex.Message);
            _sets = [];
            _selectedSetId = null;
            _savedSnapshot = null;
        }
    }

    private string Snapshot() => JsonConvert.SerializeObject(_sets);

    private async Task SaveAll()
    {
        if (_loadError is not null) return;

        if (_sets.Any(s => string.IsNullOrWhiteSpace(s.Name)))
        {
            SetStatus(Loc["panel_dynprompt.msg_invalid_set_names"], "error");
            return;
        }

        if (_sets.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
        {
            SetStatus(Loc["panel_dynprompt.msg_set_name_exists"], "error");
            return;
        }

        foreach (var set in _sets)
        {
            var termError = FindTermError(set);
            if (termError != null)
            {
                SetStatus(termError, "error");
                return;
            }
        }

        try
        {
            pluginData.Write(Space, Key, JsonConvert.SerializeObject(_sets, Formatting.Indented));
            _savedSnapshot = Snapshot();
            SetStatus(Loc["panel_dynprompt.msg_all_saved"], "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "保存 DynPrompt 集合失败");
            SetStatus(Loc.Format("panel_dynprompt.msg_save_all_failed", ex.Message), "error");
        }

        await Task.CompletedTask;
    }

    private string? FindTermError(DynPromptSet set)
    {
        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var term in set.Terms)
        {
            if (string.IsNullOrWhiteSpace(term.Name) || string.IsNullOrWhiteSpace(term.Content))
                return Loc["panel_dynprompt.msg_invalid_terms"];

            if (!names.Add(term.Name))
                return Loc["panel_dynprompt.msg_term_name_exists"];

            if (!ValidateTrigger(term.TriggerRule, out _))
                return Loc.Format("panel_dynprompt.msg_term_trigger_error", term.Name);
        }

        return null;
    }

    private async Task CreateSet()
    {
        var set = new DynPromptSet
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = NextName(Loc["panel_dynprompt.create_new_set"])
        };

        _sets.Add(set);
        _selectedSetId = set.Id;
        SetStatus(Loc.Format("config_ui.created", set.Name), "info");
        await Task.CompletedTask;
    }

    private async Task CloneSet()
    {
        if (Current is not { } source) return;

        var copy = source.Clone();
        copy.Id = Guid.NewGuid().ToString("N");
        copy.Name = NextName($"{DisplayName(source)} {Loc["config_ui.copy_suffix"]}");

        var index = _sets.IndexOf(source);
        _sets.Insert(index + 1, copy);
        _selectedSetId = copy.Id;
        SetStatus(Loc.Format("config_ui.cloned", copy.Name), "info");
        await Task.CompletedTask;
    }

    private async Task RenameSet(string name)
    {
        if (Current is not { } set) return;

        if (_sets.Any(s => !ReferenceEquals(s, set) && string.Equals(s.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            SetStatus(Loc["panel_dynprompt.msg_set_name_exists"], "error");
            return;
        }

        set.Name = name;
        SetStatus(Loc.Format("config_ui.renamed", set.Name), "info");
        await Task.CompletedTask;
    }

    private async Task DeleteSet()
    {
        if (Current is not { } set) return;

        var index = _sets.IndexOf(set);
        _sets.Remove(set);
        _selectedSetId = _sets.Count == 0 ? null : _sets[Math.Min(index, _sets.Count - 1)].Id;
        SetStatus(Loc.Format("config_ui.deleted_pending", DisplayName(set)), "info");
        await Task.CompletedTask;
    }

    private async Task TogglePin(DynPromptSet set)
    {
        set.Pinned = !set.Pinned;
        SetStatus(Loc.Format(set.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(set)), "info");
        await Task.CompletedTask;
    }

    private async Task SelectSet(string id)
    {
        _selectedSetId = id;
        await Task.CompletedTask;
    }

    private void OpenAddTerm()
    {
        _termIndex = -1;
        _termDraft = NewTerm();
        _termErrors = new();
        _termOpen = true;
        FocusTermName();
    }

    private void OpenEditTerm(int index)
    {
        if (Current is not { } set || index < 0 || index >= set.Terms.Count) return;

        _termIndex = index;
        _termDraft = set.Terms[index].Clone();
        _termErrors = new();
        _termOpen = true;
        FocusTermName();
    }

    private async void FocusTermName()
    {
        try
        {
            await Task.Yield();
            await _termNameInput.FocusAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or InvalidOperationException)
        {
            // 对话框其余操作不依赖初始焦点。
        }
    }

    private void CloseTerm()
    {
        _termOpen = false;
        _termErrors = new();
    }

    private void SaveTerm()
    {
        if (Current is not { } set) return;

        _termErrors = new();
        var name = _termDraft.Name.Trim();
        var content = _termDraft.Content.Trim();

        if (name.Length == 0)
            _termErrors["name"] = Loc["panel_dynprompt.msg_term_name_required"];
        else if (set.Terms.Where((t, i) => i != _termIndex)
                    .Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
            _termErrors["name"] = Loc["panel_dynprompt.msg_term_name_exists"];

        if (content.Length == 0)
            _termErrors["content"] = Loc["panel_dynprompt.msg_term_content_required"];

        if (!ValidateTrigger(_termDraft.TriggerRule, out var triggerMessage))
            _termErrors["trigger"] = Loc.Format("panel_dynprompt.msg_trigger_syntax_error", triggerMessage ?? "");

        if (_termErrors.Count > 0)
        {
            SetStatus(Loc["panel_dynprompt.msg_fix_form_errors"], "error");
            return;
        }

        var edited = _termDraft.Clone();
        edited.Name = name;
        edited.Content = _termDraft.Content;

        if (_termIndex >= 0 && _termIndex < set.Terms.Count)
            set.Terms[_termIndex] = edited;
        else
            set.Terms.Add(edited);

        _termOpen = false;
        SetStatus(_termIndex >= 0 ? Loc["panel_dynprompt.msg_term_updated"] : Loc["panel_dynprompt.msg_term_added"], "info");
    }

    private void OpenDeleteTerm(int index)
    {
        if (Current is not { } set || index < 0 || index >= set.Terms.Count) return;
        _deleteTermIndex = index;
    }

    private void CloseDeleteTerm() => _deleteTermIndex = -1;

    private void ConfirmDeleteTerm()
    {
        if (Current is not { } set || _deleteTermIndex < 0 || _deleteTermIndex >= set.Terms.Count) return;

        var name = set.Terms[_deleteTermIndex].Name;
        set.Terms.RemoveAt(_deleteTermIndex);
        _deleteTermIndex = -1;
        SetStatus(Loc.Format("panel_dynprompt.msg_term_deleted", name), "info");
    }

    private void OnTermKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseTerm();
    }

    private void OnDeleteTermKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDeleteTerm();
    }

    private static bool ValidateTrigger(string rule, out string? message)
    {
        message = null;
        if (string.IsNullOrEmpty(rule)) return true;

        try
        {
            _ = DynPromptEvaluator.Evaluate(rule, string.Empty);
            return true;
        }
        catch (Exception ex)
        {
            message = ex.Message;
            return false;
        }
    }

    private string ModeLabel(DynPromptTermInjectionMode mode) => mode switch
    {
        DynPromptTermInjectionMode.AtDepth => Loc["dynprompt_config.mode_at_depth"],
        DynPromptTermInjectionMode.AfterSystem => Loc["dynprompt_config.mode_after_system"],
        _ => Loc["dynprompt_config.mode_before_system"]
    };

    private static string Preview(string content)
    {
        var text = content.Replace('\r', ' ').Replace('\n', ' ').Trim();
        return text.Length > 120 ? text[..120] + "…" : text;
    }

    private static DynPromptTerm NewTerm() => new()
    {
        Name = string.Empty,
        Content = string.Empty,
        InjectionMode = DynPromptTermInjectionMode.BeforeSystem,
        InjectionDepth = 4,
        TriggerRule = string.Empty,
        AllowBeTriggeredByRecursive = false
    };

    private void SetStatus(string message, string kind)
    {
        _statusText = message;
        _statusKind = kind;
    }

    private string DisplayName(DynPromptSet set) =>
        string.IsNullOrWhiteSpace(set.Name) ? Loc["config_ui.untitled"] : set.Name;

    private string NextName(string baseName)
    {
        var name = string.IsNullOrWhiteSpace(baseName) ? Loc["config_ui.new"] : baseName.Trim();
        var candidate = name;
        var suffix = 2;

        while (_sets.Any(s => string.Equals(s.Name, candidate, StringComparison.OrdinalIgnoreCase)))
            candidate = $"{name} ({suffix++})";

        return candidate;
    }
}
