        public string BaseUrl { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public string TimeoutSeconds { get; set; } = "";
        public string MaxWaitSeconds { get; set; } = "";
        public string PollIntervalMs { get; set; } = "";
        public ImageWorkflowMode WorkflowMode { get; set; } = ImageWorkflowMode.Default;
        public string Model { get; set; } = "";
        public string Width { get; set; } = "";
        public string Height { get; set; } = "";
        public string Steps { get; set; } = "";
        public string Cfg { get; set; } = "";
        public string Sampler { get; set; } = "";
        public string Scheduler { get; set; } = "";
        public string NegativePrompt { get; set; } = "";
        public string BatchSize { get; set; } = "";
        public string CustomWorkflowJson { get; set; } = "";
        public List<ParameterEditor> Parameters { get; set; } = [];

        public ProfileEditor Clone() => new()
        {
            Id = Id,
            Name = Name,
            Description = Description,
            Enabled = Enabled,
            Provider = Provider,
            BaseUrl = BaseUrl,
            ApiKey = ApiKey,
            TimeoutSeconds = TimeoutSeconds,
            MaxWaitSeconds = MaxWaitSeconds,
            PollIntervalMs = PollIntervalMs,
            WorkflowMode = WorkflowMode,
            Model = Model,
            Width = Width,
            Height = Height,
            Steps = Steps,
            Cfg = Cfg,
            Sampler = Sampler,
            Scheduler = Scheduler,
            NegativePrompt = NegativePrompt,
            BatchSize = BatchSize,
            CustomWorkflowJson = CustomWorkflowJson,
