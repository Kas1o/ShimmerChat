@attribute [PluginPanelAttribute("panel.image_generation", "panel.image_generation.desc", PanelDisplayPlace.Settings, Order = 5)]

@using System.Globalization
@using Microsoft.Extensions.Logging
@using ShimmerChatBuiltin.ImageGeneration
@using ShimmerChatLib.Components
@using System.Text.Json
@inject IKVDataService KVData
@inject ILocService Loc
@inject ILogger<ImageGenerationPanel> Logger

<ConfigShell T="ProfileEditor"
            Items="_profiles"
            SelectedId="@_selectedId"
            IdSelector="@(p => p.Id)"
            NameSelector="@(p => p.Name)"
            TypeSelector="@(p => Loc[ImageApiProviderCatalog.Get(p.Provider).NameKey])"
            MetaSelector="@(p => p.BaseUrl)"
            SearchSelector="@(p => $"{p.Description} {p.BaseUrl} {p.Model} {p.Id}")"
            PinSelector="@(p => p.Pinned)"
            Title="@Loc["panel_imagegen.title"]"
            Description="@Loc["panel_imagegen.desc"]"
            Icon="bi-image"
            IsDirty="IsDirty"
            LoadError="@_loadError"
            StatusMessage="@_statusText"
            StatusKind="@_statusKind"
            OnCreate="AddProfile"
            OnSave="SaveConfig"
            OnSelect="SelectProfileById"
            OnClone="DuplicateProfile"
            OnRename="RenameProfile"
            OnDelete="ConfirmDelete"
            OnTogglePin="TogglePin"
            OnRetry="Reload">
    <ToolbarExtras>
        <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn"
                @onclick="ResetToDefaults" title="@Loc["panel_imagegen.reset"]"
                aria-label="@Loc["panel_imagegen.reset"]">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
    </ToolbarExtras>
    <Body>
        @if (Current is { } profile)
        {
            var descriptor = ImageApiProviderCatalog.Get(profile.Provider);
            var isComfy = profile.Provider == ImageApiProvider.ComfyUi;
            // 自定义工作流完全由 JSON 模板与占位符参数驱动，「生成参数」组在该模式下不参与生成，
            // 因此两个分组互斥显示，避免用户误以为生成参数会影响自定义工作流。
            var useCustomWorkflow = isComfy && profile.WorkflowMode == ImageWorkflowMode.Custom;

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["imagegen_config.basic"]</h3>
                        <p>@Loc["imagegen_config.basic_desc"]</p>
                    </div>
                    <label class="cfg-toggle">
                        <input type="checkbox" @bind="profile.Enabled" />
                        <span>@Loc["panel_imagegen.enabled"]</span>
                    </label>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-5">
                        <label class="su-label">@Loc["panel_imagegen.name"]</label>
                        <input class="su-input" @bind="profile.Name" />
                        <p class="cfg-field-hint">@Loc["imagegen_config.name_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["panel_imagegen.id"]</label>
                        <div class="cfg-readonly-row">
                            <code title="@profile.Id">@profile.Id</code>
                        </div>
                        <p class="cfg-field-hint">@Loc["panel_imagegen.id_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_imagegen.provider"]</label>
                        <select class="su-select" value="@profile.Provider"
                                @onchange="e => SetProvider(profile, Enum.Parse<ImageApiProvider>(e.Value?.ToString() ?? nameof(ImageApiProvider.ComfyUi)))">
                            @foreach (var provider in ImageApiProviderCatalog.All)
                            {
                                <option value="@provider.Kind">@Loc[provider.NameKey]</option>
                            }
                        </select>
                        <p class="cfg-field-hint">@Loc[descriptor.DescriptionKey]</p>
                    </div>
                    <div class="cfg-field cfg-span-12">
                        <label class="su-label">@Loc["panel_imagegen.description"]</label>
                        <input class="su-input" @bind="profile.Description"
                               placeholder="@Loc["panel_imagegen.description_placeholder"]" />
                        <p class="cfg-field-hint">@Loc["panel_imagegen.description_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-12">
                        <label class="cfg-field-hint">
                            @Loc["imagegen_config.tool_name"]:
                            <code>@ImageGenerationConfigManager.GetToolName(profile.Id)</code>
                        </label>
                    </div>
                </div>
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-plug"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_imagegen.section_connection"]</h3>
                        <p>@Loc["imagegen_config.connection_desc"]</p>
                    </div>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-8">
                        <label class="su-label">@Loc["panel_imagegen.base_url"]</label>
                        <input class="su-input" @bind="profile.BaseUrl" placeholder="@descriptor.DefaultBaseUrl" />
                        <p class="cfg-field-hint">
                            @(isComfy
                                ? Loc["panel_imagegen.base_url_hint_comfy"]
                                : Loc["panel_imagegen.base_url_hint_a1111"])
                        </p>
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_imagegen.api_key"]</label>
                        <input type="password" class="su-input" autocomplete="off" @bind="profile.ApiKey" />
                        <p class="cfg-field-hint">@Loc["panel_imagegen.api_key_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_imagegen.timeout"]</label>
                        <input class="su-input" inputmode="numeric" @bind="profile.TimeoutSeconds" />
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_imagegen.max_wait"]</label>
                        <input class="su-input" inputmode="numeric" @bind="profile.MaxWaitSeconds" />
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_imagegen.poll_interval"]</label>
                        <input class="su-input" inputmode="numeric" @bind="profile.PollIntervalMs"
                               disabled="@(!isComfy)" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_probeMessage))
                {
                    <div class="cfg-note @(_probeFailed ? "is-danger" : "is-success")">
                        <i class="bi @(_probeFailed ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill")"></i>
                        <span>@_probeMessage</span>
                    </div>
                }
            </section>

            @if (isComfy)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-diagram-3"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["panel_imagegen.section_workflow"]</h3>
                            <p>@Loc["imagegen_config.workflow_desc"]</p>
                        </div>
                    </div>

                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["panel_imagegen.workflow_mode"]</label>
                            <select class="su-select" value="@profile.WorkflowMode"
                                    @onchange="e => SetWorkflowMode(profile, Enum.Parse<ImageWorkflowMode>(e.Value?.ToString() ?? nameof(ImageWorkflowMode.Default)))">
                                <option value="@ImageWorkflowMode.Default">@Loc["panel_imagegen.workflow_mode_default"]</option>
                                <option value="@ImageWorkflowMode.Custom">@Loc["panel_imagegen.workflow_mode_custom"]</option>
                            </select>
                            <p class="cfg-field-hint">
                                @(profile.WorkflowMode == ImageWorkflowMode.Custom
                                    ? Loc["panel_imagegen.workflow_mode_custom_desc"]
                                    : Loc["panel_imagegen.workflow_mode_default_desc"])
                            </p>
                        </div>
                    </div>
                </section>

                @if (useCustomWorkflow)
                {
                    <section class="cfg-section">
                        <div class="cfg-section-head">
                            <span class="cfg-section-icon"><i class="bi bi-braces"></i></span>
                            <div class="cfg-section-title">
                                <h3>@Loc["panel_imagegen.section_custom_workflow"]</h3>
                                <p>@Loc["imagegen_config.custom_workflow_desc"]</p>
                            </div>
                        </div>

                        <div class="cfg-grid">
                            <div class="cfg-field cfg-span-12">
                                <label class="su-label">@Loc["panel_imagegen.workflow_json"]</label>
                                <textarea class="su-input cfg-textarea" rows="10" @bind="profile.CustomWorkflowJson"></textarea>
                                <p class="cfg-field-hint">@Loc["panel_imagegen.workflow_json_hint"]</p>
                            </div>
                        </div>

                        <div class="cfg-section-subhead">
                            <strong>@Loc["panel_imagegen.workflow_parameters"]</strong>
                            <button type="button" class="su-btn su-btn-secondary su-btn-sm"
                                    @onclick="() => AddParameter(profile)">
                                <i class="bi bi-plus-lg"></i> @Loc["panel_imagegen.add_parameter"]
                            </button>
                        </div>

                        @if (profile.Parameters.Count == 0)
                        {
                            <p class="su-text-sm su-text-2">@Loc["panel_imagegen.no_parameters"]</p>
                        }
                        else
                        {
                            <div class="cfg-term-list">
                                @foreach (var parameter in profile.Parameters)
                                {
                                    <div class="cfg-term-card" @key="parameter">
                                        <div class="cfg-term-main">
                                            <div class="cfg-grid">
                                                <div class="cfg-field cfg-span-4">
                                                    <label class="su-label">@Loc["panel_imagegen.param_name"]</label>
                                                    <input class="su-input" @bind="parameter.Name" />
                                                </div>
                                                <div class="cfg-field cfg-span-4">
                                                    <label class="su-label">@Loc["imagegen_config.param_type"]</label>
                                                    <select class="su-select" @bind="parameter.Type"
                                                            @bind:after="() => NormalizeParameter(parameter)">
                                                        @foreach (var type in Enum.GetValues<ImageWorkflowParameterType>())
                                                        {
                                                            <option value="@type">@TypeLabel(type)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="cfg-field cfg-span-4">
                                                    <label class="cfg-toggle">
                                                        <input type="checkbox" @bind="parameter.Required" />
                                                        <span>@Loc["panel_imagegen.param_required"]</span>
                                                    </label>
                                                </div>
                                                <div class="cfg-field cfg-span-6">
                                                    <label class="su-label">@Loc["panel_imagegen.param_description"]</label>
                                                    <input class="su-input" @bind="parameter.Description" />
                                                </div>
                                                <div class="cfg-field cfg-span-3">
                                                    <label class="su-label">@Loc["panel_imagegen.param_default"]</label>
                                                    <input class="su-input" @bind="parameter.DefaultValue"
                                                           disabled="@parameter.Required" />
                                                </div>
                                                <div class="cfg-field cfg-span-3">
                                                    <label class="su-label">@Loc["panel_imagegen.param_enum_values"]</label>
                                                    <input class="su-input" @bind="parameter.EnumValuesText"
                                                           disabled="@(parameter.Type != ImageWorkflowParameterType.Enum)" />
                                                </div>
                                                <div class="cfg-field cfg-span-3">
                                                    <label class="su-label">@Loc["panel_imagegen.param_min"]</label>
                                                    <input class="su-input" @bind="parameter.MinText"
                                                           disabled="@(parameter.Type is not (ImageWorkflowParameterType.Integer or ImageWorkflowParameterType.Number))" />
                                                </div>
                                                <div class="cfg-field cfg-span-3">
                                                    <label class="su-label">@Loc["panel_imagegen.param_max"]</label>
                                                    <input class="su-input" @bind="parameter.MaxText"
                                                           disabled="@(parameter.Type is not (ImageWorkflowParameterType.Integer or ImageWorkflowParameterType.Number))" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="cfg-term-actions">
                                            <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn is-danger"
                                                    title="@Loc["panel_imagegen.delete"]" aria-label="@Loc["panel_imagegen.delete"]"
                                                    @onclick="() => RemoveParameter(profile, parameter)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <p class="cfg-note">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@Loc["panel_imagegen.template_help"]</span>
                        </p>
                    </section>
                }
            }
            else
            {
                <div class="cfg-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>@Loc["panel_imagegen.workflow_not_supported"]</span>
                </div>
            }

            @if (!useCustomWorkflow)
            {
                <section class="cfg-section">
                    <div class="cfg-section-head">
                        <span class="cfg-section-icon"><i class="bi bi-sliders2"></i></span>
                        <div class="cfg-section-title">
                            <h3>@Loc["panel_imagegen.section_generation"]</h3>
                            <p>@Loc["panel_imagegen.generation_desc"]</p>
                        </div>
                    </div>

                    <div class="cfg-grid">
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["panel_imagegen.model"]</label>
                            <div class="cfg-input-row">
                                <input class="su-input" list="imagegen-model-options" @bind="profile.Model" />
                                <button type="button" class="su-btn su-btn-outline su-btn-sm"
                                        disabled="@_probing" @onclick="ProbeAsync"
                                        title="@Loc["panel_imagegen.probe"]" aria-label="@Loc["panel_imagegen.probe"]">
                                    <i class="bi @(_probing ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                                    <span class="cfg-btn-label">@(_probing ? Loc["panel_imagegen.probing"] : Loc["panel_imagegen.probe"])</span>
                                </button>
                            </div>
                            <datalist id="imagegen-model-options">
                                @foreach (var model in _availableModels)
                                {
                                    <option value="@model"></option>
                                }
                            </datalist>
                            <p class="cfg-field-hint">
                                @(isComfy
                                    ? Loc["panel_imagegen.model_hint_comfy"]
                                    : Loc["panel_imagegen.model_hint_a1111"])
                            </p>
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.sampler"]</label>
                            <input class="su-input" list="imagegen-sampler-options" @bind="profile.Sampler" />
                            <datalist id="imagegen-sampler-options">
                                @foreach (var sampler in _availableSamplers)
                                {
                                    <option value="@sampler"></option>
                                }
                            </datalist>
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.scheduler"]</label>
                            <input class="su-input" list="imagegen-scheduler-options" @bind="profile.Scheduler"
                                   disabled="@(!isComfy)" />
                            <datalist id="imagegen-scheduler-options">
                                @foreach (var scheduler in _availableSchedulers)
                                {
                                    <option value="@scheduler"></option>
                                }
                            </datalist>
                        </div>

                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.width"]</label>
                            <input class="su-input" inputmode="numeric" @bind="profile.Width" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.height"]</label>
                            <input class="su-input" inputmode="numeric" @bind="profile.Height" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.batch_size"]</label>
                            <input class="su-input" inputmode="numeric" @bind="profile.BatchSize" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.steps"]</label>
                            <input class="su-input" inputmode="numeric" @bind="profile.Steps" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_imagegen.cfg"]</label>
                            <input class="su-input" inputmode="decimal" @bind="profile.Cfg" />
                        </div>
                        <div class="cfg-field cfg-span-12">
                            <label class="su-label">@Loc["panel_imagegen.negative_prompt"]</label>
                            <textarea class="su-input" rows="2" @bind="profile.NegativePrompt"></textarea>
                            <p class="cfg-field-hint">@Loc["panel_imagegen.negative_prompt_hint"]</p>
                        </div>
                    </div>
                </section>
            }
        }
    </Body>

    <EmptyState>
        <div class="cfg-empty">
            <span class="cfg-empty-icon"><i class="bi bi-image"></i></span>
            <h2>@Loc["imagegen_config.empty_title"]</h2>
            <p>@Loc["imagegen_config.empty_desc"]</p>
            <button type="button" class="su-btn su-btn-primary" @onclick="AddProfile">
                <i class="bi bi-plus-lg"></i> @Loc["panel_imagegen.add_configuration"]
            </button>
        </div>
    </EmptyState>
</ConfigShell>

@code {
    private List<ProfileEditor> _profiles = [];
    private string? _selectedId;
    private string? _loadError;
    private string? _savedSnapshot;

    private List<string> _availableModels = [];
    private List<string> _availableSamplers = [];
    private List<string> _availableSchedulers = [];

    private string _statusText = string.Empty;
    private string _statusKind = "info";
    private string _probeMessage = string.Empty;
    private bool _probeFailed;
    private bool _probing;

    private static readonly JsonSerializerOptions _snapshotOptions = new() { WriteIndented = false };

    private ProfileEditor? Current =>
        _profiles.FirstOrDefault(p => string.Equals(p.Id, _selectedId, StringComparison.Ordinal));

    private bool IsDirty => _loadError == null && Snapshot() != _savedSnapshot;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        var (config, error) = ImageGenerationConfigManager.Load(KVData);
        if (config == null)
        {
            Logger.LogError("加载文生图配置失败：{Error}", error);
            _profiles = [];
            _selectedId = null;
            _savedSnapshot = null;
            _loadError = Loc.Format("panel_imagegen.msg_load_failed", error ?? "unknown error");
            return;
        }

        ApplyToForm(config);
        _loadError = null;
    }

    private void ApplyToForm(ImageGenerationConfig config)
    {
        _profiles = config.Profiles.Select(ToEditor).ToList();
        _selectedId = _profiles.FirstOrDefault()?.Id;
        ClearProbe();
        _savedSnapshot = Snapshot();
    }

    private string Snapshot() => JsonSerializer.Serialize(_profiles, _snapshotOptions);

    private static ProfileEditor ToEditor(ImageGenerationProfile profile) => new()
    {
        Id = profile.Id,
        Name = profile.Name,
        Description = profile.Description,
        Enabled = profile.Enabled,
        Provider = profile.Provider,
        BaseUrl = profile.BaseUrl,
        ApiKey = profile.ApiKey,
        TimeoutSeconds = profile.TimeoutSeconds.ToString(CultureInfo.InvariantCulture),
        MaxWaitSeconds = profile.MaxWaitSeconds.ToString(CultureInfo.InvariantCulture),
        PollIntervalMs = profile.PollIntervalMilliseconds.ToString(CultureInfo.InvariantCulture),
        WorkflowMode = profile.WorkflowMode,
        Model = profile.DefaultWorkflow.Model,
        Width = profile.DefaultWorkflow.Width.ToString(CultureInfo.InvariantCulture),
        Height = profile.DefaultWorkflow.Height.ToString(CultureInfo.InvariantCulture),
        Steps = profile.DefaultWorkflow.Steps.ToString(CultureInfo.InvariantCulture),
        Cfg = profile.DefaultWorkflow.CfgScale.ToString("R", CultureInfo.InvariantCulture),
        Sampler = profile.DefaultWorkflow.Sampler,
        Scheduler = profile.DefaultWorkflow.Scheduler,
        NegativePrompt = profile.DefaultWorkflow.NegativePrompt,
        BatchSize = profile.DefaultWorkflow.BatchSize.ToString(CultureInfo.InvariantCulture),
        CustomWorkflowJson = profile.CustomWorkflowJson,
        Parameters = profile.CustomWorkflowParameters.Select(ToEditor).ToList(),
        Pinned = profile.Pinned
    };

    private static ParameterEditor ToEditor(ImageWorkflowParameter parameter) => new()
    {
        Name = parameter.Name,
        Type = parameter.Type,
        Description = parameter.Description,
        Required = parameter.Required,
        DefaultValue = parameter.DefaultValue,
        EnumValuesText = string.Join(", ", parameter.EnumValues),
        MinText = parameter.Min?.ToString("R", CultureInfo.InvariantCulture) ?? "",
        MaxText = parameter.Max?.ToString("R", CultureInfo.InvariantCulture) ?? ""
    };

    private ImageGenerationConfig? BuildConfig(out string? error)
    {
        error = null;
        var profiles = new List<ImageGenerationProfile>(_profiles.Count);

        foreach (var editor in _profiles)
        {
            var label = EditorLabel(editor);

            if (!TryParseInt(editor.TimeoutSeconds, out var timeout))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.timeout"]);
                return null;
            }

            if (!TryParseInt(editor.MaxWaitSeconds, out var maxWait))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.max_wait"]);
                return null;
            }

            if (!TryParseInt(editor.PollIntervalMs, out var pollInterval))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.poll_interval"]);
                return null;
            }

            if (!TryParseInt(editor.Width, out var width))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.width"]);
                return null;
            }

            if (!TryParseInt(editor.Height, out var height))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.height"]);
                return null;
            }

            if (!TryParseInt(editor.Steps, out var steps))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.steps"]);
                return null;
            }

            if (!TryParseDouble(editor.Cfg, out var cfg))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_number_profile", label, Loc["panel_imagegen.cfg"]);
                return null;
            }

            if (!TryParseInt(editor.BatchSize, out var batchSize))
            {
                error = Loc.Format("panel_imagegen.msg_invalid_int_profile", label, Loc["panel_imagegen.batch_size"]);
                return null;
            }

            var parameters = new List<ImageWorkflowParameter>(editor.Parameters.Count);
            foreach (var parameterEditor in editor.Parameters)
            {
                double? min = null;
                if (!string.IsNullOrWhiteSpace(parameterEditor.MinText))
                {
                    if (!TryParseDouble(parameterEditor.MinText, out var parsedMin))
                    {
                        error = Loc.Format("panel_imagegen.msg_invalid_param_number",
                            label, parameterEditor.Name, Loc["panel_imagegen.param_min"]);
                        return null;
                    }

                    min = parsedMin;
                }

                double? max = null;
                if (!string.IsNullOrWhiteSpace(parameterEditor.MaxText))
                {
                    if (!TryParseDouble(parameterEditor.MaxText, out var parsedMax))
                    {
                        error = Loc.Format("panel_imagegen.msg_invalid_param_number",
                            label, parameterEditor.Name, Loc["panel_imagegen.param_max"]);
                        return null;
                    }

                    max = parsedMax;
                }

                var enumValues = parameterEditor.EnumValuesText
                    .Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
                    .Select(v => v.Trim())
                    .Where(v => v.Length > 0)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                parameters.Add(new ImageWorkflowParameter
                {
                    Name = parameterEditor.Name?.Trim() ?? "",
                    Type = parameterEditor.Type,
                    Description = parameterEditor.Description ?? "",
                    Required = parameterEditor.Required,
                    DefaultValue = parameterEditor.DefaultValue ?? "",
                    EnumValues = enumValues,
                    Min = min,
                    Max = max
                });
            }

            profiles.Add(new ImageGenerationProfile
            {
                Id = editor.Id?.Trim() ?? "",
                Name = editor.Name?.Trim() ?? "",
                Description = editor.Description ?? "",
                Enabled = editor.Enabled,
                Provider = editor.Provider,
                BaseUrl = editor.BaseUrl?.Trim() ?? "",
                ApiKey = editor.ApiKey ?? "",
                TimeoutSeconds = timeout,
                MaxWaitSeconds = maxWait,
                PollIntervalMilliseconds = pollInterval,
                WorkflowMode = editor.Provider == ImageApiProvider.ComfyUi
                    ? editor.WorkflowMode
                    : ImageWorkflowMode.Default,
                DefaultWorkflow = new DefaultImageWorkflowSettings
                {
                    Model = editor.Model?.Trim() ?? "",
                    Width = width,
                    Height = height,
                    Steps = steps,
                    CfgScale = cfg,
                    Sampler = editor.Sampler?.Trim() ?? "",
                    Scheduler = editor.Scheduler?.Trim() ?? "",
                    NegativePrompt = editor.NegativePrompt ?? "",
                    BatchSize = batchSize
                },
                CustomWorkflowJson = editor.CustomWorkflowJson ?? "",
                CustomWorkflowParameters = parameters,
                Pinned = editor.Pinned
            });
        }

        var config = new ImageGenerationConfig
        {
            Version = ImageGenerationConfigManager.CurrentVersion,
            Profiles = profiles
        };

        var validationError = ImageGenerationConfigManager.Validate(config);
        if (validationError != null)
        {
            error = Loc.Format("panel_imagegen.msg_invalid_config", validationError);
            return null;
        }

        return config;
    }

    private async Task SaveConfig()
    {
        if (_loadError != null) return;

        var config = BuildConfig(out var error);
        if (config == null)
        {
            SetStatus(error ?? Loc["panel_imagegen.msg_invalid_config"], "error");
            return;
        }

        try
        {
            ImageGenerationConfigManager.Save(KVData, config);
            _savedSnapshot = Snapshot();
            SetStatus(Loc["panel_imagegen.msg_saved"], "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "保存文生图配置失败");
            SetStatus(Loc.Format("panel_imagegen.msg_save_failed", ex.Message), "error");
        }

        await Task.CompletedTask;
    }

    private async Task ResetToDefaults()
    {
        ApplyToForm(ImageGenerationConfig.CreateDefault());
        SetStatus(Loc["imagegen_config.reset_draft"], "info");
        await Task.CompletedTask;
    }

    private async Task AddProfile()
    {
        var profile = new ProfileEditor
        {
            Id = NextId(),
            Name = NextName(Loc["panel_imagegen.new_configuration"]),
            Provider = ImageApiProvider.ComfyUi,
            BaseUrl = ImageApiProviderCatalog.Get(ImageApiProvider.ComfyUi).DefaultBaseUrl,
            TimeoutSeconds = "30",
            MaxWaitSeconds = "300",
            PollIntervalMs = "1000",
            WorkflowMode = ImageWorkflowMode.Default,
            Width = "512",
            Height = "512",
            Steps = "20",
            Cfg = "7",
            Sampler = "euler",
            Scheduler = "normal",
            BatchSize = "1"
        };

        _profiles.Add(profile);
        _selectedId = profile.Id;
        ClearProbe();
        SetStatus(Loc.Format("config_ui.created", profile.Name), "info");
        await Task.CompletedTask;
    }

    private async Task DuplicateProfile()
    {
        if (Current is not { } source) return;

        var copy = source.Clone();
        copy.Id = NextId();
        copy.Name = NextName($"{DisplayName(source)} {Loc["panel_imagegen.copy_suffix"]}");
        copy.Pinned = source.Pinned;

        var index = _profiles.IndexOf(source);
        _profiles.Insert(index + 1, copy);
        _selectedId = copy.Id;
        ClearProbe();
        SetStatus(Loc.Format("config_ui.cloned", copy.Name), "info");
        await Task.CompletedTask;
    }

    private async Task RenameProfile(string name)
    {
        if (Current is not { } profile) return;
        profile.Name = name;
        SetStatus(Loc.Format("config_ui.renamed", profile.Name), "info");
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        if (Current is not { } profile) return;

        var index = _profiles.IndexOf(profile);
        _profiles.Remove(profile);
        _selectedId = _profiles.Count == 0
            ? null
            : _profiles[Math.Clamp(index, 0, _profiles.Count - 1)].Id;
        ClearProbe();
        SetStatus(Loc.Format("config_ui.deleted_pending", DisplayName(profile)), "info");
        await Task.CompletedTask;
    }

    private async Task TogglePin(ProfileEditor profile)
    {
        profile.Pinned = !profile.Pinned;
        SetStatus(Loc.Format(profile.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(profile)), "info");
        await Task.CompletedTask;
    }

    private async Task SelectProfileById(string id)
    {
        _selectedId = id;
        ClearProbe();
        await Task.CompletedTask;
    }

    private void SetProvider(ProfileEditor profile, ImageApiProvider provider)
    {
        if (profile.Provider == provider) return;

        var previousDefault = ImageApiProviderCatalog.Get(profile.Provider).DefaultBaseUrl;
        if (string.IsNullOrWhiteSpace(profile.BaseUrl)
            || string.Equals(profile.BaseUrl.Trim().TrimEnd('/'),
                previousDefault.TrimEnd('/'), StringComparison.OrdinalIgnoreCase))
        {
            profile.BaseUrl = ImageApiProviderCatalog.Get(provider).DefaultBaseUrl;
        }

        profile.Provider = provider;

        if (provider == ImageApiProvider.Automatic1111)
        {
            profile.WorkflowMode = ImageWorkflowMode.Default;
            profile.Scheduler = "";

            if (string.Equals(profile.Sampler, "euler", StringComparison.OrdinalIgnoreCase))
                profile.Sampler = "Euler a";
            else if (string.Equals(profile.Sampler, "euler_ancestral", StringComparison.OrdinalIgnoreCase))
                profile.Sampler = "Euler a";
        }
        else
        {
            if (string.Equals(profile.Sampler, "Euler a", StringComparison.OrdinalIgnoreCase))
                profile.Sampler = "euler";

            if (string.IsNullOrWhiteSpace(profile.Scheduler))
                profile.Scheduler = "normal";
        }

        ClearProbe();
    }

    private static void SetWorkflowMode(ProfileEditor profile, ImageWorkflowMode mode)
    {
        profile.WorkflowMode = mode;
    }

    private void AddParameter(ProfileEditor profile)
    {
        profile.Parameters.Add(new ParameterEditor
        {
            Name = profile.Parameters.Count == 0 ? "prompt" : $"param{profile.Parameters.Count + 1}",
            Type = ImageWorkflowParameterType.String,
            Required = profile.Parameters.Count == 0
        });
    }

    private void RemoveParameter(ProfileEditor profile, ParameterEditor parameter)
    {
        profile.Parameters.Remove(parameter);
    }

    private static void NormalizeParameter(ParameterEditor parameter)
    {
        if (parameter.Type != ImageWorkflowParameterType.Enum)
            parameter.EnumValuesText = "";

        if (parameter.Type is not (ImageWorkflowParameterType.Integer or ImageWorkflowParameterType.Number))
        {
            parameter.MinText = "";
            parameter.MaxText = "";
        }

        if (parameter.Required)
            parameter.DefaultValue = "";
    }

    private async Task ProbeAsync()
    {
        if (Current is not { } profile) return;

        var baseUrl = profile.BaseUrl?.Trim() ?? "";
        if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _probeFailed = true;
            _probeMessage = Loc["panel_imagegen.msg_invalid_base_url"];
            return;
        }

        if (!TryParseInt(profile.TimeoutSeconds, out var timeout) || timeout <= 0)
        {
            _probeFailed = true;
            _probeMessage = Loc.Format("panel_imagegen.msg_invalid_int", Loc["panel_imagegen.timeout"]);
            return;
        }

        _probing = true;
        _probeFailed = false;
        _probeMessage = Loc["panel_imagegen.msg_probing"];
        StateHasChanged();

        try
        {
            var timeoutSpan = TimeSpan.FromSeconds(timeout);
            IReadOnlyList<string>? models;
            IReadOnlyList<string>? samplers;
            IReadOnlyList<string>? schedulers = null;
            string? modelsError;
            string? samplersError;
            string? schedulersError = null;

            if (profile.Provider == ImageApiProvider.ComfyUi)
            {
                var modelsTask = ComfyUiProbe.FetchCheckpointModelsAsync(baseUrl, profile.ApiKey, timeoutSpan);
                var samplersTask = ComfyUiProbe.FetchSamplerOptionsAsync(baseUrl, profile.ApiKey, timeoutSpan);

                await Task.WhenAll(modelsTask, samplersTask);

                (models, modelsError) = await modelsTask;
                var (samplerOptions, samplerError) = await samplersTask;
                samplers = samplerOptions?.Samplers;
                schedulers = samplerOptions?.Schedulers;
                samplersError = samplerError;
                schedulersError = samplerError;
            }
            else
            {
                var modelsTask = A1111Probe.FetchCheckpointModelsAsync(baseUrl, profile.ApiKey, timeoutSpan);
                var samplersTask = A1111Probe.FetchSamplersAsync(baseUrl, profile.ApiKey, timeoutSpan);

                await Task.WhenAll(modelsTask, samplersTask);

                (models, modelsError) = await modelsTask;
                (samplers, samplersError) = await samplersTask;
            }

            if (!ReferenceEquals(Current, profile)) return;

            if (models == null)
            {
                _probeFailed = true;
                _probeMessage = Loc.Format("panel_imagegen.msg_probe_failed", modelsError);
                return;
            }

            _availableModels = [.. models];

            if (samplers == null || schedulersError != null)
            {
                _availableSamplers = [];
                _availableSchedulers = [];
                _probeFailed = true;
                _probeMessage = Loc.Format("panel_imagegen.msg_probe_partial", samplersError);
            }
            else
            {
                _availableSamplers = [.. samplers];
                _availableSchedulers = schedulers == null ? [] : [.. schedulers];
                _probeMessage = Loc.Format(
                    "panel_imagegen.msg_probe_loaded",
                    _availableModels.Count,
                    _availableSamplers.Count,
                    _availableSchedulers.Count);
            }

            if (string.IsNullOrWhiteSpace(profile.Model) && _availableModels.Count > 0)
                profile.Model = _availableModels[0];

            if (profile.Provider == ImageApiProvider.Automatic1111
                && profile.WorkflowMode != ImageWorkflowMode.Default)
            {
                profile.WorkflowMode = ImageWorkflowMode.Default;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "探测文生图服务 {BaseUrl} 失败", baseUrl);
            _probeFailed = true;
            _probeMessage = Loc.Format("panel_imagegen.msg_probe_failed", ex.Message);
        }
        finally
        {
            _probing = false;
        }
    }

    private void ClearProbe()
    {
        _availableModels = [];
        _availableSamplers = [];
        _availableSchedulers = [];
        _probeMessage = "";
        _probeFailed = false;
    }

    private string DisplayName(ProfileEditor profile) =>
        string.IsNullOrWhiteSpace(profile.Name) ? profile.Id : profile.Name;

    private static string EditorLabel(ProfileEditor profile) =>
        string.IsNullOrWhiteSpace(profile.Name) ? profile.Id : profile.Name;

    private string TypeLabel(ImageWorkflowParameterType type) =>
        Loc[$"panel_imagegen.param_type_{type.ToString().ToLowerInvariant()}"];

    private string NextId()
    {
        string id;
        do
        {
            id = "config_" + Guid.NewGuid().ToString("N")[..8];
        }
        while (_profiles.Any(p => string.Equals(p.Id, id, StringComparison.Ordinal)));

        return id;
    }

    private string NextName(string baseName)
    {
        var name = baseName;
        var suffix = 2;
        while (_profiles.Any(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            name = $"{baseName} {suffix++}";
        }

        return name;
    }

    private void SetStatus(string message, string kind)
    {
        _statusText = message;
        _statusKind = kind;
    }

    private static bool TryParseInt(string? text, out int value) =>
        int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);

    private static bool TryParseDouble(string? text, out double value) =>
        double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value)
        && double.IsFinite(value);

