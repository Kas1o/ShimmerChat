@using System.Text
@using ShimmerChatBuiltin.Mcp
@using ShimmerChatLib.Interface
@using ShimmerChatLib.Panel
@using ShimmerChatLib.Generation
@using ModelContextProtocol.Protocol
@using Microsoft.Extensions.Logging
@inject IKVDataService KVData
@inject ILocService Loc
@inject IPanelDraftStore DraftStore
@inject ILoggerFactory LoggerFactory
@implements IAsyncDisposable

@attribute [PluginPanelAttribute("panel.mcp_chat", "panel.mcp_chat.desc", PanelDisplayPlace.Chat, Order = 30)]

@* 组件由 DynamicComponent 渲染，作用域 CSS（.razor.css）不会生效，样式内联在此。 *@
<style>
    .mcp-status-ok { color: #3fb950; }
    .mcp-status-fail { color: #d29922; }
    .mcp-panel-error { color: #f85149; }
    .mcp-panel-error .su-text-2 { opacity: .8; }
    .mcp-preview {
        margin: 0;
        padding: 6px;
        max-height: 220px;
        overflow: auto;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: .78rem;
        border-radius: 4px;
        background: rgba(127, 127, 127, .12);
    }
    .mcp-prompt { background: rgba(127, 127, 127, .07); }
</style>

<div class="mcp-chat-panel">
    <div class="su-flex su-items-center su-gap-2 su-mb-2 su-flex-wrap">
        <button class="su-btn su-btn-sm" @onclick="StartReload" disabled="@loading">
            <span class="bi bi-arrow-clockwise"></span> @Loc["panel_mcp_chat.reload"]
        </button>
        @if (loading)
        {
            <span class="su-text-sm su-text-2">@Loc["panel_mcp_chat.loading"]</span>
        }
        else
        {
            <span class="su-text-sm su-text-2">@Loc.Format("panel_mcp_chat.connected", ConnectedCount, endpoints.Count)</span>
        }
        <label class="su-flex su-items-center su-gap-1 su-text-sm">
            <input type="checkbox" class="su-check" checked="@autoReload"
                   @onchange="OnAutoReloadChanged" />
            @Loc["panel_mcp_chat.auto_reload"]
        </label>
    </div>

    @* 连接失败与其它问题只在面板内提示，不弹窗。 *@
    @foreach (var failure in _failureSnapshot)
    {
        <div class="su-mb-2 su-px-3 su-py-2 su-rounded su-text-sm mcp-panel-error">
            <div>
                <span class="bi bi-exclamation-triangle"></span>
                <strong>@failure.Endpoint.Name</strong>
                <span class="su-text-2">(@McpEndpointSession.Describe(failure.Endpoint))</span>
            </div>
            <div>@failure.Message</div>
        </div>
    }

    @if (!loading && endpoints.Count == 0)
    {
        <div class="su-text-sm su-text-2 su-mb-2">@Loc["panel_mcp_chat.no_endpoints"]</div>
    }

    @* ── 本面板自己的输入区：不经过主输入框 ── *@
    <div class="mcp-draft su-mb-3">
        <div class="su-text-sm su-font-bold su-mb-1">@Loc["panel_mcp_chat.draft_title"]</div>
        <textarea class="shimmer-textarea su-w-full" rows="4"
                  placeholder="@Loc["panel_mcp_chat.draft_placeholder"]"
                  value="@EffectiveDraft"
                  @oninput="OnDraftInput"></textarea>
        <div class="su-flex su-gap-2 su-mt-1 su-items-center">
            <button class="su-btn su-btn-sm su-btn-primary" @onclick="SendDraftAsync"
                    disabled="@(string.IsNullOrWhiteSpace(EffectiveDraft) || IsGenerating)">
                <span class="bi bi-send"></span> @Loc["panel_mcp_chat.send"]
            </button>
            <button class="su-btn su-btn-sm" @onclick="ClearDraft">
                <span class="bi bi-x"></span> @Loc["panel_mcp_chat.clear"]
            </button>
            @if (IsGenerating)
            {
                <span class="su-text-sm su-text-2">@Loc["panel_mcp_chat.generating"]</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(panelMessage))
        {
            <div class="su-text-sm su-mt-1">@panelMessage</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(insertedText))
    {
        <div class="su-mb-3 su-px-2 su-py-2 su-rounded su-text-sm" style="background:rgba(127,127,127,.12)">
            <div class="su-flex su-items-center su-gap-2">
                <span class="bi bi-clipboard-plus"></span>
                <span class="su-flex-1">@Loc.Format("panel_mcp_chat.inserted_from", insertedTextSource)</span>
                <button class="su-btn su-btn-sm su-btn-outline" @onclick="InsertPreviewIntoDraft">
                    @Loc["panel_mcp_chat.insert_to_draft"]
                </button>
                <button class="su-btn su-btn-sm" @onclick="ClearInsertedPreview">
                    <span class="bi bi-x"></span>
                </button>
            </div>
        </div>
    }

    @foreach (var state in _stateSnapshot)
    {
        var s = state;
        @* open 是静态属性：折叠状态完全交给浏览器管理。
           若绑定到 @s.Open 并在 ontoggle 里取反，重渲染会把属性写回相反值，
           再次触发 ontoggle，形成振荡——这就是面板闪烁的原因。 *@
        <details class="plugin-item su-mb-2" open @key="s.Endpoint.Id">
            <summary class="plugin-summary">
                <span class="plugin-name">
                    @if (s.Session == null)
                    {
                        <span class="bi bi-plug-fill mcp-status-fail"></span>
                    }
                    else
                    {
                        <span class="bi bi-plug-fill mcp-status-ok"></span>
                    }
                    @s.Endpoint.Name
                </span>
                <span class="plugin-arrow bi bi-chevron-down"></span>
            </summary>

            @if (s.Session == null)
            {
                <div class="su-text-sm mcp-panel-error">@s.Error</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(s.Session.ServerInstructions))
                {
                    <details class="su-mb-2">
                        <summary class="su-text-sm">@Loc["panel_mcp_chat.server_instructions"]</summary>
                        <div class="su-text-sm" style="white-space:pre-wrap">@s.Session.ServerInstructions</div>
                    </details>
                }

                @* ── PROMPTS：模板应用与插入 ── *@
                <div class="su-mb-2">
                    <div class="su-text-sm su-font-bold">@Loc.Format("panel_mcp_chat.prompts", s.Prompts.Count)</div>
                    @if (s.Prompts.Count == 0)
                    {
                        <div class="su-text-sm su-text-2">@Loc["panel_mcp_chat.no_prompts"]</div>
                    }
                    @foreach (var prompt in s.Prompts)
                    {
                        var p = prompt;
                        <div class="mcp-prompt su-mb-1 su-p-1 su-rounded">
                            <div class="su-flex su-items-center su-gap-2">
                                <button class="su-btn su-btn-sm su-btn-outline-primary" @onclick="() => TogglePrompt(s, p)">
                                    <span class="bi bi-chat-left-text"></span> @p.Name
                                </button>
                                <span class="su-text-sm su-text-2">@p.Description</span>
                            </div>

                            @if (ReferenceEquals(s.ActivePrompt, p))
                            {
                                <div class="su-mt-1 su-pl-2">
                                    @if (p.Arguments.Count == 0)
                                    {
                                        <div class="su-text-sm su-text-2">@Loc["panel_mcp_chat.empty_arguments"]</div>
                                    }
                                    @foreach (var arg in p.Arguments)
                                    {
                                        var a = arg;
                                        var argValue = s.PromptArguments.GetValueOrDefault(a.Name) ?? "";
                                        <div class="su-flex su-items-center su-gap-1 su-mb-1">
                                            <span class="su-text-sm" style="min-width:90px">
                                                @a.Name@(a.Required ? " *" : "")
                                            </span>
                                            <input type="text" class="shimmer-input su-flex-1 su-text-sm"
                                                   placeholder="@a.Description"
                                                   value="@argValue"
                                                   @oninput="ev => s.PromptArguments[a.Name] = ev.Value?.ToString() ?? string.Empty" />
                                        </div>
                                    }
                                    <div class="su-flex su-gap-2 su-mt-1">
                                        <button class="su-btn su-btn-sm su-btn-primary" @onclick="() => RenderPromptAsync(s, p)" disabled="@s.PromptRendering">
                                            @Loc["panel_mcp_chat.apply"]
                                        </button>
                                        <button class="su-btn su-btn-sm" @onclick="() => s.ActivePrompt = null">
                                            @Loc["panel_mcp_chat.cancel"]
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.PromptError))
                                    {
                                        <div class="su-text-sm mcp-panel-error su-mt-1">@s.PromptError</div>
                                    }
                                    @if (!string.IsNullOrEmpty(s.RenderedPrompt))
                                    {
                                        <div class="su-mt-1">
                                            <div class="su-text-sm su-font-bold">@Loc["panel_mcp_chat.rendered"]</div>
                                            <pre class="mcp-preview">@s.RenderedPrompt</pre>
                                            <div class="su-flex su-gap-2">
                                                <button class="su-btn su-btn-sm su-btn-outline" @onclick="() => InsertPreview(s, s.RenderedPrompt, p.Name)">
                                                    @Loc["panel_mcp_chat.insert_to_draft"]
                                                </button>
                                                <button class="su-btn su-btn-sm su-btn-outline" @onclick="() => AppendPreviewToDraft(s.RenderedPrompt)">
                                                    @Loc["panel_mcp_chat.append_to_draft"]
                                                </button>
                                                <button class="su-btn su-btn-sm su-btn-primary" @onclick="() => SendPreviewAsync(s.RenderedPrompt, p.Name)">
                                                    @Loc["panel_mcp_chat.send"]
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @* ── TOOLS：展示暴露给 LLM 的清单 ── *@
                <div class="su-mb-2">
                    <div class="su-text-sm su-font-bold">
                        @Loc.Format("panel_mcp_chat.tools", ExposedToolNames(s).Count, s.Tools.Count)
                    </div>
                    <div style="max-height:180px;overflow:auto">
                        @foreach (var tool in s.Tools)
                        {
                            var t = tool;
                            var exposed = IsToolExposed(s, t.Name);
                            <div class="su-text-sm @(exposed ? "" : "su-text-2")">
                                <span class="bi @(exposed ? "bi-check-square" : "bi-square")"></span>
                                @t.Name
                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <span class="su-text-2">— @t.Description</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* ── RESOURCES：展示是否进入上下文 ── *@
                <div>
                    <div class="su-text-sm su-font-bold">
                        @Loc.Format("panel_mcp_chat.resources", s.Resources.Count)
                        <span class="su-text-2">(@ResourceModeLabel(s))</span>
                    </div>
                    @foreach (var resource in s.Resources)
                    {
                        var r = resource;
                        <div class="su-text-sm">
                            <span class="bi @(s.Endpoint.IsResourceEnabled(r.Uri) ? "bi-bookmark-check" : "bi-bookmark")"></span>
                            @r.Name
                            <span class="su-text-2">@r.Uri</span>
                        </div>
                    }
                    <div class="su-flex su-gap-2 su-mt-1">
                        <button class="su-btn su-btn-sm su-btn-outline" @onclick="() => ReadResourceAsync(s, s.Resources.FirstOrDefault()?.Uri)">
                            @Loc["panel_mcp_chat.read_first"]
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(s.ResourceError))
                    {
                        <div class="su-text-sm mcp-panel-error">@s.ResourceError</div>
                    }
                </div>
            }
        </details>
    }
</div>

@code {
    [Parameter] public Guid ChatGuid { get; set; }
    [Parameter] public Guid AgentGuid { get; set; }
    [Parameter] public Action<IChatPanelEventHandler>? EventHandlerReg { get; set; }

    /// <summary>宿主契约：活 Chat/Agent 对象与页面能力。旧参数仍保留以兼容。</summary>
    [Parameter] public ChatPanelContext? PanelContext { get; set; }

    private List<McpEndpointConfig> endpoints = [];
    private readonly List<EndpointState> states = [];
    private readonly List<(McpEndpointConfig Endpoint, string Message)> failures = [];

    private bool loading;
    private bool autoReload = true;
    private string panelMessage = "";
    private string insertedText = "";
    private string insertedTextSource = "";

    private CancellationTokenSource? _loadCts;
    private bool _disposed;
    private Guid? _loadedForChat;

    /// <summary>failures 会被多个并行连接任务写入，必须串行化。</summary>
    private readonly object _uiGate = new();

    /// <summary>
    /// 渲染用的只读快照。后台连接任务会改写 states/failures 的<b>结构</b>，
    /// 而 Blazor 在另一个线程渲染；直接遍历可变 List 会抛“集合已被修改”。
    /// 快照只固定结构，元素对象仍共享引用，因此能反映最新的连接状态。
    /// </summary>
    private IReadOnlyList<EndpointState> _stateSnapshot = [];
    private IReadOnlyList<(McpEndpointConfig Endpoint, string Message)> _failureSnapshot = [];

    private int ConnectedCount => _stateSnapshot.Count(s => s.Session != null);

    private bool IsGenerating => PanelContext?.IsGenerating() ?? false;

    // 没有 PanelContext（旧宿主）时用本地草稿兜底，面板仍可用。
    private string _localDraft = "";

    private string EffectiveDraft => PanelContext?.Draft ?? _localDraft;

    protected override Task OnParametersSetAsync()
    {
        // 本面板不需要接收对话事件（EventHandlerReg），只按需读取当前端点的能力清单。
        //
        // 关键：绝不在这里 await 连接。OnParametersSetAsync 返回前 Blazor 不会提交渲染，
        // 而 MCP 握手可能耗时数十秒（失败的端点要等满握手超时），会把整个对话界面卡住。
        var chatChanged = _loadedForChat != ChatGuid;
        _loadedForChat = ChatGuid;

        if (!chatChanged && (states.Count > 0 || loading))
            return Task.CompletedTask;

        insertedText = "";
        panelMessage = "";

        // 先显示面板骨架，再决定要不要建连。
        if (autoReload)
            StartReload();
        else
            _ = ResetWithoutConnectingAsync();

        return Task.CompletedTask;
    }

    /// <summary>
    /// 关掉「自动重载」时的路径：清掉上一对话的残留状态并释放连接，但不主动建立任何连接。
    /// 同样不能在生命周期方法里 await（释放子进程也可能耗时）。
    /// </summary>
    private async Task ResetWithoutConnectingAsync()
    {
        try
        {
            loading = true;
            await SafeRefreshAsync();

            await DisposeLeasesAsync();

            states.Clear();
            lock (_uiGate)
            {
                failures.Clear();
                _stateSnapshot = [];
                _failureSnapshot = [];
            }
        }
        catch (Exception ex)
        {
            LoggerFactory?.CreateLogger("ShimmerChat.Mcp.Panel")
                .LogError(ex, "[MCP] panel reset failed: {Message}", ex.Message);
            PanelFail(new McpEndpointConfig { Id = "panel", Name = "MCP" }, ex.Message);
        }
        finally
        {
            loading = false;
            await SafeRefreshAsync();
        }
    }

    /// <summary>
    /// 启动一次后台重载。面板立即渲染「连接中」，连接在后台并行进行。
    /// 每个后台任务拥有自己的 CTS，互不影响。
    /// </summary>
    private void StartReload()
    {
        if (_disposed || loading) return;

        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
        var previous = Interlocked.Exchange(ref _loadCts, cts);
        try
        {
            previous?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // 旧任务已自行收尾，无需处理。
        }

        _ = RunReloadAsync(cts);
    }

    /// <summary>后台重载的异常收口：没有调用方，异常必须自己消化并留痕，否则会被静默丢弃。</summary>
    private async Task RunReloadAsync(CancellationTokenSource cts)
    {
        try
        {
            await ReloadAsync(cts.Token);
        }
        catch (Exception ex)
        {
            LoggerFactory?.CreateLogger("ShimmerChat.Mcp.Panel")
                .LogError(ex, "[MCP] panel reload failed: {Message}", ex.Message);
            PanelFail(new McpEndpointConfig { Id = "panel", Name = "MCP" }, ex.Message);
            await SafeRefreshAsync();
        }
        finally
        {
            Interlocked.CompareExchange(ref _loadCts, null, cts);
            cts.Dispose();
        }
    }

    private async Task ReloadAsync(CancellationToken ct)
    {
        if (loading || _disposed) return;

        loading = true;
        panelMessage = "";
        await SafeRefreshAsync();

        // 上一轮持有的租约先归还；连接本身由注册表保活，不会因此重建。
        await DisposeLeasesAsync();

        states.Clear();
        lock (_uiGate)
        {
            failures.Clear();
            _stateSnapshot = [];
            _failureSnapshot = [];
        }
        insertedText = "";

        try
        {
            endpoints = McpEndpointCatalog.Load(KVData).Where(e => e.Enabled).ToList();
        }
        catch (McpConfigException ex)
        {
            PanelFail(new McpEndpointConfig { Id = "config", Name = "MCP" }, ex.Message);
            loading = false;
            await SafeRefreshAsync();
            return;
        }

        // 先把全部端点以「连接中」列出，再并行取租约。
        // 串行连接会让总耗时随端点数线性叠加（N × 握手超时）。
        var pending = endpoints.Select(e => new EndpointState(e)).ToList();
        states.AddRange(pending);
        PublishStates();
        await SafeRefreshAsync();

        await Task.WhenAll(pending.Select(state => LoadEndpointAsync(state, ct)));

        loading = false;
        if (states.Count > 0 && ConnectedCount == 0)
            panelMessage = Loc["panel_mcp_chat.all_failed"];

        await SafeRefreshAsync();
    }

    /// <summary>取租约并枚举单个端点的能力清单。失败只写进该端点的状态与面板错误列表。</summary>
    private async Task LoadEndpointAsync(EndpointState state, CancellationToken ct)
    {
        McpEndpointLease? lease = null;
        try
        {
            // 注意：这里不复用上一轮的连接（注册表已全局复用），面板重载只是重新取一次租约。
            lease = await McpRegistry.Instance.AcquireAsync(state.Endpoint, LoggerFactory, ct);
            var session = lease.Session;

            state.Session = session;
            state.Tools = McpDescriptorFactory.Tools(await session.GetToolsAsync(ct));
            state.Resources = McpDescriptorFactory.Resources(await session.GetResourcesAsync(ct));
            state.Prompts = McpDescriptorFactory.Prompts(await session.GetPromptsAsync(ct));
            state.Lease = lease;
            lease = null;   // 所有权已转移给 state
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            state.Error = Loc["panel_mcp_chat.cancelled"];
            PanelFail(state.Endpoint, state.Error);
        }
        catch (OperationCanceledException ex)
        {
            // 令牌未取消却抛取消 = 内部超时（如 HTTP 请求超时），不是用户主动停止。
            state.Error = ex.Message;
            PanelFail(state.Endpoint, ex.Message);
        }
        catch (Exception ex)
        {
            state.Error = ex.Message;
            PanelFail(state.Endpoint, ex.Message);
        }
        finally
        {
            // 仅在失败时还有未移交的租约；成功时已转给 state。
            if (lease != null)
                await lease.DisposeAsync();
        }

        await SafeRefreshAsync();
    }

    private void PanelFail(McpEndpointConfig endpoint, string message)
    {
        lock (_uiGate)
        {
            failures.Add((endpoint, message));
            _failureSnapshot = failures.ToArray();
        }
    }

    /// <summary>把 states 的结构同步到渲染快照（结构只在重载时变动，调用频率很低）。</summary>
    private void PublishStates()
    {
        lock (_uiGate) _stateSnapshot = states.ToArray();
    }

    /// <summary>自动加载开关：勾选时立即补一次加载，取消勾选则保留当前状态不再重连。</summary>
    private void OnAutoReloadChanged(ChangeEventArgs e)
    {
        autoReload = e.Value is bool flag && flag;
        if (autoReload && _stateSnapshot.Count == 0 && !loading)
            StartReload();
    }

    /// <summary>交互式操作（提示词渲染 / 资源读取）的超时，避免面板按钮永远卡在「处理中」。</summary>
    private static CancellationTokenSource CreateOperationTimeout() =>
        new(TimeSpan.FromSeconds(McpTimeouts.HttpRequestSeconds));

    /// <summary>组件已释放时不再触发重绘，避免后台任务在 circuit 关闭后抛异常。</summary>
    private async ValueTask SafeRefreshAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // circuit/组件已销毁：停止刷新即可，无需向用户报告。
        }
        catch (InvalidOperationException)
        {
            // 渲染器已关闭（例如页面已导航离开）：同上。
        }
    }

    private async Task TogglePrompt(EndpointState state, McpPromptDescriptor prompt)
    {
        if (ReferenceEquals(state.ActivePrompt, prompt))
        {
            state.ActivePrompt = null;
            return;
        }

        state.ActivePrompt = prompt;
        state.RenderedPrompt = "";
        state.PromptError = "";
        state.PromptArguments.Clear();

        // 让服务端给出参数默认值/补全不是必须的：这里仅初始化空值。
        foreach (var arg in prompt.Arguments)
            state.PromptArguments[arg.Name] = "";

        await SafeRefreshAsync();
    }

    private async Task RenderPromptAsync(EndpointState state, McpPromptDescriptor prompt)
    {
        if (state.Session == null) return;

        state.PromptRendering = true;
        state.PromptError = "";
        await SafeRefreshAsync();

        try
        {
            var missing = prompt.Arguments
                .Where(a => a.Required && string.IsNullOrWhiteSpace(state.PromptArguments.GetValueOrDefault(a.Name)))
                .Select(a => a.Name)
                .ToList();

            if (missing.Count > 0)
            {
                state.PromptError = Loc.Format("panel_mcp_chat.missing_args", string.Join(", ", missing));
                return;
            }

            var arguments = prompt.Arguments.ToDictionary(
                a => a.Name,
                a => (object?)(state.PromptArguments.GetValueOrDefault(a.Name) ?? ""),
                StringComparer.Ordinal);

            // 每次操作自带超时：不借用重载用的 CTS（它可能已结束或被下一轮取消）。
            using var opCts = CreateOperationTimeout();
            var result = await state.Session.GetPromptAsync(prompt.Name, arguments, opCts.Token);
            state.RenderedPrompt = FlattenPrompt(result);
            if (string.IsNullOrWhiteSpace(state.RenderedPrompt))
                state.PromptError = Loc["panel_mcp_chat.empty_prompt"];
        }
        catch (OperationCanceledException)
        {
            // 内部超时：对用户就是「这次操作没能完成」。
            state.PromptError = Loc["panel_mcp_chat.operation_timeout"];
        }
        catch (Exception ex)
        {
            state.PromptError = ex.Message;
        }
        finally
        {
            state.PromptRendering = false;
            await SafeRefreshAsync();
        }
    }

    /// <summary>把 prompts/get 的多条消息压平成可直接发送的文本。</summary>
    private static string FlattenPrompt(GetPromptResult result)
    {
        var sb = new StringBuilder();
        foreach (var message in result.Messages)
        {
            var role = message.Role == Role.User ? "user" : "assistant";
            var text = message.Content switch
            {
                TextContentBlock t => t.Text,
                EmbeddedResourceBlock { Resource: TextResourceContents tr } => tr.Text,
                EmbeddedResourceBlock { Resource: BlobResourceContents b } =>
                    $"[binary resource {b.Uri} ({b.MimeType ?? "unknown"}, {b.DecodedData.Length} bytes) omitted]",
                ResourceLinkBlock link => $"[resource link: {link.Uri}]",
                ImageContentBlock img => $"[image content omitted ({img.MimeType ?? "unknown"})]",
                AudioContentBlock audio => $"[audio content omitted ({audio.MimeType ?? "unknown"})]",
                _ => $"[unsupported content '{message.Content?.Type}' omitted]"
            };

            var trimmed = text?.Trim();
            if (string.IsNullOrEmpty(trimmed)) continue;

            if (result.Messages.Count > 1) sb.AppendLine($"<!-- {role} -->");
            sb.AppendLine(trimmed);
        }
        return sb.ToString().TrimEnd();
    }

    private void InsertPreview(EndpointState state, string text, string source)
    {
        insertedText = text;
        insertedTextSource = $"{state.Endpoint.Name}/{source}";
        panelMessage = Loc["panel_mcp_chat.preview_ready"];
    }

    private void InsertPreviewIntoDraft()
    {
        AppendPreviewToDraft(insertedText);
    }

    private void AppendPreviewToDraft(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        SetDraft(string.IsNullOrWhiteSpace(EffectiveDraft) ? text : EffectiveDraft.TrimEnd() + "\n\n" + text);
        insertedText = "";
    }

    private void OnDraftInput(ChangeEventArgs e) => SetDraft(e.Value?.ToString() ?? "");

    private void ClearInsertedPreview() => insertedText = "";

    private void SetDraft(string value)
    {
        if (PanelContext != null) PanelContext.Draft = value;
        else _localDraft = value;
    }

    private void ClearDraft()
    {
        SetDraft("");
        panelMessage = "";
    }

    /// <summary>面板内直接发送：不经过主输入框，直接作为用户消息进入对话并启动生成。</summary>
    private async Task SendDraftAsync() => await SendPreviewAsync(EffectiveDraft, Loc["panel_mcp_chat.draft_title"]);

    private async Task SendPreviewAsync(string text, string source)
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        if (PanelContext == null)
        {
            panelMessage = Loc["panel_mcp_chat.no_host"];
            return;
        }

        if (PanelContext.IsGenerating())
        {
            panelMessage = Loc["panel_mcp_chat.generating"];
            await SafeRefreshAsync();
            return;
        }

        var sent = await PanelContext.SendUserMessageAsync(text);
        if (sent)
        {
            SetDraft("");
            insertedText = "";
            panelMessage = Loc.Format("panel_mcp_chat.sent", source);
        }
        else
        {
            panelMessage = Loc["panel_mcp_chat.send_failed"];
        }

        await SafeRefreshAsync();
    }

    private async Task ReadResourceAsync(EndpointState state, string? uri)
    {
        if (state.Session == null || string.IsNullOrWhiteSpace(uri)) return;

        state.ResourceError = "";
        try
        {
            using var opCts = CreateOperationTimeout();
            var content = await state.Session.ReadResourceAsync(uri, opCts.Token);
            insertedText = McpResources.Truncate(content, McpResources.PerResourceCharLimit, uri);
            insertedTextSource = $"{state.Endpoint.Name}/{uri}";
            panelMessage = Loc["panel_mcp_chat.preview_ready"];
        }
        catch (OperationCanceledException)
        {
            state.ResourceError = Loc["panel_mcp_chat.operation_timeout"];
        }
        catch (Exception ex)
        {
            state.ResourceError = ex.Message;
        }

        await SafeRefreshAsync();
    }

    private static bool IsToolExposed(EndpointState state, string toolName)
    {
        if (!state.Endpoint.ExposeTools) return false;
        return state.Endpoint.ResolveEnabledTools(state.Tools.Select(t => t.Name)).Contains(toolName, StringComparer.Ordinal);
    }

    private static List<string> ExposedToolNames(EndpointState state) =>
        state.Endpoint.ExposeTools
            ? state.Endpoint.ResolveEnabledTools(state.Tools.Select(t => t.Name)).ToList()
            : [];

    private string ResourceModeLabel(EndpointState state) => state.Endpoint.ResourceInjection switch
    {
        McpResourceInjection.All => Loc["panel_mcp.resource_all"],
        McpResourceInjection.Selected => Loc["panel_mcp.resource_selected"],
        _ => Loc["panel_mcp.resource_off"]
    };

    /// <summary>
    /// 释放面板持有的全部租约。只减少引用计数，不会立即关闭连接：
    /// 注册表会按空闲超时回收，因此重载/切对话不会触发无意义的重新握手。
    /// </summary>
    private async Task DisposeLeasesAsync()
    {
        List<EndpointState> snapshot;
        lock (_uiGate)
        {
            snapshot = _stateSnapshot.ToList();
        }

        foreach (var state in snapshot)
        {
            var lease = state.Lease;
            state.Lease = null;
            state.Session = null;
            if (lease == null) continue;

            try
            {
                await lease.DisposeAsync();
            }
            catch (Exception ex)
            {
                PanelFail(state.Endpoint, ex.Message);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        // 只取消，不 Dispose：正在等待的后台任务仍会读它的 Token（各自在 finally 里释放）。
        try
        {
            _loadCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // 后台任务已自行收尾。
        }
        _loadCts = null;

        await DisposeLeasesAsync();
    }

    private sealed class EndpointState
    {
        public EndpointState(McpEndpointConfig endpoint) => Endpoint = endpoint;

        public McpEndpointConfig Endpoint { get; }
        public McpEndpointSession? Session { get; set; }

        /// <summary>本面板持有的连接租约（组件释放时归还）。</summary>
        public McpEndpointLease? Lease { get; set; }

        public string? Error { get; set; }
        public List<McpToolDescriptor> Tools { get; set; } = [];
        public List<McpResourceDescriptor> Resources { get; set; } = [];
        public List<McpPromptDescriptor> Prompts { get; set; } = [];

        /// <summary>折叠状态仅供初次渲染参考；之后由浏览器 DOM 主导，不再回写。</summary>
        public bool Open { get; set; } = true;
        public McpPromptDescriptor? ActivePrompt { get; set; }
        public Dictionary<string, string?> PromptArguments { get; } = new(StringComparer.Ordinal);
        public string RenderedPrompt { get; set; } = "";
        public string PromptError { get; set; } = "";
        public bool PromptRendering { get; set; }
        public string ResourceError { get; set; } = "";
    }
}
