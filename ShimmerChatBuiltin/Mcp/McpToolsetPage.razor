@using ShimmerChatBuiltin.Mcp
@using ShimmerChatLib.Interface
@using ShimmerChatLib.Panel
@using Microsoft.Extensions.Logging
@inject IKVDataService KVData
@inject ILocService Loc
@inject ILoggerFactory LoggerFactory

@attribute [PluginPanelAttribute("panel.mcp_toolset", "panel.mcp_toolset.desc", PanelDisplayPlace.Settings, Order = 30)]

<div class="shimmer-content su-p-4">
    <h2 class="su-text-lg su-font-bold su-mb-2">@Loc["panel_mcp.title"]</h2>
    <p class="su-text-2 su-mb-4">@Loc["panel_mcp.desc"]</p>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="su-mb-4 su-px-3 su-py-2 su-rounded @(statusIsError ? "su-badge su-badge-danger" : "su-badge su-badge-success")">
            @statusMessage
        </div>
    }

    <div class="su-flex su-gap-2 su-mb-4 su-items-center su-flex-wrap">
        <input type="text" class="shimmer-input su-flex-1" style="min-width:220px"
               placeholder="@Loc["panel_mcp.new_placeholder"]" @bind="newEndpointName" @bind:event="oninput" />
        <button class="su-btn su-btn-primary" @onclick="AddEndpoint" disabled="@busy">
            <span class="bi bi-plus"></span> @Loc["panel_mcp.add"]
        </button>
        <button class="su-btn" @onclick="Reload" disabled="@busy">
            <span class="bi bi-arrow-clockwise"></span> @Loc["panel_mcp.reload"]
        </button>
        <button class="su-btn" @onclick="SaveAll" disabled="@busy">
            <span class="bi bi-save"></span> @Loc["panel_mcp.save"]
        </button>
    </div>

    @if (endpoints.Count == 0)
    {
        <div class="su-alert su-alert-info">
            <span class="bi bi-info-circle"></span> @Loc["panel_mcp.empty"]
        </div>
    }

    <div class="su-flex su-flex-col su-gap-4">
        @foreach (var endpoint in endpoints)
        {
            var e = endpoint;
            var probing = probingEndpointId == e.Id;
            <div class="su-border su-rounded su-p-3" style="@(e.Enabled ? "" : "opacity:.6")">
                <div class="su-flex su-items-center su-gap-2 su-flex-wrap su-mb-2">
                    <input type="checkbox" class="su-check" checked="@e.Enabled"
                           @onchange="ev => ToggleEnabled(e, ev)" />
                    <input type="text" class="shimmer-input" style="max-width:240px" @bind="e.Name" @bind:event="oninput" />
                    <span class="su-badge">@e.Id</span>
                    <span class="su-badge">@e.Transport</span>
                    <span class="su-flex-1"></span>
                    <button class="su-btn su-btn-sm su-btn-outline-primary" @onclick="() => ProbeAsync(e)" disabled="@(busy || probing)">
                        @if (probing)
                        {
                            <span>@Loc["panel_mcp.probing"]</span>
                        }
                        else
                        {
                            <span class="bi bi-plug"></span>
                            <span>@Loc["panel_mcp.probe"]</span>
                        }
                    </button>
                    <button class="su-btn su-btn-sm su-btn-outline-danger" @onclick="() => RemoveEndpoint(e)" disabled="@busy">
                        <span class="bi bi-trash"></span>
                    </button>
                </div>

                @if (probeResults.TryGetValue(e.Id, out var probe))
                {
                    <div class="su-mb-2 su-px-3 su-py-2 su-rounded su-text-sm @(probe.Success ? "bg-success/10" : "bg-danger/10")">
                        @if (probe.Success)
                        {
                            <div><span class="bi bi-check-circle"></span> @Loc.Format("panel_mcp.probe_ok", probe.ServerName ?? "?", probe.ProtocolVersion ?? "?")</div>
                            <div class="su-text-2">@Loc.Format("panel_mcp.probe_counts", probe.ToolCount, probe.ResourceCount, probe.PromptCount)</div>
                            @if (probe.UsedSseFallback)
                            {
                                <div class="su-text-2">@Loc["panel_mcp.probe_sse_fallback"]</div>
                            }
                            @if (!string.IsNullOrEmpty(probe.Instructions))
                            {
                                <details class="su-mt-2">
                                    <summary>@Loc["panel_mcp.probe_instructions"]</summary>
                                    <pre class="su-text-sm" style="white-space:pre-wrap">@probe.Instructions</pre>
                                </details>
                            }
                        }
                        else
                        {
                            <div><span class="bi bi-exclamation-triangle"></span> @Loc.Format("panel_mcp.probe_failed", probe.Error ?? "")</div>
                        }
                    </div>
                }

                <div class="su-row su-gap-3">
                    <div class="su-col-6">
                        <h4 class="su-font-bold su-text-sm">@Loc["panel_mcp.transport"]</h4>
                        <select class="su-select" value="@e.Transport"
                                @onchange="ev => ChangeTransport(e, ev)">
                            <option value="Stdio">@Loc["panel_mcp.transport_stdio"]</option>
                            <option value="Http">@Loc["panel_mcp.transport_http"]</option>
                        </select>

                        @if (e.Transport == McpTransportType.Stdio)
                        {
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.command"]</label>
                                <input type="text" class="shimmer-input su-w-full" @bind="e.Command" @bind:event="oninput"
                                       placeholder="npx" />
                            </div>
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.arguments"]</label>
                                <textarea class="shimmer-textarea su-w-full" rows="3" @bind="e.ArgumentsText"
                                          placeholder="@Loc["panel_mcp.arguments_placeholder"]"></textarea>
                            </div>
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.environment"]</label>
                                <textarea class="shimmer-textarea su-w-full" rows="3" @bind="e.EnvironmentText"
                                          placeholder="API_KEY=..."></textarea>
                            </div>
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.working_dir"]</label>
                                <input type="text" class="shimmer-input su-w-full" @bind="e.WorkingDirectory" @bind:event="oninput" />
                            </div>
                            <div class="su-mt-2">
                                <label class="su-flex su-items-center su-gap-2 su-text-sm">
                                    <input type="checkbox" class="su-check" checked="@e.InheritEnvironment"
                                           @onchange="ev => ToggleInheritEnvironment(e, ev)" />
                                    @Loc["panel_mcp.inherit_env"]
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.url"]</label>
                                <input type="text" class="shimmer-input su-w-full" @bind="e.Url" @bind:event="oninput"
                                       placeholder="https://example.com/mcp" />
                            </div>
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.http_mode"]</label>
                                <select class="su-select" value="@e.HttpMode"
                                        @onchange="ev => ChangeHttpMode(e, ev)">
                                    <option value="AutoDetect">@Loc["panel_mcp.http_mode_auto"]</option>
                                    <option value="StreamableHttp">@Loc["panel_mcp.http_mode_streamable"]</option>
                                    <option value="Sse">@Loc["panel_mcp.http_mode_sse"]</option>
                                </select>
                                <p class="su-text-sm su-text-2">@Loc["panel_mcp.http_mode_hint"]</p>
                            </div>
                            <div class="su-mt-2">
                                <label class="su-text-sm">@Loc["panel_mcp.headers"]</label>
                                <textarea class="shimmer-textarea su-w-full" rows="3" @bind="e.HeadersText"
                                          placeholder="Authorization: Bearer ..."></textarea>
                            </div>
                        }

                        <div class="su-mt-2">
                            <label class="su-text-sm">@Loc["panel_mcp.init_timeout"]</label>
                            <input type="number" class="shimmer-input" style="max-width:140px" @bind="e.InitializationTimeoutSeconds" />
                        </div>
                    </div>

                    <div class="su-col-6">
                        <h4 class="su-font-bold su-text-sm">@Loc["panel_mcp.exposure"]</h4>
                        <label class="su-flex su-items-center su-gap-2 su-text-sm">
                            <input type="checkbox" class="su-check" checked="@e.ExposeTools"
                                   @onchange="ev => ToggleExposeTools(e, ev)" />
                            @Loc["panel_mcp.expose_tools"]
                        </label>
                        <label class="su-flex su-items-center su-gap-2 su-text-sm su-mt-1">
                            <input type="checkbox" class="su-check" checked="@e.ExposeResourceReadTool"
                                   @onchange="ev => ToggleExposeResourceTool(e, ev)" />
                            @Loc["panel_mcp.expose_resource_tool"]
                        </label>

                        <div class="su-mt-2">
                            <label class="su-text-sm">@Loc["panel_mcp.resource_injection"]</label>
                            <select class="su-select" value="@e.ResourceInjection"
                                    @onchange="ev => ChangeResourceInjection(e, ev)">
                                <option value="Off">@Loc["panel_mcp.resource_off"]</option>
                                <option value="Selected">@Loc["panel_mcp.resource_selected"]</option>
                                <option value="All">@Loc["panel_mcp.resource_all"]</option>
                            </select>
                            <p class="su-text-sm su-text-2">@Loc["panel_mcp.resource_injection_hint"]</p>
                        </div>

                        <div class="su-mt-2">
                            <label class="su-text-sm">@Loc["panel_mcp.budget"]</label>
                            <input type="number" class="shimmer-input" style="max-width:160px" @bind="e.ResourceCharBudget" />
                        </div>

                        @if (inventories.TryGetValue(e.Id, out var inventory))
                        {
                            <div class="su-mt-3">
                                <h5 class="su-font-bold su-text-sm">
                                    @Loc.Format("panel_mcp.tools_found", inventory.Tools.Count)
                                </h5>
                                @if (inventory.Tools.Count == 0)
                                {
                                    <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_tools"]</p>
                                }
                                else
                                {
                                    <div style="max-height:260px;overflow:auto">
                                        @foreach (var tool in inventory.Tools)
                                        {
                                            var t = tool;
                                            <label class="su-flex su-items-start su-gap-2 su-text-sm su-mb-1">
                                                <input type="checkbox" class="su-check" checked="@e.IsToolEnabled(t.Name)"
                                                       @onchange="ev => ToggleTool(e, t.Name, ev)" />
                                                <span>
                                                    <span class="su-font-bold">@t.Name</span>
                                                    @if (t.ReadOnlyHint == true)
                                                    {
                                                        <span class="su-badge">@Loc["panel_mcp.readonly"]</span>
                                                    }
                                                    @if (t.DestructiveHint == true)
                                                    {
                                                        <span class="su-badge su-badge-danger">@Loc["panel_mcp.destructive"]</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                                    {
                                                        <br />
                                                        <span class="su-text-2">@t.Description</span>
                                                    }
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="su-mt-3">
                                <h5 class="su-font-bold su-text-sm">
                                    @Loc.Format("panel_mcp.resources_found", inventory.Resources.Count)
                                </h5>
                                @if (inventory.Resources.Count == 0)
                                {
                                    <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_resources"]</p>
                                }
                                else
                                {
                                    <div style="max-height:200px;overflow:auto">
                                        @foreach (var resource in inventory.Resources)
                                        {
                                            var r = resource;
                                            <label class="su-flex su-items-start su-gap-2 su-text-sm su-mb-1">
                                                <input type="checkbox" class="su-check" checked="@e.IsResourceEnabled(r.Uri)"
                                                       @onchange="ev => ToggleResource(e, r.Uri, ev)" />
                                                <span>
                                                    <span>@r.Name</span>
                                                    <br />
                                                    <span class="su-text-2">@r.Uri</span>
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="su-mt-3">
                                <h5 class="su-font-bold su-text-sm">
                                    @Loc.Format("panel_mcp.prompts_found", inventory.Prompts.Count)
                                </h5>
                                @if (inventory.Prompts.Count == 0)
                                {
                                    <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_prompts"]</p>
                                }
                                else
                                {
                                    @foreach (var prompt in inventory.Prompts)
                                    {
                                        <div class="su-text-sm su-mb-1">
                                            <span class="bi bi-chat-left-text"></span>
                                            <span class="su-font-bold">@prompt.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(prompt.Description))
                                            {
                                                <span class="su-text-2">— @prompt.Description</span>
                                            }
                                            @if (prompt.Arguments.Count > 0)
                                            {
                                                <div class="su-text-2">
                                                    @Loc.Format("panel_mcp.prompt_args",
                                                        string.Join(", ", prompt.Arguments.Select(a => a.Required ? a.Name + "*" : a.Name)))
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <p class="su-text-sm su-text-2 su-mt-3">@Loc["panel_mcp.probe_to_enumerate"]</p>
                        }
                    </div>
                </div>

                <div class="su-mt-3 su-flex su-gap-2 su-items-center">
                    <button class="su-btn su-btn-sm su-btn-primary" @onclick="() => CopyNodeJson(e)" disabled="@busy">
                        <span class="bi bi-clipboard"></span> @Loc["panel_mcp.copy_node"]
                    </button>
                    <button class="su-btn su-btn-sm" @onclick="() => DiscardEndpoint(e)" disabled="@busy">
                        @Loc["panel_mcp.discard"]
                    </button>
                    @if (dirty)
                    {
                        <span class="su-text-sm su-text-2">@Loc["panel_mcp.unsaved"]</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<EditorModel> endpoints = [];
    private readonly Dictionary<string, ProbeResult> probeResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, Inventory> inventories = new(StringComparer.OrdinalIgnoreCase);

    private string newEndpointName = "";
    private string statusMessage = "";
    private bool statusIsError;
    private bool busy;
    private bool dirty;
    private string? probingEndpointId;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        try
        {
            endpoints = McpEndpointCatalog.Load(KVData).Select(EditorModel.From).ToList();
            probeResults.Clear();
            inventories.Clear();
            dirty = false;
            ShowStatus(Loc.Format("panel_mcp.loaded", endpoints.Count), false);
        }
        catch (McpConfigException ex)
        {
            ShowStatus(Loc.Format("panel_mcp.load_failed", ex.Message), true);
        }
    }

    private void AddEndpoint()
    {
        var name = string.IsNullOrWhiteSpace(newEndpointName)
            ? Loc["panel_mcp.default_name"]
            : newEndpointName.Trim();

        var config = McpEndpointCatalog.CreateNew(name, endpoints.Select(x => x.ToConfig()));
        endpoints.Add(EditorModel.From(config));
        newEndpointName = "";
        MarkDirty();
    }

    private void RemoveEndpoint(EditorModel endpoint)
    {
        endpoints.Remove(endpoint);
        probeResults.Remove(endpoint.Id);
        inventories.Remove(endpoint.Id);
        MarkDirty();
    }

    private void DiscardEndpoint(EditorModel endpoint)
    {
        try
        {
            var stored = McpEndpointCatalog.Find(McpEndpointCatalog.Load(KVData), endpoint.Id);
            if (stored == null)
            {
                RemoveEndpoint(endpoint);
                ShowStatus(Loc["panel_mcp.discarded_new"], false);
                return;
            }

            var index = endpoints.IndexOf(endpoint);
            endpoints[index] = EditorModel.From(stored);
            ShowStatus(Loc["panel_mcp.discarded"], false);
        }
        catch (McpConfigException ex)
        {
            ShowStatus(Loc.Format("panel_mcp.load_failed", ex.Message), true);
        }
    }

    private void SaveAll()
    {
        var configs = endpoints.Select(x => x.ToConfig()).ToList();
        var errors = new List<string>();
        foreach (var config in configs)
        {
            var endpointErrors = McpEndpointCatalog.Validate(config, Loc);
            errors.AddRange(endpointErrors.Select(msg => $"[{config.Name}] {msg}"));
        }

        var duplicates = configs.GroupBy(c => c.Id, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToList();
        errors.AddRange(duplicates.Select(id => Loc.Format("mcp_err.id_duplicate", id)));

        if (errors.Count > 0)
        {
            ShowStatus(string.Join(" | ", errors), true);
            return;
        }

        try
        {
            McpEndpointCatalog.Save(KVData, configs);
            dirty = false;
            ShowStatus(Loc.Format("panel_mcp.saved", configs.Count), false);
        }
        catch (Exception ex)
        {
            ShowStatus(Loc.Format("panel_mcp.save_failed", ex.Message), true);
        }
    }

    private async Task ProbeAsync(EditorModel endpoint)
    {
        busy = true;
        probingEndpointId = endpoint.Id;
        probeResults.Remove(endpoint.Id);
        inventories.Remove(endpoint.Id);

        var config = endpoint.ToConfig();
        var errors = McpEndpointCatalog.Validate(config, Loc);
        if (errors.Count > 0)
        {
            probeResults[endpoint.Id] = new ProbeResult(false, null, null, 0, 0, 0, false, null, string.Join(" | ", errors));
            busy = false;
            probingEndpointId = null;
            return;
        }

        McpEndpointSession? session = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(Math.Max(5, config.InitializationTimeoutSeconds + 15)));
            session = await McpEndpointSession.ConnectAsync(config, LoggerFactory, cts.Token);

            var tools = (await session.GetToolsAsync(cts.Token)).Select(McpToolDescriptor.From).ToList();
            var resources = (await session.GetResourcesAsync(cts.Token))
                .Select(r => new McpResourceDescriptor(r.Uri, r.Name, r.Title, r.Description, r.MimeType, null))
                .ToList();
            var prompts = (await session.GetPromptsAsync(cts.Token))
                .Select(p => new McpPromptDescriptor(
                    p.Name, p.Title, p.Description,
                    p.ProtocolPrompt.Arguments?.Select(a => new McpPromptArgumentDescriptor(
                        a.Name, a.Title, a.Description, a.Required == true)).ToList()
                        ?? (IReadOnlyList<McpPromptArgumentDescriptor>)[]))
                .ToList();

            inventories[endpoint.Id] = new Inventory(tools, resources, prompts);
            probeResults[endpoint.Id] = new ProbeResult(
                true,
                session.ServerInfo?.Name,
                session.Client.NegotiatedProtocolVersion?.ToString(),
                tools.Count, resources.Count, prompts.Count,
                false,
                session.ServerInstructions,
                null);

            // 新发现的条目按当前默认策略补齐开关状态，避免出现「未列出」的隐式条目。
            foreach (var tool in tools)
                if (endpoint.Tools.All(t => !string.Equals(t.Name, tool.Name, StringComparison.Ordinal)))
                    endpoint.Tools.Add(new McpNamedToggle { Name = tool.Name, Enabled = endpoint.ToolsEnabledByDefault });
            foreach (var resource in resources)
                if (endpoint.Resources.All(r => !string.Equals(r.Name, resource.Uri, StringComparison.Ordinal)))
                    endpoint.Resources.Add(new McpNamedToggle { Name = resource.Uri, Enabled = endpoint.ResourceInjection == McpResourceInjection.All });

            ShowStatus(Loc.Format("panel_mcp.probe_summary", config.Name, tools.Count, resources.Count, prompts.Count), false);
        }
        catch (Exception ex)
        {
            probeResults[endpoint.Id] = new ProbeResult(false, null, null, 0, 0, 0, false, null, ex.Message);
            ShowStatus(Loc.Format("panel_mcp.probe_error", config.Name, ex.Message), true);
        }
        finally
        {
            if (session != null)
            {
                try { await session.DisposeAsync(); }
                catch (Exception ex) { ShowStatus(Loc.Format("panel_mcp.dispose_failed", ex.Message), true); }
            }

            busy = false;
            probingEndpointId = null;
        }
    }

    private void CopyNodeJson(EditorModel endpoint)
    {
        // 给出可直接粘贴到前生成节点的配置值，避免用户手抄 Id。
        ShowStatus(Loc.Format("panel_mcp.node_hint", endpoint.Id), false);
    }

    private void MarkDirty()
    {
        dirty = true;
        StateHasChanged();
    }

    private void ToggleEnabled(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.Enabled = e.Value is bool flag && flag;
        MarkDirty();
    }

    private void ToggleInheritEnvironment(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.InheritEnvironment = e.Value is bool flag && flag;
    }

    private void ToggleExposeTools(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.ExposeTools = e.Value is bool flag && flag;
        MarkDirty();
    }

    private void ToggleExposeResourceTool(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.ExposeResourceReadTool = e.Value is bool flag && flag;
        MarkDirty();
    }

    private void ToggleTool(EditorModel endpoint, string toolName, ChangeEventArgs e)
    {
        endpoint.SetToolEnabled(toolName, e.Value is bool flag && flag);
        MarkDirty();
    }

    private void ToggleResource(EditorModel endpoint, string uri, ChangeEventArgs e)
    {
        endpoint.SetResourceEnabled(uri, e.Value is bool flag && flag);
        MarkDirty();
    }

    private void ChangeTransport(EditorModel endpoint, ChangeEventArgs e)
    {
        if (!Enum.TryParse<McpTransportType>(e.Value?.ToString(), out var transport))
        {
            ShowStatus(Loc.Format("mcp_err.transport_unknown", e.Value?.ToString() ?? ""), true);
            return;
        }

        endpoint.Transport = transport;
        MarkDirty();
    }

    private void ChangeHttpMode(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.HttpMode = Enum.TryParse<McpHttpMode>(e.Value?.ToString(), out var mode)
            ? mode
            : McpHttpMode.AutoDetect;
        MarkDirty();
    }

    private void ChangeResourceInjection(EditorModel endpoint, ChangeEventArgs e)
    {
        endpoint.ResourceInjection = Enum.TryParse<McpResourceInjection>(e.Value?.ToString(), out var injection)
            ? injection
            : McpResourceInjection.Off;
        MarkDirty();
    }

    private void ShowStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private sealed record ProbeResult(
        bool Success,
        string? ServerName,
        string? ProtocolVersion,
        int ToolCount,
        int ResourceCount,
        int PromptCount,
        bool UsedSseFallback,
        string? Instructions,
        string? Error);

    private sealed record Inventory(
        IReadOnlyList<McpToolDescriptor> Tools,
        IReadOnlyList<McpResourceDescriptor> Resources,
        IReadOnlyList<McpPromptDescriptor> Prompts);

    /// <summary>
    /// 编辑用模型：把「每行一条」的文本字段与配置对象互相转换，
    /// 避免在 Razor 里直接处理 List&lt;string&gt; 的绑定。
    /// </summary>
    private sealed class EditorModel
    {
        public required McpEndpointConfig Config { get; init; }

        public string Id => Config.Id;
        public string Name { get => Config.Name; set => Config.Name = value; }
        public bool Enabled { get => Config.Enabled; set => Config.Enabled = value; }
        public McpTransportType Transport { get => Config.Transport; set => Config.Transport = value; }
        public string Command { get => Config.Command; set => Config.Command = value; }
        public string WorkingDirectory { get => Config.WorkingDirectory; set => Config.WorkingDirectory = value; }
        public bool InheritEnvironment { get => Config.InheritEnvironment; set => Config.InheritEnvironment = value; }
        public int InitializationTimeoutSeconds { get => Config.InitializationTimeoutSeconds; set => Config.InitializationTimeoutSeconds = value; }
        public string Url { get => Config.Url; set => Config.Url = value; }
        public McpHttpMode HttpMode { get => Config.HttpMode; set => Config.HttpMode = value; }
        public bool ExposeTools { get => Config.ExposeTools; set => Config.ExposeTools = value; }
        public bool ToolsEnabledByDefault { get => Config.ToolsEnabledByDefault; set => Config.ToolsEnabledByDefault = value; }
        public McpResourceInjection ResourceInjection { get => Config.ResourceInjection; set => Config.ResourceInjection = value; }
        public bool ExposeResourceReadTool { get => Config.ExposeResourceReadTool; set => Config.ExposeResourceReadTool = value; }
        public int ResourceCharBudget { get => Config.ResourceCharBudget; set => Config.ResourceCharBudget = value; }
        public List<McpNamedToggle> Tools => Config.Tools;
        public List<McpNamedToggle> Resources => Config.Resources;

        public bool IsToolEnabled(string name) => Config.IsToolEnabled(name);
        public void SetToolEnabled(string name, bool enabled) => Config.SetToolEnabled(name, enabled);
        public bool IsResourceEnabled(string uri) => Config.IsResourceEnabled(uri);
        public void SetResourceEnabled(string uri, bool enabled) => Config.SetResourceEnabled(uri, enabled);

        public string ArgumentsText
        {
            get => string.Join(Environment.NewLine, Config.Arguments);
            set => Config.Arguments = SplitLines(value);
        }

        public string EnvironmentText
        {
            get => string.Join(Environment.NewLine, Config.Environment);
            set => Config.Environment = SplitLines(value);
        }

        public string HeadersText
        {
            get => string.Join(Environment.NewLine, Config.Headers);
            set => Config.Headers = SplitLines(value);
        }

        public McpEndpointConfig ToConfig() => Config;

        public static EditorModel From(McpEndpointConfig config) => new() { Config = config };

        private static List<string> SplitLines(string? value) =>
            (value ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.TrimEnd('\r'))
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToList();
    }
}
