@using ShimmerChatBuiltin.Mcp
@using ShimmerChatLib.Components
@using ShimmerChatLib.Interface
@using ShimmerChatLib.Panel
@using Microsoft.Extensions.Logging
@using System.Text.Json
@inject IKVDataService KVData
@inject ILocService Loc
@inject ILoggerFactory LoggerFactory
@inject IJSRuntime JS

@attribute [PluginPanelAttribute("panel.mcp_toolset", "panel.mcp_toolset.desc", PanelDisplayPlace.Settings, Order = 30)]

<ConfigShell T="EditorModel"
            Items="_endpoints"
            SelectedId="@_selectedId"
            IdSelector="@(e => e.Id)"
            NameSelector="@(e => e.Name)"
            TypeSelector="@(e => TransportLabel(e.Transport))"
            MetaSelector="@(e => e.Transport == McpTransportType.Stdio ? e.Command : e.Url)"
            SearchSelector="@(e => $"{e.Command} {e.Url} {string.Join(' ', e.Tools.Select(t => t.Name))}")"
            PinSelector="@(e => e.Pinned)"
            Title="@Loc["panel_mcp.title"]"
            Description="@Loc["panel_mcp.desc"]"
            Icon="bi-plug"
            IsDirty="IsDirty"
            LoadError="@_loadError"
            StatusMessage="@_statusText"
            StatusKind="@_statusKind"
            OnCreate="AddEndpoint"
            OnSave="SaveAll"
            OnSelect="SelectEndpoint"
            OnClone="CloneEndpoint"
            OnRename="RenameEndpoint"
            OnDelete="RemoveEndpoint"
            OnTogglePin="TogglePin"
            OnRetry="Reload">
    <ToolbarExtras>
        <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                disabled="@(Current == null || _probingEndpointKey != null)"
                @onclick="ProbeCurrentAsync"
                title="@Loc["panel_mcp.probe"]" aria-label="@Loc["panel_mcp.probe"]">
            <i class="bi @(_probingEndpointKey != null ? "bi-hourglass-split" : "bi-plug")"></i>
            <span class="cfg-btn-label">@Loc["panel_mcp.probe"]</span>
        </button>
        <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn"
                disabled="@(Current == null)" @onclick="CopyNodeJson"
                title="@Loc["panel_mcp.copy_node"]" aria-label="@Loc["panel_mcp.copy_node"]">
            <i class="bi bi-clipboard-check"></i>
        </button>
    </ToolbarExtras>
    <Body>
        @if (Current is { } endpoint)
        {
            var probing = _probingEndpointKey == endpoint.RefKey;

            if (_probeResults.TryGetValue(endpoint.RefKey, out var probe))
            {
                <div class="cfg-note @(probe.Success ? "is-success" : "is-danger")">
                    <i class="bi @(probe.Success ? "bi-check-circle-fill" : "bi-exclamation-octagon-fill")"></i>
                    <span>
                        @if (probe.Success)
                        {
                            @Loc.Format("panel_mcp.probe_ok", probe.ServerName ?? "?", probe.ProtocolVersion ?? "?")
                            <br />
                            @Loc.Format("panel_mcp.probe_counts", probe.ToolCount, probe.ResourceCount, probe.PromptCount)
                            @if (probe.UsedSseFallback)
                            {
                                <br />
                                @Loc["panel_mcp.probe_sse_fallback"]
                            }
                            @if (!string.IsNullOrEmpty(probe.Instructions))
                            {
                                <details class="cfg-probe-instructions">
                                    <summary>@Loc["panel_mcp.probe_instructions"]</summary>
                                    <pre>@probe.Instructions</pre>
                                </details>
                            }
                        }
                        else
                        {
                            @Loc.Format("panel_mcp.probe_failed", probe.Error ?? "")
                        }
                    </span>
                </div>
            }

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["mcp_config.basic"]</h3>
                        <p>@Loc["mcp_config.basic_desc"]</p>
                    </div>
                    <label class="cfg-toggle">
                        <input type="checkbox" @bind="endpoint.Enabled" />
                        <span>@Loc["panel_mcp.enabled"]</span>
                    </label>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-5">
                        <label class="su-label">@Loc["panel_mcp.name"]</label>
                        <input class="su-input" @bind="endpoint.Name" />
                        <p class="cfg-field-hint">@Loc["mcp_config.name_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["mcp_config.id"]</label>
                        @if (_editingIdKey == endpoint.RefKey)
                        {
                            <div class="cfg-readonly-row">
                                <input class="su-input" @bind="_idDraft" @bind:event="oninput"
                                       @onkeydown="OnIdDraftKeyDown" autofocus
                                       aria-label="@Loc["mcp_config.id"]" />
                                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn"
                                        @onclick="ApplyIdEdit"
                                        title="@Loc["config_ui.dialog_confirm"]" aria-label="@Loc["config_ui.dialog_confirm"]">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn"
                                        @onclick="CancelIdEdit"
                                        title="@Loc["config_ui.dialog_cancel"]" aria-label="@Loc["config_ui.dialog_cancel"]">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <p class="cfg-field-hint">@Loc["mcp_config.id_edit_hint"]</p>
                        }
                        else
                        {
                            <div class="cfg-readonly-row">
                                <code title="@endpoint.Id">@endpoint.Id</code>
                                <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn"
                                        @onclick="() => BeginIdEdit(endpoint)"
                                        title="@Loc["mcp_config.edit_id"]" aria-label="@Loc["mcp_config.edit_id"]">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                            <p class="cfg-field-hint">@Loc["mcp_config.id_hint"]</p>
                            @if (!string.Equals(endpoint.RefKey, endpoint.Id, StringComparison.OrdinalIgnoreCase))
                            {
                                <p class="cfg-field-hint">@Loc.Format("mcp_config.ref_key", endpoint.RefKey)</p>
                            }
                        }
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_mcp.transport"]</label>
                        <select class="su-select" @bind="endpoint.Transport">
                            <option value="@McpTransportType.Stdio">@Loc["panel_mcp.transport_stdio"]</option>
                            <option value="@McpTransportType.Http">@Loc["panel_mcp.transport_http"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["mcp_config.transport_hint"]</p>
                    </div>
                </div>
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-hdd-network"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["mcp_config.connection"]</h3>
                        <p>@Loc["mcp_config.connection_desc"]</p>
                    </div>
                </div>

                <div class="cfg-grid">
                    @if (endpoint.Transport == McpTransportType.Stdio)
                    {
                        <div class="cfg-field cfg-span-5">
                            <label class="su-label">@Loc["panel_mcp.command"]</label>
                            <input class="su-input" @bind="endpoint.Command" placeholder="npx" />
                        </div>
                        <div class="cfg-field cfg-span-7">
                            <label class="su-label">@Loc["panel_mcp.working_dir"]</label>
                            <input class="su-input" @bind="endpoint.WorkingDirectory" />
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["panel_mcp.arguments"]</label>
                            <textarea class="su-input cfg-textarea" rows="3" @bind="endpoint.ArgumentsText"
                                      placeholder="@Loc["panel_mcp.arguments_placeholder"]"></textarea>
                        </div>
                        <div class="cfg-field cfg-span-6">
                            <label class="su-label">@Loc["panel_mcp.environment"]</label>
                            <textarea class="su-input cfg-textarea" rows="3" @bind="endpoint.EnvironmentText"
                                      placeholder="API_KEY=..."></textarea>
                            <label class="cfg-toggle">
                                <input type="checkbox" @bind="endpoint.InheritEnvironment" />
                                <span>@Loc["panel_mcp.inherit_env"]</span>
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="cfg-field cfg-span-8">
                            <label class="su-label">@Loc["panel_mcp.url"]</label>
                            <input class="su-input" @bind="endpoint.Url" placeholder="https://example.com/mcp" />
                        </div>
                        <div class="cfg-field cfg-span-4">
                            <label class="su-label">@Loc["panel_mcp.http_mode"]</label>
                            <select class="su-select" @bind="endpoint.HttpMode">
                                <option value="@McpHttpMode.AutoDetect">@Loc["panel_mcp.http_mode_auto"]</option>
                                <option value="@McpHttpMode.StreamableHttp">@Loc["panel_mcp.http_mode_streamable"]</option>
                                <option value="@McpHttpMode.Sse">@Loc["panel_mcp.http_mode_sse"]</option>
                            </select>
                            <p class="cfg-field-hint">@Loc["panel_mcp.http_mode_hint"]</p>
                        </div>
                        <div class="cfg-field cfg-span-12">
                            <label class="su-label">@Loc["panel_mcp.headers"]</label>
                            <textarea class="su-input cfg-textarea" rows="3" @bind="endpoint.HeadersText"
                                      placeholder="Authorization: Bearer ..."></textarea>
                        </div>
                    }

                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["panel_mcp.init_timeout"]</label>
                        <input type="number" class="su-input" @bind="endpoint.InitializationTimeoutSeconds" />
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_mcp.log_level"]</label>
                        <select class="su-select" @bind="endpoint.LogLevel">
                            <option value="@McpLogLevel.Off">@Loc["panel_mcp.log_level_off"]</option>
                            <option value="@McpLogLevel.Error">@Loc["panel_mcp.log_level_error"]</option>
                            <option value="@McpLogLevel.Info">@Loc["panel_mcp.log_level_info"]</option>
                            <option value="@McpLogLevel.Debug">@Loc["panel_mcp.log_level_debug"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["panel_mcp.log_level_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-5">
                        <label class="su-label">@Loc["panel_mcp.protocol_mode"]</label>
                        <select class="su-select" @bind="endpoint.ProtocolMode">
                            <option value="@McpProtocolMode.Legacy">@Loc["panel_mcp.protocol_legacy"]</option>
                            <option value="@McpProtocolMode.Auto">@Loc["panel_mcp.protocol_auto"]</option>
                            <option value="@McpProtocolMode.Modern">@Loc["panel_mcp.protocol_modern"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["panel_mcp.protocol_mode_hint"]</p>
                    </div>
                </div>

                @if (probing)
                {
                    <div class="cfg-note">
                        <i class="bi bi-hourglass-split"></i>
                        <span>@Loc["panel_mcp.probing"]</span>
                    </div>
                }
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-broadcast"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_mcp.exposure"]</h3>
                        <p>@Loc["mcp_config.exposure_desc"]</p>
                    </div>
                </div>

                <div class="cfg-toggle-row">
                    <label class="cfg-toggle">
                        <input type="checkbox" @bind="endpoint.ExposeTools" />
                        <span>@Loc["panel_mcp.expose_tools"]</span>
                    </label>
                    <label class="cfg-toggle">
                        <input type="checkbox" @bind="endpoint.ToolsEnabledByDefault" />
                        <span>@Loc["mcp_config.tools_default"]</span>
                    </label>
                    <label class="cfg-toggle">
                        <input type="checkbox" @bind="endpoint.ExposeResourceReadTool" />
                        <span>@Loc["panel_mcp.expose_resource_tool"]</span>
                    </label>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["panel_mcp.resource_injection"]</label>
                        <select class="su-select" @bind="endpoint.ResourceInjection">
                            <option value="@McpResourceInjection.Off">@Loc["panel_mcp.resource_off"]</option>
                            <option value="@McpResourceInjection.Selected">@Loc["panel_mcp.resource_selected"]</option>
                            <option value="@McpResourceInjection.All">@Loc["panel_mcp.resource_all"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["panel_mcp.resource_injection_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["panel_mcp.budget"]</label>
                        <input type="number" class="su-input" @bind="endpoint.ResourceCharBudget" />
                    </div>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-6">
                        <label class="su-label">@Loc["panel_mcp.image_output_processing"]</label>
                        <select class="su-select" @bind="endpoint.ImageOutputMode">
                            <option value="@ToolImageOutputProcessing.FollowGlobal">@Loc["panel_mcp.image_output_follow_global"]</option>
                            <option value="@ToolImageOutputProcessing.Original">@Loc["panel_mcp.image_output_original"]</option>
                            <option value="@ToolImageOutputProcessing.Custom">@Loc["panel_mcp.image_output_custom"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["panel_mcp.image_output_processing_hint"]</p>
                    </div>
                    @if (endpoint.ImageOutputMode == ToolImageOutputProcessing.Custom)
                    {
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_mcp.image_output_budget"]</label>
                            <input type="number" class="su-input" @bind="endpoint.ImageOutputPixelBudget" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_mcp.image_output_compression"]</label>
                            <select class="su-select" @bind="endpoint.ImageOutputCompression">
                                <option value="@ImageCompressionAlgorithm.None">@Loc["panel_mcp.image_output_scale_only"]</option>
                                <option value="@ImageCompressionAlgorithm.WebP">@Loc["panel_mcp.image_output_webp"]</option>
                                <option value="@ImageCompressionAlgorithm.Jpeg">@Loc["panel_mcp.image_output_jpeg"]</option>
                            </select>
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="su-label">@Loc["panel_mcp.image_output_quality"]</label>
                            <input type="number" class="su-input" @bind="endpoint.ImageOutputQuality" />
                        </div>
                        <div class="cfg-field cfg-span-3">
                            <label class="cfg-toggle">
                                <input type="checkbox" @bind="endpoint.ImageOutputAlwaysReencode" />
                                <span>@Loc["panel_mcp.image_output_always_reencode"]</span>
                            </label>
                        </div>
                    }
                </div>

                @if (_inventories.TryGetValue(endpoint.RefKey, out var inventory))
                {
                    <div class="cfg-action-row">
                        <button type="button" class="su-btn su-btn-secondary su-btn-sm"
                                @onclick="() => RebuildInventory(endpoint)" disabled="@probing">
                            <i class="bi bi-arrow-repeat"></i> @Loc["mcp_config.rebuild_inventory"]
                        </button>
                    </div>

                    <div class="cfg-subsection">
                        <h4>@Loc.Format("panel_mcp.tools_found", inventory.Tools.Count)</h4>
                        @if (inventory.Tools.Count == 0)
                        {
                            <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_tools"]</p>
                        }
                        else
                        {
                            <div class="cfg-scroll-list">
                                @foreach (var tool in inventory.Tools)
                                {
                                    var t = tool;
                                    <label class="cfg-check-row">
                                        <input type="checkbox" checked="@endpoint.IsToolEnabled(t.Name)"
                                               @onchange="e => ToggleTool(endpoint, t.Name, e)" />
                                        <span>
                                            <strong>@t.Name</strong>
                                            @if (t.ReadOnlyHint == true)
                                            {
                                                <span class="su-badge">@Loc["panel_mcp.readonly"]</span>
                                            }
                                            @if (t.DestructiveHint == true)
                                            {
                                                <span class="su-badge su-badge-danger">@Loc["panel_mcp.destructive"]</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(t.Description))
                                            {
                                                <span class="cfg-check-desc">@t.Description</span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                    </div>

                    <div class="cfg-subsection">
                        <h4>@Loc.Format("panel_mcp.resources_found", inventory.Resources.Count)</h4>
                        @if (inventory.Resources.Count == 0)
                        {
                            <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_resources"]</p>
                        }
                        else
                        {
                            <div class="cfg-scroll-list">
                                @foreach (var resource in inventory.Resources)
                                {
                                    var r = resource;
                                    <label class="cfg-check-row">
                                        <input type="checkbox" checked="@endpoint.IsResourceEnabled(r.Uri)"
                                               @onchange="e => ToggleResource(endpoint, r.Uri, e)" />
                                        <span>
                                            <strong>@r.Name</strong>
                                            <span class="cfg-check-desc">@r.Uri</span>
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                    </div>

                    <div class="cfg-subsection">
                        <h4>@Loc.Format("panel_mcp.prompts_found", inventory.Prompts.Count)</h4>
                        @if (inventory.Prompts.Count == 0)
                        {
                            <p class="su-text-sm su-text-2">@Loc["panel_mcp.no_prompts"]</p>
                        }
                        else
                        {
                            @foreach (var prompt in inventory.Prompts)
                            {
                                <div class="cfg-check-row cfg-check-row-static">
                                    <i class="bi bi-chat-left-text"></i>
                                    <span>
                                        <strong>@prompt.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(prompt.Description))
                                        {
                                            <span class="cfg-check-desc">@prompt.Description</span>
                                        }
                                        @if (prompt.Arguments.Count > 0)
                                        {
                                            <span class="cfg-check-desc">
                                                @Loc.Format("panel_mcp.prompt_args",
                                                    string.Join(", ", prompt.Arguments.Select(a => a.Required ? a.Name + "*" : a.Name)))
                                            </span>
                                        }
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="cfg-note">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>@Loc["panel_mcp.probe_to_enumerate"]</span>
                    </p>
                }
            </section>
        }
    </Body>

    <EmptyState>
        <div class="cfg-empty">
            <span class="cfg-empty-icon"><i class="bi bi-plug"></i></span>
            <h2>@Loc["mcp_config.empty_title"]</h2>
            <p>@Loc["mcp_config.empty_desc"]</p>
            <button type="button" class="su-btn su-btn-primary" @onclick="AddEndpoint">
                <i class="bi bi-plus-lg"></i> @Loc["panel_mcp.add"]
            </button>
        </div>
    </EmptyState>
</ConfigShell>

@code {
    private List<EditorModel> _endpoints = [];
    private string? _selectedId;
    private string? _loadError;
    private string? _savedSnapshot;
    private string _statusText = string.Empty;
    private string _statusKind = "info";

    // 测试结果与能力清单按稳定 Key 缓存：修改端点 Id 后仍能复用，不需要重新探测。
    private readonly Dictionary<string, ProbeResult> _probeResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, Inventory> _inventories = new(StringComparer.OrdinalIgnoreCase);

    private string? _probingEndpointKey;
    private string? _editingIdKey;
    private string _idDraft = "";

    private static readonly JsonSerializerOptions _snapshotOptions = new() { WriteIndented = false };

    private EditorModel? Current =>
        _endpoints.FirstOrDefault(e => string.Equals(e.Id, _selectedId, StringComparison.OrdinalIgnoreCase));

    private bool IsDirty => _loadError == null && Snapshot() != _savedSnapshot;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        CancelIdEdit();
        try
        {
            _endpoints = McpEndpointCatalog.Load(KVData).Select(EditorModel.From).ToList();
            _probeResults.Clear();
            _inventories.Clear();
            _loadError = null;
            _selectedId = _endpoints.FirstOrDefault()?.Id;
            _savedSnapshot = Snapshot();
            _statusText = string.Empty;
        }
        catch (McpConfigException ex)
        {
            _endpoints = [];
            _selectedId = null;
            _savedSnapshot = null;
            _loadError = Loc.Format("panel_mcp.load_failed", ex.Message);
            SetStatus(_loadError, "error");
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger<McpToolsetPage>().LogError(ex, "加载 MCP 端点配置失败");
            _endpoints = [];
            _selectedId = null;
            _savedSnapshot = null;
            _loadError = Loc.Format("panel_mcp.load_failed", ex.Message);
            SetStatus(_loadError, "error");
        }
    }

    private string Snapshot() => JsonSerializer.Serialize(_endpoints.Select(e => e.ToConfig()), _snapshotOptions);

    private async Task AddEndpoint()
    {
        var name = NextName(Loc["panel_mcp.default_name"]);
        var config = McpEndpointCatalog.CreateNew(name, _endpoints.Select(e => e.ToConfig()));
        _endpoints.Add(EditorModel.From(config));
        _selectedId = config.Id;
        SetStatus(Loc.Format("config_ui.created", config.Name), "info");
        await Task.CompletedTask;
    }

    private async Task CloneEndpoint()
    {
        if (Current is not { } source) return;

        var existing = _endpoints.Select(e => e.ToConfig()).ToList();

        var copy = McpEndpointCatalog.Clone(source.ToConfig());
        copy.Name = NextName($"{DisplayName(source)} {Loc["config_ui.copy_suffix"]}");
        copy.Id = McpEndpointCatalog.CreateUniqueId(copy.Name, existing);
        // 克隆必须换一个新的稳定引用键：否则两个端点会争抢同一批节点引用。
        copy.Key = McpEndpointCatalog.CreateReferenceKey(copy.Name, existing);

        var index = _endpoints.IndexOf(source);
        _endpoints.Insert(index + 1, EditorModel.From(copy));
        _selectedId = copy.Id;
        SetStatus(Loc.Format("config_ui.cloned", copy.Name), "info");
        await Task.CompletedTask;
    }

    private async Task RenameEndpoint(string name)
    {
        if (Current is not { } endpoint) return;
        endpoint.Name = name;
        SetStatus(Loc.Format("config_ui.renamed", endpoint.Name), "info");
        await Task.CompletedTask;
    }

    private void BeginIdEdit(EditorModel endpoint)
    {
        _editingIdKey = endpoint.RefKey;
        _idDraft = endpoint.Id;
    }

    private void CancelIdEdit()
    {
        _editingIdKey = null;
        _idDraft = string.Empty;
    }

    private void OnIdDraftKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.Ordinal))
            ApplyIdEdit();
        else if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
            CancelIdEdit();
    }

    /// <summary>
    /// 修改用户可见 ID。只校验本地可判定项；节点引用走稳定 Key，因此这里不会改动任何节点数据。
    /// </summary>
    private void ApplyIdEdit()
    {
        if (Current is not { } endpoint || _editingIdKey != endpoint.RefKey) return;

        var newId = _idDraft.Trim();

        if (string.IsNullOrWhiteSpace(newId))
        {
            SetStatus(Loc["mcp_err.id_required"], "error");
            return;
        }

        if (newId.Any(c => !(char.IsLetterOrDigit(c) || c == '_')))
        {
            SetStatus(Loc["mcp_err.id_charset"], "error");
            return;
        }

        if (string.Equals(newId, endpoint.Id, StringComparison.Ordinal))
        {
            CancelIdEdit();
            return;
        }

        // Id 与所有端点的 Key 共享命名空间：改名后仍要保证 Find 只有一个解析结果。
        var conflict = _endpoints.FirstOrDefault(e =>
            e.RefKey != endpoint.RefKey &&
            (string.Equals(e.Id, newId, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(e.RefKey, newId, StringComparison.OrdinalIgnoreCase)));

        if (conflict != null)
        {
            SetStatus(Loc.Format("mcp_err.ref_duplicate", newId), "error");
            return;
        }

        var oldId = endpoint.Id;
        endpoint.Id = newId;
        _selectedId = newId;   // 列表选择按 Id 跟踪，改名后同步，避免编辑区消失。
        CancelIdEdit();
        SetStatus(Loc.Format("mcp_config.id_changed", oldId, newId), "info");
    }

    private async Task RemoveEndpoint()
    {
        if (Current is not { } endpoint) return;

        var index = _endpoints.IndexOf(endpoint);
        _endpoints.Remove(endpoint);
        _probeResults.Remove(endpoint.RefKey);
        _inventories.Remove(endpoint.RefKey);
        _selectedId = _endpoints.Count == 0 ? null : _endpoints[Math.Min(index, _endpoints.Count - 1)].Id;
        SetStatus(Loc.Format("config_ui.deleted_pending", DisplayName(endpoint)), "info");
        await Task.CompletedTask;
    }

    private async Task TogglePin(EditorModel endpoint)
    {
        endpoint.Pinned = !endpoint.Pinned;
        SetStatus(Loc.Format(endpoint.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(endpoint)), "info");
        await Task.CompletedTask;
    }

    private async Task SelectEndpoint(string id)
    {
        _selectedId = id;
        CancelIdEdit();
        await Task.CompletedTask;
    }

    private async Task SaveAll()
    {
        if (_loadError != null) return;

        // 保存时先落定正在编辑的 ID；若草稿非法则停在编辑态并报告，不保存半成品。
        if (_editingIdKey != null)
        {
            ApplyIdEdit();
            if (_editingIdKey != null) return;
        }

        var configs = _endpoints.Select(e => e.ToConfig()).ToList();
        var errors = new List<string>();

        foreach (var config in configs)
            errors.AddRange(McpEndpointCatalog.Validate(config, Loc).Select(msg => $"[{config.Name}] {msg}"));

        // Id 用于工具名前缀，Key 用于节点引用；两者共享同一命名空间，
        // 任一重名都会让 Find 产生歧义，因此一起检查。
        var duplicates = McpEndpointCatalog.FindReferenceCollisions(configs);
        errors.AddRange(duplicates.Select(id => Loc.Format("mcp_err.ref_duplicate", id)));

        if (errors.Count > 0)
        {
            SetStatus(string.Join(" | ", errors), "error");
            return;
        }

        try
        {
            McpEndpointCatalog.Save(KVData, configs);
            _savedSnapshot = Snapshot();
            McpRegistry.Instance.InvalidateAll();
            SetStatus(Loc.Format("panel_mcp.saved", configs.Count), "success");
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger<McpToolsetPage>().LogError(ex, "保存 MCP 端点配置失败");
            SetStatus(Loc.Format("panel_mcp.save_failed", ex.Message), "error");
        }

        await Task.CompletedTask;
    }

    private async Task ProbeCurrentAsync()
    {
        if (Current is not { } endpoint) return;
        await ProbeAsync(endpoint);
    }

    private async Task ProbeAsync(EditorModel endpoint)
    {
        _probingEndpointKey = endpoint.RefKey;
        _probeResults.Remove(endpoint.RefKey);
        _inventories.Remove(endpoint.RefKey);
        StateHasChanged();

        var config = endpoint.ToConfig();
        var errors = McpEndpointCatalog.Validate(config, Loc);
        if (errors.Count > 0)
        {
            _probeResults[endpoint.RefKey] = new ProbeResult(false, null, null, 0, 0, 0, false, null, string.Join(" | ", errors));
            _probingEndpointKey = null;
            SetStatus(string.Join(" | ", errors), "error");
            return;
        }

        McpEndpointSession? session = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(Math.Max(5, config.InitializationTimeoutSeconds + 15)));
            session = await McpEndpointSession.ConnectAsync(config, LoggerFactory, cts.Token);

            var tools = McpDescriptorFactory.Tools(await session.GetToolsAsync(cts.Token));
            var resources = McpDescriptorFactory.Resources(await session.GetResourcesAsync(cts.Token));
            var prompts = McpDescriptorFactory.Prompts(await session.GetPromptsAsync(cts.Token));

            _inventories[endpoint.RefKey] = new Inventory(tools, resources, prompts);
            _probeResults[endpoint.RefKey] = new ProbeResult(
                true,
                session.ServerInfo?.Name,
                session.Client.NegotiatedProtocolVersion?.ToString(),
                tools.Count, resources.Count, prompts.Count,
                false,
                session.ServerInstructions,
                null);

            foreach (var tool in tools)
                if (endpoint.Tools.All(t => !string.Equals(t.Name, tool.Name, StringComparison.Ordinal)))
                    endpoint.Tools.Add(new McpNamedToggle { Name = tool.Name, Enabled = endpoint.ToolsEnabledByDefault });

            foreach (var resource in resources)
                if (endpoint.Resources.All(r => !string.Equals(r.Name, resource.Uri, StringComparison.Ordinal)))
                    endpoint.Resources.Add(new McpNamedToggle { Name = resource.Uri, Enabled = endpoint.ResourceInjection == McpResourceInjection.All });

            SetStatus(Loc.Format("panel_mcp.probe_summary", config.Name, tools.Count, resources.Count, prompts.Count), "success");
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger<McpToolsetPage>().LogError(ex, "探测 MCP 端点 {EndpointId} 失败", config.Id);
            _probeResults[endpoint.RefKey] = new ProbeResult(false, null, null, 0, 0, 0, false, null, ex.Message);
            SetStatus(Loc.Format("panel_mcp.probe_error", config.Name, ex.Message), "error");
        }
        finally
        {
            if (session != null)
            {
                try
                {
                    await session.DisposeAsync();
                }
                catch (Exception ex)
                {
                    LoggerFactory.CreateLogger<McpToolsetPage>().LogError(ex, "释放 MCP 探测会话失败");
                    SetStatus(Loc.Format("panel_mcp.dispose_failed", ex.Message), "error");
                }
            }

            _probingEndpointKey = null;
            StateHasChanged();
        }
    }

    private async Task RebuildInventory(EditorModel endpoint)
    {
        await ProbeAsync(endpoint);
    }

    private async Task CopyNodeJson()
    {
        if (Current is not { } endpoint) return;

        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", endpoint.RefKey);
            SetStatus(Loc.Format("panel_mcp.node_hint", endpoint.RefKey), "success");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or InvalidOperationException)
        {
            SetStatus(Loc.Format("config_ui.toast_copy_failed", ex.Message), "error");
        }
