@attribute [PluginPanel("panel.sub_agent_config", "panel.sub_agent_config.desc", PanelDisplayPlace.Settings)]

@using Newtonsoft.Json
@using ShimmerChatBuiltin.NodeBasic.PostGeneration
@using ShimmerChatBuiltin.NodeBasic.PreGeneration
@using ShimmerChatBuiltin.SubAgent
@using ShimmerChatLib.Components
@using ShimmerChatLib.Generation
@using ShimmerChatLib.Interface
@using System.Text.Json
@inject IKVDataService pluginData
@inject IPreGenerationNodeSerializer Serializer
@inject IPostGenerationNodeSerializerService PostSerializer
@inject ILocService Loc
@inject INodeTypeCatalog NodeTypeCatalog
@inject IMessageStoreService MessageStore
@inject IPanelDraftStore PanelDrafts
@inject NavigationManager Navigation
@inject ILogger<SubAgentConfigurationPanel> Logger

<ConfigShell T="SubAgentConfig"
            Items="_configs"
            SelectedId="@_selectedId"
            IdSelector="@(c => c.Guid.ToString("D"))"
            NameSelector="@(c => c.Name)"
            TypeSelector="@(c => GetPresetName(c))"
            MetaSelector="@(c => GetOutputModeLabel(c.OutputMode))"
            SearchSelector="@(c => $"{c.ModifierPresetId} {c.OutputMode} {c.Guid}")"
            PinSelector="@(c => c.Pinned)"
            Title="@Loc["panel_subagent.title"]"
            Description="@Loc["panel_subagent.desc"]"
            Icon="bi-robot"
            IsDirty="IsDirty"
            LoadError="@_loadError"
            StatusMessage="@_statusText"
            StatusKind="@_statusKind"
            OnCreate="CreateConfig"
            OnSave="SaveAll"
            OnSelect="SelectConfig"
            OnClone="CloneConfig"
            OnRename="RenameConfig"
            OnDelete="DeleteConfig"
            OnTogglePin="TogglePin"
            OnRetry="Reload">
    <ToolbarExtras>
        <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-btn"
                @onclick="OpenSessions"
                title="@Loc["panel_subagent.sessions"]" aria-label="@Loc["panel_subagent.sessions"]">
            <i class="bi bi-clock-history"></i>
            <span class="cfg-btn-label">@Loc["panel_subagent.sessions"]</span>
        </button>
    </ToolbarExtras>
    <Body>
        @if (Current is { } config)
        {
            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-info-circle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["subagent_config.basic"]</h3>
                        <p>@Loc["subagent_config.basic_desc"]</p>
                    </div>
                </div>

                <div class="cfg-grid">
                    <div class="cfg-field cfg-span-5">
                        <label class="su-label">@Loc["panel_subagent.label_name"]</label>
                        <input class="su-input" @bind="config.Name" />
                        <p class="cfg-field-hint">@Loc["subagent_config.name_hint"]</p>
                    </div>
                    <div class="cfg-field cfg-span-4">
                        <label class="su-label">@Loc["panel_subagent.label_output_mode"]</label>
                        <select class="su-select" @bind="config.OutputMode">
                            <option value="LastMessage">@Loc["panel_subagent.output_last_msg"]</option>
                            <option value="FullJson">@Loc["panel_subagent.output_full_json"]</option>
                            <option value="None">@Loc["panel_subagent.output_none"]</option>
                        </select>
                        <p class="cfg-field-hint">@Loc["panel_subagent.output_help"]</p>
                    </div>
                    <div class="cfg-field cfg-span-3">
                        <label class="su-label">@Loc["subagent_config.id"]</label>
                        <div class="cfg-readonly-row">
                            <code title="@config.Guid.ToString("D")">@config.Guid.ToString("D")</code>
                        </div>
                        <p class="cfg-field-hint">@Loc["subagent_config.id_hint"]</p>
                    </div>
                </div>
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-diagram-3"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_subagent.modifier_tree"]</h3>
                        <p>@Loc["subagent_config.pre_tree_desc"]</p>
                    </div>
                </div>

                @if (config.UseSharedPreset)
                {
                    <div class="cfg-status is-info" role="status">
                        <i class="bi bi-collection"></i>
                        @Loc["panel_subagent.using_preset"] — @Loc["panel_subagent.select_preset_hint"]
                    </div>
                    <div class="cfg-inline">
                        <select class="su-select" @bind="config.ModifierPresetId">
                            <option value="">@Loc["panel_subagent.none_option"]</option>
                            @foreach (var preset in GetPresets())
                            {
                                <option value="@preset.Id">@preset.Name</option>
                            }
                        </select>
                        <button type="button" class="su-btn su-btn-secondary su-btn-sm" @onclick="CreatePrivateTree">
                            <i class="bi bi-pencil"></i> @Loc["panel_subagent.create_private_tree"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="cfg-inline">
                        @if (!string.IsNullOrEmpty(config.ModifierTreeJson))
                        {
                            <span class="su-badge su-badge-secondary">@Loc["panel_subagent.private_tree"]</span>
                            <button type="button" class="su-btn su-btn-secondary su-btn-sm" @onclick="RevertToPreset">
                                <i class="bi bi-arrow-counterclockwise"></i> @Loc["panel_subagent.revert_to_preset"]
                            </button>
                            <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn is-danger"
                                    @onclick="ClearPrivateTree" title="@Loc["panel_subagent.clear_private_tree"]">
                                <i class="bi bi-trash3"></i>
                            </button>
                        }
                        else
                        {
                            <span class="su-badge su-badge-secondary">@Loc["panel_subagent.minimal"]</span>
                            <span class="cfg-field-hint">@Loc["panel_subagent.minimal_hint"]</span>
                            <button type="button" class="su-btn su-btn-secondary su-btn-sm" @onclick="CreatePrivateTree">
                                <i class="bi bi-pencil"></i> @Loc["panel_subagent.create_private_tree"]
                            </button>
                        }
                    </div>
                    @if (_editingTree != null)
                    {
                        <div class="tree-editor-container">
                            <CascadingValue Value="_dragContext">
                                <CascadingValue Value="_preEditorContext">
                                    <TreeEditor Node="@_editingTree" />
                                </CascadingValue>
                            </CascadingValue>
                        </div>
                    }
                }
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-arrow-repeat"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_subagent.post_tree"]</h3>
                        <p>@Loc["panel_subagent.post_tree_hint"]</p>
                    </div>
                </div>

                <div class="cfg-inline">
                    @if (_editingPostTree != null)
                    {
                        <span class="su-badge su-badge-secondary">@Loc["panel_subagent.private_tree"]</span>
                        <span class="cfg-field-hint">@Loc["panel_subagent.post_tree_private_hint"]</span>
                        <button type="button" class="su-btn su-btn-secondary su-btn-sm cfg-icon-btn is-danger"
                                @onclick="ClearPrivatePostTree" title="@Loc["panel_subagent.clear_private_tree"]">
                            <i class="bi bi-trash3"></i>
                        </button>
                    }
                    else
                    {
                        <span class="su-badge su-badge-secondary">@Loc["panel_subagent.minimal"]</span>
                        <span class="cfg-field-hint">@Loc["panel_subagent.post_tree_minimal_hint"]</span>
                        <button type="button" class="su-btn su-btn-secondary su-btn-sm" @onclick="CreatePrivatePostTree">
                            <i class="bi bi-pencil"></i> @Loc["panel_subagent.create_private_post_tree"]
                        </button>
                    }
                </div>

                @if (_editingPostTree != null)
                {
                    <div class="tree-editor-container">
                        <CascadingValue Value="_postDragContext">
                            <CascadingValue Value="_postEditorContext">
                                <TreeEditor Node="@_editingPostTree" />
                            </CascadingValue>
                        </CascadingValue>
                    </div>
                }
            </section>

            <section class="cfg-section">
                <div class="cfg-section-head">
                    <span class="cfg-section-icon"><i class="bi bi-puzzle"></i></span>
                    <div class="cfg-section-title">
                        <h3>@Loc["panel_subagent.plugins"]</h3>
                        <p>@Loc["subagent_config.plugins_desc"]</p>
                    </div>
                </div>
                <PluginPanelContainer
                    PanelDisplayPlace="PanelDisplayPlace.Agent"
                    Parameters="SubAgentPluginParameters" />
            </section>
        }
    </Body>

    <EmptyState>
        <div class="cfg-empty">
            <span class="cfg-empty-icon"><i class="bi bi-robot"></i></span>
            <h2>@Loc["subagent_config.empty_title"]</h2>
            <p>@Loc["subagent_config.empty_desc"]</p>
            <button type="button" class="su-btn su-btn-primary" @onclick="CreateConfig">
                <i class="bi bi-plus-lg"></i> @Loc["panel_subagent.create"]
            </button>
        </div>
    </EmptyState>
</ConfigShell>

@code {
    private const string Space = "SubAgent";
    private const string Key = "configs";

    private List<SubAgentConfig> _configs = [];
    private string? _selectedId;
    private string? _loadError;
    private string? _savedSnapshot;
    private string _statusText = string.Empty;
    private string _statusKind = "info";

    private IPreGenerationNode? _editingTree;
    private IPostGenerationNode? _editingPostTree;
    private TreeDragContext _dragContext = new();
    private TreeDragContext _postDragContext = new();
    private TreeEditorContext _preEditorContext = default!;
    private TreeEditorContext _postEditorContext = default!;

    private static readonly JsonSerializerSettings _configSerializerSettings = new()
    {
        TypeNameHandling = TypeNameHandling.Auto
    };

    private static readonly JsonSerializerOptions _snapshotOptions = new() { WriteIndented = false };

    private SubAgentConfig? Current =>
        _configs.FirstOrDefault(c => string.Equals(c.Guid.ToString("D"), _selectedId, StringComparison.Ordinal));

    private bool IsDirty
    {
        get
        {
            if (_loadError != null) return false;
            CommitEditingTrees();
            return Snapshot() != _savedSnapshot;
        }
    }

    protected override void OnInitialized()
    {
        _preEditorContext = new TreeEditorContext(Serializer, NodeTypeCatalog, typeof(IPreGenerationNode));
        _postEditorContext = new TreeEditorContext(PostSerializer, NodeTypeCatalog, typeof(IPostGenerationNode));
        Reload();
    }

    private void Reload()
    {
        var json = pluginData.Read(Space, Key);

        try
        {
            _configs = string.IsNullOrEmpty(json)
                ? []
                : JsonConvert.DeserializeObject<List<SubAgentConfig>>(json, _configSerializerSettings) ?? [];
            _loadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "子智能体配置包含无法识别的类型信息，尝试按旧格式读取");
            try
            {
                _configs = string.IsNullOrEmpty(json)
                    ? []
                    : JsonConvert.DeserializeObject<List<SubAgentConfig>>(json) ?? [];
                _loadError = null;
            }
            catch (Exception legacyEx)
            {
                Logger.LogError(legacyEx, "加载子智能体配置失败");
                _loadError = Loc.Format("subagent_config.load_failed", legacyEx.Message);
                _configs = [];
            }
        }

        _selectedId = _configs.FirstOrDefault()?.Guid.ToString("D");
        LoadEditingTree();
        CommitEditingTrees();
        _savedSnapshot = _loadError == null ? Snapshot() : null;
    }

    private string Snapshot() =>
        JsonConvert.SerializeObject(_configs, Formatting.None, _configSerializerSettings);

    private void CommitEditingTrees()
    {
        if (Current is not { } config) return;

        if (_editingTree != null)
            config.ModifierTreeJson = Serializer.Serialize(_editingTree);

        if (_editingPostTree != null)
            config.PostGenerationTreeJson = PostSerializer.Serialize(_editingPostTree);
    }

    private void LoadEditingTree()
    {
        if (Current is { } config && !config.UseSharedPreset && !string.IsNullOrEmpty(config.ModifierTreeJson))
        {
            _editingTree = Serializer.Deserialize(config.ModifierTreeJson)
                ?? new SequenceNode { Name = config.Name };
        }
        else
        {
            _editingTree = null;
        }

        if (Current is { } postConfig && !string.IsNullOrEmpty(postConfig.PostGenerationTreeJson))
        {
            _editingPostTree = PostSerializer.Deserialize(postConfig.PostGenerationTreeJson)
                as IPostGenerationNode;
        }
        else
        {
            _editingPostTree = null;
        }
    }

    private async Task SaveAll()
    {
        if (_loadError != null) return;

        if (_configs.Any(c => string.IsNullOrWhiteSpace(c.Name)))
        {
            SetStatus(Loc["subagent_config.name_required"], "error");
            return;
        }

        try
        {
            CommitEditingTrees();
            var json = JsonConvert.SerializeObject(_configs, Formatting.Indented, _configSerializerSettings);
            pluginData.Write(Space, Key, json);
            _savedSnapshot = Snapshot();
            SetStatus(Loc["panel_subagent.msg_saved"], "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "保存子智能体配置失败");
            SetStatus(Loc.Format("panel_subagent.msg_save_failed", ex.Message), "error");
        }

        await Task.CompletedTask;
    }

    private async Task CreateConfig()
    {
        var config = new SubAgentConfig { Name = NextName(Loc["panel_subagent.create"]) };
        _configs.Add(config);
        SelectConfig(config.Guid.ToString("D"));
        SetStatus(Loc.Format("config_ui.created", config.Name), "info");
        await Task.CompletedTask;
    }

    private async Task CloneConfig()
    {
        if (Current is not { } source) return;

        var copy = source.Clone();
        copy.Guid = Guid.NewGuid();
        copy.Name = NextName($"{DisplayName(source)} {Loc["config_ui.copy_suffix"]}");

        var index = _configs.IndexOf(source);
        _configs.Insert(index + 1, copy);
        SelectConfig(copy.Guid.ToString("D"));
        SetStatus(Loc.Format("config_ui.cloned", copy.Name), "info");
        await Task.CompletedTask;
    }

    private async Task RenameConfig(string name)
    {
        if (Current is not { } config) return;

        config.Name = name;
        SetStatus(Loc.Format("config_ui.renamed", config.Name), "info");
        await Task.CompletedTask;
    }

    private async Task DeleteConfig()
    {
        if (Current is not { } config) return;

        var index = _configs.IndexOf(config);
        _configs.Remove(config);
        _selectedId = _configs.Count == 0
            ? null
            : _configs[Math.Min(index, _configs.Count - 1)].Guid.ToString("D");
        LoadEditingTree();
        SetStatus(Loc.Format("config_ui.deleted_pending", DisplayName(config)), "info");
        await Task.CompletedTask;
    }

    private async Task TogglePin(SubAgentConfig config)
    {
        config.Pinned = !config.Pinned;
        SetStatus(Loc.Format(config.Pinned ? "config_ui.pinned" : "config_ui.unpinned", DisplayName(config)), "info");
        await Task.CompletedTask;
    }

    private async Task SelectConfig(string id)
    {
        CommitEditingTrees();
        _selectedId = id;
        LoadEditingTree();
        await Task.CompletedTask;
    }

    private void OpenSessions()
    {
        Navigation.NavigateTo("/pluginpanel/panel.sub_agent_sessions");
    }

    private void CreatePrivateTree()
    {
        if (Current is not { } config) return;

        var root = new SequenceNode
        {
            Name = $"{config.Name} Private Tree",
            Nodes = new List<IPreGenerationNode>()
        };

        if (!string.IsNullOrEmpty(config.ModifierPresetId))
        {
            var preset = GetPresets().FirstOrDefault(p => p.Id == config.ModifierPresetId);
            root.Nodes.Add(new CallNode
            {
                Name = preset?.Name ?? "Preset",
                PresetId = config.ModifierPresetId
            });
        }

        config.ModifierTreeJson = Serializer.Serialize(root);
        config.UseSharedPreset = false;
        _editingTree = root;
    }

    private void RevertToPreset()
    {
        if (Current is not { } config) return;
        config.UseSharedPreset = true;
        config.ModifierTreeJson = null;
        _editingTree = null;
    }

    private void ClearPrivateTree()
    {
        if (Current is not { } config) return;
        config.ModifierTreeJson = null;
        _editingTree = null;
    }

    private void CreatePrivatePostTree()
    {
        if (Current is not { } config) return;

        var root = new PostSequenceNode
        {
            Name = $"{config.Name} Post Tree",
            Children = new List<IPostGenerationNode>()
        };
        config.PostGenerationTreeJson = PostSerializer.Serialize(root);
        _editingPostTree = root;
    }

    private void ClearPrivatePostTree()
    {
        if (Current is not { } config) return;
        config.PostGenerationTreeJson = null;
        _editingPostTree = null;
    }

    private List<PreGenerationPreset> GetPresets()
    {
        var json = pluginData.Read("GenerationManager", "generation_presets");
        return string.IsNullOrEmpty(json)
            ? []
            : JsonConvert.DeserializeObject<List<PreGenerationPreset>>(json) ?? [];
    }

    private string GetPresetName(SubAgentConfig cfg)
    {
        if (!cfg.UseSharedPreset)
            return !string.IsNullOrEmpty(cfg.ModifierTreeJson)
                ? Loc["panel_subagent.private_tree"]
                : Loc["panel_subagent.minimal"];

        if (string.IsNullOrEmpty(cfg.ModifierPresetId))
            return Loc["panel_subagent.none_option_fallback"];

        var preset = GetPresets().FirstOrDefault(p => p.Id == cfg.ModifierPresetId);
        return preset?.Name ?? Loc["panel_subagent.none_option_fallback"];
    }

    private Dictionary<string, object> SubAgentPluginParameters => new()
    {
        ["AgentGuid"] = Current?.Guid ?? Guid.Empty,
        ["EventHandlerReg"] = (Action<IChatPanelEventHandler>)(handler => { }),
        ["PanelContext"] = SubAgentPanelContext!
    };

    private SubAgentPanelContext? SubAgentPanelContext
    {
        get
        {
            if (Current is not { } config) return null;

            if (_subAgentPanelContext != null && _subAgentPanelContext.Config.Guid == config.Guid)
                return _subAgentPanelContext;

            _subAgentPanelContext = new SubAgentPanelContext
            {
                TargetGuid = config.Guid,
                Config = config,
                MessageStore = MessageStore,
                DraftStore = PanelDrafts,
                RequestRefreshAsync = () => InvokeAsync(StateHasChanged),
                RegisterEventHandler = handler => { }
            };

            return _subAgentPanelContext;
        }
    }

    private SubAgentPanelContext? _subAgentPanelContext;

    private string GetOutputModeLabel(string mode) => mode switch
    {
        "FullJson" => Loc["panel_subagent.output_short_full"],
        "None" => Loc["panel_subagent.output_short_none"],
        _ => Loc["panel_subagent.output_short_last"]
    };

    private void SetStatus(string message, string kind)
    {
        _statusText = message;
        _statusKind = kind;
    }

    private string DisplayName(SubAgentConfig config) =>
        string.IsNullOrWhiteSpace(config.Name) ? Loc["config_ui.untitled"] : config.Name;

    private string NextName(string baseName)
    {
        var name = string.IsNullOrWhiteSpace(baseName) ? Loc["config_ui.new"] : baseName.Trim();
        var candidate = name;
        var suffix = 2;

        while (_configs.Any(c => string.Equals(c.Name, candidate, StringComparison.OrdinalIgnoreCase)))
            candidate = $"{name} ({suffix++})";

        return candidate;
    }
}
