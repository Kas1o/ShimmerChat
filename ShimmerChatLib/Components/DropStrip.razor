@* Reusable drop-zone strip for tree node lists.
   Place between child nodes to allow drag-and-drop insertion at a specific index.
   Usage in custom editors:
     <DropStrip TargetList="@myChildList" InsertIndex="0" />
     <TreeEditor Node="@child0" ParentList="@myChildList" ... />
     <DropStrip TargetList="@myChildList" InsertIndex="1" />
     ...
*@
@using System.Collections

<div class="tn-drop-strip @(_active ? "tn-drop-strip-active" : "")"
     @ondragover="OnDragOver" @ondragover:preventDefault
     @ondragleave="OnDragLeave" @ondrop="OnDrop">
</div>

@code {
    /// <summary>The list to insert into on drop (non-generic IList to support any ITreeNode list type).</summary>
    [Parameter] public required IList TargetList { get; set; }

    /// <summary>The index at which to insert the dragged node.</summary>
    [Parameter] public int InsertIndex { get; set; }

    /// <summary>
    /// Invoked after a successful drop commit, so the owning editor (e.g. ChildListEditor)
    /// re-renders. Without it the target list's contents changed but the parent is never
    /// notified and the newly dropped node stays invisible until the next manual refresh.
    /// </summary>
    [Parameter] public EventCallback OnDropCommitted { get; set; }

    [CascadingParameter] public TreeDragContext? DragContext { get; set; }

    private bool _active;

    private void OnDragOver(DragEventArgs e)
    {
        if (DragContext?.IsDragging != true) return;

        e.DataTransfer.DropEffect = "move";
        _active = true;
    }

    private void OnDragLeave()
    {
        _active = false;
    }

    private async Task OnDrop(DragEventArgs e)
    {
        _active = false;
        if (DragContext?.IsDragging != true) return;

        try
        {
            if (await DragContext.CommitDrop(TargetList, InsertIndex))
            {
                await OnDropCommitted.InvokeAsync();
            }
        }
        catch
        {
            DragContext?.EndDrag();
        }
    }
}
