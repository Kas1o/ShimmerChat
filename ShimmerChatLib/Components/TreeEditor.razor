@using System.Collections
@using System.Reflection
@using ShimmerChatLib.Generation
@inject ILocService Loc

@if (Node.Payload == null)
{
    <div class="tree-node-card @(Node.IsBypassed ? "tn-bypassed" : "")" style="border-left-color: var(--node-error, #d9534f);">
        <div class="tn-header @(_isDraggingSelf ? "tn-dragging" : "")"
             draggable="@(_isDraggable ? "true" : null)"
             @ondragstart="OnDragStart" @ondragend="OnDragEnd">
            <span class="tn-icon">⚠</span>
            <span class="tn-label">@Loc["tree_editor.payload_missing"]</span>
            <span class="tn-name" title="@Loc["tree_editor.payload_missing.hint"]">@Node.Name</span>
            <div class="tn-actions">
                <button class="tn-btn tn-btn-bypass @(Node.IsBypassed ? "is-active" : "")"
                        @onclick="ToggleBypass"
                        @onclick:stopPropagation="true"
                        title="@BypassButtonTitle">⊘</button>
                @if (CopyMe != null)
                {
                    <button class="tn-btn tn-btn-copy" @onclick="() => CopyMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.copy"]">📋</button>
                }
                @if (RemoveMe != null && Depth > 0)
                {
                    <button class="tn-btn tn-btn-del" @onclick="() => RemoveMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.remove"]">✕</button>
                }
            </div>
        </div>
        <div class="tn-body">
            <div class="tn-custom-editor-error">
                <span class="tn-error-icon">⚠</span>
                <span class="tn-error-msg">@Loc["tree_editor.payload_missing.hint"]</span>
            </div>
        </div>
    </div>
}
else if (_info == null)
{
    <div class="tree-node-card @(Node.IsBypassed ? "tn-bypassed" : "")" style="border-left-color: var(--node-debug);">
        <div class="tn-header @(_isDraggingSelf ? "tn-dragging" : "")"
             draggable="@(_isDraggable ? "true" : null)"
             @ondragstart="OnDragStart" @ondragend="OnDragEnd">
            <span class="tn-icon">●</span>
            <span class="tn-label">@Node.PayloadType.Name</span>
            <span class="tn-name">@Node.Name</span>
            <div class="tn-actions">
                <button class="tn-btn tn-btn-bypass @(Node.IsBypassed ? "is-active" : "")"
                        @onclick="ToggleBypass"
                        @onclick:stopPropagation="true"
                        title="@BypassButtonTitle">⊘</button>
                @if (CopyMe != null)
                {
                    <button class="tn-btn tn-btn-copy" @onclick="() => CopyMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.copy"]">📋</button>
                }
                @if (RemoveMe != null && Depth > 0)
                {
                    <button class="tn-btn tn-btn-del" @onclick="() => RemoveMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.remove"]">✕</button>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="tree-node-card @(Node.IsBypassed ? "tn-bypassed" : "")" style="border-left-color: @_info.Color;">
        <div class="tn-header @(_isDraggingSelf ? "tn-dragging" : "")"
             @onclick="ToggleExpand"
             draggable="@(_isDraggable ? "true" : null)"
             @ondragstart="OnDragStart" @ondragend="OnDragEnd">
            <span class="tn-icon">@_info.Icon</span>
            <span class="tn-label">@Loc[_info.LabelKey]</span>
            <input class="tn-name-input" @bind="Node.Name" @bind:event="oninput"
                   @onkeydown="OnNameKeyDown" @onclick:stopPropagation="true" placeholder="@Loc["tree_editor.name_placeholder"]" />
            <div class="tn-actions">
                <button class="tn-btn tn-btn-bypass @(Node.IsBypassed ? "is-active" : "")"
                        @onclick="ToggleBypass"
                        @onclick:stopPropagation="true"
                        title="@BypassButtonTitle">⊘</button>
                @if (CopyMe != null)
                {
                    <button class="tn-btn tn-btn-copy" @onclick="() => CopyMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.copy"]">📋</button>
                }
                @if (RemoveMe != null && Depth > 0)
                {
                    <button class="tn-btn tn-btn-del" @onclick="() => RemoveMe?.Invoke(Node)"
                            @onclick:stopPropagation="true" title="@Loc["tree_editor.remove"]">✕</button>
                }
            </div>
        </div>

        @if (Node.IsExpanded)
        {
            <div class="tn-body">
                @* Custom editor via [NodeEditor] *@
                @if (_customEditorType != null)
                {
                    <ErrorBoundary @key="@Node.Id">
                        <ChildContent>
                            <DynamicComponent Type="_customEditorType" Parameters="@_editorParams" @key="@Node.Id" />
                        </ChildContent>
                        <ErrorContent Context="ex">
                            <div class="tn-custom-editor-error" title="@ex?.ToString()">
                                <span class="tn-error-icon">⚠</span>
                                <span class="tn-error-msg">Editor error: @_customEditorType.Name — @ex?.Message</span>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                }
                else
                {
                    @* Auto-generated editor *@
                    <NodeBodyRenderer Node="@Node" Depth="@Depth"
                                      RemoveMe="RemoveMe"
                                      CopyMe="CopyMe" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public ITreeNode Node { get; set; } = default!;
    [Parameter] public int Depth { get; set; }
    [Parameter] public Action<ITreeNode>? RemoveMe { get; set; }
    [Parameter] public Action<ITreeNode>? CopyMe { get; set; }

    /// <summary>
    /// The parent list this node belongs to (non-generic IList). When set, the node becomes draggable.
    /// </summary>
    [Parameter] public IList? ParentList { get; set; }

    /// <summary>
    /// For single-node slots: called when this node is dragged away.
    /// </summary>
    [Parameter] public Func<Task>? OnDragRemove { get; set; }

    /// <summary>
    /// When this node is the source of a drag-drop, invoked after the node is
    /// removed from its parent list.
    /// </summary>
    [Parameter] public EventCallback OnDragSourceChanged { get; set; }

    [CascadingParameter] public TreeDragContext? DragContext { get; set; }

    private NodeInfoAttribute? _info;
    private Type? _customEditorType;
    private Dictionary<string, object> _editorParams = new();
    private bool _isDraggingSelf => DragContext?.DraggedNode == Node;
    private bool _isDraggable => (ParentList != null && Depth > 0) || OnDragRemove != null;

    /// <summary>旁路按钮提示语：未旁路时说明旁路效果，已旁路时说明如何恢复。</summary>
    private string BypassButtonTitle => Node.IsBypassed
        ? Loc["tree_editor.unbypass"]
        : Loc["tree_editor.bypass"];

    protected override void OnParametersSet()
    {
        var payloadType = Node.Payload?.GetType();
        _info = payloadType?.GetCustomAttribute<NodeInfoAttribute>();
        _customEditorType = payloadType?.GetCustomAttribute<NodeEditorAttribute>()?.EditorType;
        _editorParams = new Dictionary<string, object>
        {
            ["Node"] = Node.Payload!,
            ["Depth"] = Depth,
            ["CopyMe"] = CopyMe!
        };
    }

    private void ToggleExpand() => Node.IsExpanded = !Node.IsExpanded;

    /// <summary>
    /// 旁路开关写在包装器上，随节点树持久化；执行阶段由包装器短路，子树一并跳过。
    /// 三个分支（含负载缺失卡片）都提供开关，损坏节点可以先旁路再等插件恢复。
    /// </summary>
    private void ToggleBypass() => Node.IsBypassed = !Node.IsBypassed;

    private Task OnNameKeyDown(KeyboardEventArgs e)
    {
        return Task.CompletedTask;
    }

    // ─── Drag Source ───────────────────────────────────

    private async Task OnDragStart(DragEventArgs e)
    {
        if (DragContext == null || !_isDraggable) return;

        e.DataTransfer.EffectAllowed = "move";

        if (ParentList != null)
        {
            DragContext.BeginDrag(Node, ParentList, () => OnDragSourceChanged.InvokeAsync());
        }
        else if (OnDragRemove != null)
        {
            DragContext.BeginDrag(Node, OnDragRemove, () => OnDragSourceChanged.InvokeAsync());
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDragEnd(DragEventArgs e)
    {
        DragContext?.EndDrag();
        await InvokeAsync(StateHasChanged);
    }
}
