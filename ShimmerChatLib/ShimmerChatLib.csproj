<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	<LangVersion>Preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Locales\*.json" />
    <None Remove="Locales\*.json" />
    <EmbeddedResource Include="Locales\*.json">
      <!-- 文件名形如 {领域}.{culture}.json 会被 AssignCulture 当成附属资源分流到卫星程序集；
           显式标记非文化资源，确保全部键值直接嵌入主程序集供 LocService 后缀匹配。 -->
      <WithCulture>false</WithCulture>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ShimmerChat</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ShimmerChatBuiltin</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharperLLM\SharperLLM.csproj" />
  </ItemGroup>



</Project>
